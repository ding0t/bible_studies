---
import BaseLayout from '../layouts/BaseLayout.astro';
import MillennialWeek from '../components/MillennialWeek.jsx';
import events from '../../../docs/data/events.json';

const title = 'The Millennial Week';
const description =
  "A day is as a thousand years (2 Peter 3:8): from creation to the millennial reign, laid out across seven thousand-year 'days' -- with the genealogy, archaeology, and prophecy that fill them shown as comparable paths, not a single settled timeline.";
---

<BaseLayout title={title}>
  <main>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>
      The horizontal axis is <strong>Anno Mundi</strong> -- years since creation. Genesis 5 and
      11's genealogies survive in three manuscript traditions (Masoretic Text, Septuagint,
      Samaritan Pentateuch) that disagree on how many of those years separate creation from the
      Flood and from Abraham's father Terah; this site's own working synthesis is the "Proposed
      synthesis" path. Archaeology (Qarqar, Sennacherib, Cyrus, and others) fixes real Gregorian
      years independent of any of that. And the millennial-week framework itself implies a third,
      slightly later creation epoch again. Toggle paths and epochs below to see them diverge and
      converge on the same axis, rather than picking one number and hiding the disagreement.
    </p>

    <div class="timeline-container">
      <MillennialWeek client:load events={events} />
    </div>

    <section class="info-card">
      <h2>Biblical Genealogy</h2>
      <p>
        Explore the full genealogy from Adam to Jesus in detail -- family trees, lifespans across
        Gregorian and Zadok calendars, Hebrew name studies, and the same MT/LXX/SP/synthesis
        chronology paths shown above, per person.
      </p>
      <a href={`${import.meta.env.BASE_URL}/genealogy/`} class="cta">View Genealogy Viewer →</a>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  p {
    color: var(--color-text-subtle, #475569);
    line-height: 1.75;
  }

  .timeline-container {
    margin: 2rem 0;
  }

  .info-card {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--color-bg-elevated, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-left: 4px solid var(--color-primary, #3b82f6);
    border-radius: 0.75rem;
  }

  .info-card h2 {
    margin-bottom: 1rem;
    color: var(--color-text, #1e293b);
  }

  .cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .timeline-container {
      overflow-x: auto;
    }
  }
</style>
