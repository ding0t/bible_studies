{
  "name": "the-way",
  "compatibility_date": "2026-09-05",
  // The Worker runs only for /mcp, the public connector (app/src/entries/worker.js, bundled by
  // `npm run build:tools`); every other request is served from the static assets directly,
  // without invoking it.
  "main": "app/dist/worker.js",
  // Workers Logs: the connector's one line per tool call (server.js). Static assets never invoke
  // the Worker, so this records /mcp traffic only. Traces need their own flag; at this traffic
  // every request is cheap to keep, and a trace shows which ASSETS fetches a slow call waited on.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
