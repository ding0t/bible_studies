4],["בַטּוֹב","H2896","HRd/Aamsa","the good","ḇaṭ·ṭō·wḇ",155,163],["אֲשֶׁר־","H834","HTr","that","’ă·šer-",164,168],["אֲנִי","H589","HPp1cs","I","’ă·nî",169,170],["עֹשֶֽׂה־","H6213","HVqrmsa","will bring","‘ō·śeh-",171,181],["לְעַמִּי","H5971","HR/Ncmsc/Sp1cs","to My people","lə·‘am·mî",182,194],["נְאֻם־","H5002","HNcmsc","declares","nə·’um-",196,204],["יְהוָה","H3068","HNp","the LORD","Yah·weh",205,213],["כִּֽי־","H3588","HC","for","kî-",215,218],["סָרָה","H5627","HNcfsa","rebellion","sā·rāh",235,244],["דִבֶּר","H1696","HVpp3ms","he has preached","ḏib·ber",219,234],["עַל־","H5921","HR","against","‘al-",245,252],["יְהוָֽה׃ס","H3068","HNp","the LORD","Yah·weh",253,261]]},"g":{"1":{"p":[["36:1","Καὶ οὗτοι οἱ λόγοι τῆς βίβλου οὓς ἀπέστειλεν Ἱερεμίας ἐξ Ἱερουσαλὴμ πρὸς τοὺς πρεσβυτέρους τῆς ἀποικίας, καὶ πρὸς τοὺς ἱερεῖς, καὶ πρὸς τοὺς ψευδοπροφήτας, ἐπιστολὴν εἰς Βαβυλῶνα τῇ ἀποικίᾳ, καὶ πρὸς ἅπαντα τὸν λαὸν,"]]},"2":{"p":[["36:2","ὕστερον ἐξελθόντος Ἰεχονίου τοῦ βασιλέως, καὶ τῆς βασιλίσσης, καὶ τῶν εὐνούχων, καὶ παντὸς ἐλευθέρου, καὶ δεσμώτου, καὶ τεχνίτου ἐξ Ἱερουσαλὴμ,"]]},"3":{"p":[["36:3","ἐν χειρὶ Ἐλεασὰν υἱοῦ Σαφὰν, καὶ Γαμαρίου υἱοῦ Χελκίου, ὃν ἀπέστειλε Σεδεκίας βασιλεὺς Ἰούδα, πρὸς βασιλέα Βαβυλῶνος εἰς Βαβυλῶνα, λέγων,"]]},"4":{"p":[["36:4","Οὕτως εἶπε Κύριος ὁ Θεὸς Ἰσραὴλ ἐπὶ τὴν ἀποικίαν ἣν ἀπῴκισα ἀπὸ Ἱερουσαλὴμ,"]]},"5":{"p":[["36:5","οἰκοδομήσατε οἴκους, καὶ κατοικήσατε, καὶ φυτεύσατε παραδείσους, καὶ φάγετε τοὺς καρποὺς αὐτῶν,"]]},"6":{"p":[["36:6","καὶ λάβετε γυναῖκας, καὶ τεκνοποιήσατε υἱοὺς καὶ θυγατέρας, καὶ λάβετε τοῖς υἱοῖς ὑμῶν γυναῖκας, καὶ τὰς θυγατέρας ὑμῶν δότε ἀνδράσι, καὶ πληθύνεσθε, καὶ μὴ σμικρυνθῆτε·"]]},"7":{"p":[["36:7","Καὶ ζητήσατε εἰς εἰρήνην τῆς γῆς, εἰς ἣν ἀπῴκισα ὑμᾶς ἐκεῖ· καὶ προσεύξεσθε περὶ αὐτῶν πρὸς Κύριον, ὅτι ἐν εἰρήνῃ αὐτῆς εἰρήνη ὑμῖν."]]},"8":{"p":[["36:8","Ὅτι οὕτως εἶπε Κύριος, μὴ ἀναπειθέτωσαν ὑμᾶς οἱ ψευδοπροφῆται οἱ ἐν ὑμῖν, καὶ μὴ ἀναπειθέτωσαν ὑμᾶς οἱ μάντεις ὑμῶν, καὶ μὴ ἀκούετε εἰς τὰ ἐνύπνια ὑμῶν, ἃ ὑμεῖς ἐνυπνιάζεσθε,"]]},"9":{"p":[["36:9","ὅτι ἄδικα αὐτοὶ προφητεύουσιν ὑμῖν ἐπὶ τῷ ὀνόματί μου, καὶ οὐκ ἀπέστειλα αὐτούς."]]},"10":{"p":[["36:10","Ὅτι οὕτως εἶπε Κύριος, ὅταν μέλλῃ πληροῦσθαι Βαβυλῶνι ἑβδομήκοντα ἔτη, ἐπισκέψομαι ὑμᾶς, καὶ ἐπιστήσω τοὺς λόγους μου ἐφʼ ὑμᾶς, τοῦ ἀποστρέψαι τὸν λαὸν ὑμῶν εἰς τὸν τόπον τοῦτον."]]},"11":{"p":[["36:11","Καὶ λογιοῦμαι ἐφʼ ὑμᾶς λογισμὸν εἰρήνης, καὶ οὐ κακὰ, τοῦ δοῦναι ὑμῖν ταῦτα."]]},"12":{"p":[["36:12","Καὶ προσεύξασθε πρὸς μὲ, καὶ εἰσακούσομαι ὑμῶν."]]},"13":{"p":[["36:13","Καὶ ἐκζητήσατέ με, καὶ εὑρήσετέ με· ὅτι ζητήσετέ με ἐν ὅλῃ καρδίᾳ ὑμῶν,"]]},"14":{"p":[["36:14","καὶ ἐπιφανοῦμαι ὑμῖν·"]]},"15":{"p":[["36:15","Ὅτι εἴπατε, κατέστησεν ἡμῖν Κύριος προφήτας ἐν Βαβυλῶνι·"]]},"21":{"p":[["36:21","Οὕτως εἶπε Κύριος ἐπὶ Ἀχιὰβ, καὶ ἐπὶ Σεδεκίαν, ἰδοὺ ἐγὼ δίδωμι αὐτοὺς εἰς χεῖρας βασιλέως Βαβυλῶνος, καὶ πατάξει αὐτοὺς κατʼ ὀφθαλμοὺς ὑμῶν."]]},"22":{"p":[["36:22","Καὶ λήψονται ἀπʼ αὐτῶν κατάραν ἐν πάσῃ τῇ ἀποικίᾳ Ἰούδα ἐν Βαβυλῶνι, λέγοντες, ποιήσαι σε Κύριος, ὡς Σεδεκίαν ἐποίησε, καὶ ὡς Ἀχιὰβ, οὓς ἀπετηγάνισε βασιλεὺς Βαβυλῶνος ἐν πυρὶ,"]]},"23":{"p":[["36:23","διʼ ἣν ἐποίησαν ἀνομίαν ἐν Ἰσραὴλ, καὶ ἐμοιχῶντο τὰς γυναῖκας τῶν πολιτῶν αὐτῶν, καὶ λόγον ἐχρημάτισαν ἐν τῷ ὀνόματί μου, ὃν οὐ συνέταξα αὐτοῖς· καὶ ἐγὼ μάρτυς, φησὶ Κύριος."]]},"24":{"p":[["36:24","Καὶ πρὸς Σαμαίαν τὸν Αἰλαμίτην ἐρεῖς,"]]},"25":{"p":[["36:25","οὐκ ἀπέστειλά σε τῷ ὀνόματί μου· καὶ πρὸς Σοφονίαν υἱὸν Μαασαίου τὸν ἱερέα εἰπὲ,"]]},"26":{"p":[["36:26","Κύριος ἔδωκέ σε ἱερέα ἀντὶ Ἰωδαὲ τοῦ ἱερέως, γενέσθαι ἐπιστάτην ἐν τῷ οἴκῳ Κυρίου παντὶ ἀνθρώπῳ προφητεύοντι, καὶ παντὶ ἀνθρώπῳ μαινομένῳ, καὶ δώσεις αὐτὸν εἰς τὸ ἀπόκλεισμα, καὶ εἰς τὸν καταράκτην."]]},"27":{"p":[["36:27","Καὶ νῦν διατί συνελοιδορήσατε Ἱερεμίαν τὸν ἐξ Ἀναθὼθ, τὸν προφητεύσαντα ὑμῖν;"]]},"28":{"p":[["36:28","Οὐ διατοῦτο ἀπέστειλεν; ὅτι διὰ τοῦ μηνὸς τούτου ἀπέστειλε πρὸς ὑμᾶς εἰς Βαβυλῶνα, λέγων, μακράν ἐστιν, οἰκοδομήσατε οἰκίας, καὶ κατοικήσατε, καὶ φυτεύσατε κήπους, καὶ φάγεσθε τὸν καρπὸν αὐτῶν."]]},"29":{"p":[["36:29","Καὶ ἀνέγνω Σοφονίας τὸ βιβλίον εἰς τὰ ὦτα Ἱερεμίου."]]},"30":{"p":[["36:30","Καὶ ἐγένετο λόγος Κυρίου πρὸς Ἱερεμίαν, λέγων,"]]},"31":{"p":[["36:31","ἀπόστειλον πρὸς τὴν ἀποικίαν, λέγων, οὕτως εἶπε Κύριος ἐπὶ Σαμαίαν τὸν Αἰλαμίτην, ἐπειδὴ ἐπροφήτευσεν ὑμῖν Σαμαίας, καὶ ἐγὼ οὐκ ἀπέστειλα αὐτὸν, καὶ πεποιθέναι ἐποίησεν ὑμᾶς ἐπʼ ἀδίκοις,"]]},"32":{"p":[["36:32","διατοῦτο οὕτως εἶπε Κύριος, ἰδοὺ ἐγὼ ἐπισκέψομαι ἐπὶ Σαμαίαν, καὶ ἐπὶ τὸ γένος αὐτοῦ, καὶ οὐκ ἔσται αὐτῶν ἄνθρωπος ἐν μέσῳ ὑμῶν, τοῦ ἰδεῖν τὰ ἀγαθὰ, ἃ ἐγὼ ποιήσω ὑμῖν, οὐκ ὄψονται."]]}}}