],["בֵּית","H1004","HNcmsc","in the house","bêṯ",92,104],["יְהוָה","H3068","HNp","of the LORD","Yah·weh",105,116],["וּבֵית","H1004","HC/Ncmsc","in the palace","ū·ḇêṯ",118,131],["מֶֽלֶךְ־","H4428","HNcmsc","of the king","me·leḵ-",132,143],["יְהוּדָה","H3063","HNp","of Judah","yə·hū·ḏāh",144,152],["וִירוּשָׁלִָֽם׃","H3389","HC/Np","and in Jerusalem","wî·rū·šā·lim",154,170]],"22":[["בָּבֶלָה","H894","HNp/Sd","to Babylon","bā·ḇe·lāh",22,32],["יוּבָאוּ","H935","HVHi3mp","They will be carried","yū·ḇā·’ū",1,21],["וְשָׁמָּה","H8033","HC/D/Sd","there","wə·šām·māh",49,54],["יִֽהְיוּ","H1961","HVqi3mp","and will remain","yih·yū",33,48],["עַד","H5704","HR","until","‘aḏ",55,60],["יוֹם","H3117","HNcmsc","the day","yō·wm",61,68],["פָּקְדִי","H6485","HVqc/Sp1cs","I attend to them again","pā·qə·ḏî",69,91],["אֹתָם","H853","HTo/Sp3mp",0,"’ō·ṯām"],["נְאֻם־","H5002","HNcmsc","declares","nə·’um-",94,102],["יְהוָה","H3068","HNp","the LORD","Yah·weh",103,111],["וְהַֽעֲלִיתִים","H5927","HC/Vhq1cs/Sp3mp","Then I will bring them back","wə·ha·‘ă·lî·ṯîm",114,141],["וַהֲשִׁיבֹתִים","H7725","HC/Vhq1cs/Sp3mp","and restore them","wa·hă·šî·ḇō·ṯîm",142,158],["אֶל־","H413","HR","to","’el-",159,161],["הַמָּקוֹם","H4725","HTd/Ncmsa","place","ham·mā·qō·wm",167,172],["הַזֶּֽה׃פ","H2088","HTd/Pdxms","this","haz·zeh",162,166]]},"g":{"2":{"p":[["34:2","Οὕτως εἶπε Κύριος, ποίησον σεαυτῷ δεσμοὺς καὶ κλοιοὺς, καὶ περίθου περὶ τὸν τράχηλόν σου."]]},"3":{"p":[["34:3","Καὶ ἀποστελεῖς αὐτοὺς πρὸς βασιλέα Ἰδουμαίας, καὶ πρὸς βασιλέα Μωὰβ, καὶ πρὸς βασιλέα υἱῶν Ἀμμὼν, καὶ πρὸς τὸν βασιλέα Τύρου, καὶ πρὸς βασιλέα Σιδῶνος, ἐν χερσὶν ἀγγέλων αὐτῶν τῶν ἐρχομένων εἰς ἀπάντησιν αὐτῶν εἰς Ἱερουσαλὴμ πρὸς Σεδεκίαν βασιλέα Ἰούδα."]]},"4":{"p":[["34:4","Καὶ συντάξεις αὐτοῖς πρὸς τοὺς κυρίους αὐτῶν εἰπεῖν, οὕτως εἶπε Κύριος ὁ Θεὸς Ἰσραὴλ, οὕτως ἐρεῖτε πρὸς τοὺς κυρίους ὑμῶν,"]]},"5":{"p":[["34:5","ὅτι ἐγὼ ἐποίησα τὴν γῆν ἐν τῇ ἰσχύϊ μου τῇ μεγάλῃ, καὶ ἐν τῷ ἐπιχείρῳ μου τῷ ὑψηλῷ, καὶ δώσω αὐτὴν ᾧ ἐὰν δόξῃ ἐν ὀφθαλμοῖς μου·"]]},"6":{"p":[["34:6","Ἔδωκα τὴν γῆν τῷ Ναβουχοδονόσορ βασιλεῖ Βαβυλῶνος δουλεύειν αὐτῷ, καὶ τὰ θηρία τοῦ ἀγροῦ ἐργάζεσθαι αὐτῷ."]]},"8":{"p":[["34:8","Καὶ τὸ ἔθνος καὶ ἡ βασιλεία, ὅσοι ἐὰν μὴ ἐμβάλωσι τὸν τράχηλον αὐτῶν ὑπὸ τὸν ζυγὸν βασιλέως Βαβυλῶνος, ἐν μαχαίρᾳ καὶ ἐν λιμῷ ἐπισκέψομαι αὐτοὺς, εἶπε Κύριος, ἕως ἐκλίπωσιν ἐν χειρὶ αὐτοῦ."]]},"9":{"p":[["34:9","Καὶ ὑμεῖς μὴ ἀκούετε τῶν ψευδοπροφητῶν ὑμῶν, καὶ τῶν μαντευομένων ὑμῖν, καὶ τῶν ἐνυπνιαζομένων ὑμῖν, καὶ τῶν οἰωνισμάτων ὑμῶν, καὶ τῶν φαρμακῶν ὑμῶν, τῶν λεγόντων, οὐ μὴ ἐργάσησθε τῷ βασιλεῖ Βαβυλῶνος·"]]},"10":{"p":[["34:10","Ὅτι ψευδῆ αὐτοὶ προφητεύουσιν ὑμῖν, πρὸς τὸ μακρῦναι ὑμᾶς ἀπὸ τῆς γῆς ὑμῶν."]]},"11":{"p":[["34:11","Καὶ τὸ ἔθνος ὃ ἐὰν εἰσαγάγῃ τὸν τράχηλον αὐτοῦ ὑπὸ τὸν ζυγὸν βασιλέως Βαβυλῶνος, καὶ ἐργάσηται αὐτῷ, καὶ καταλείψω αὐτὸν ἐπὶ τῆς γῆς αὐτοῦ, καὶ ἐργᾶται αὐτῷ, καὶ ἐνοικήσει ἐν αὐτῇ."]]},"12":{"p":[["34:12","Καὶ πρὸς Σεδεκίαν βασιλέα Ἰούδα ἐλάλησα κατὰ πάντας τοὺς λόγους τούτους, λέγων, εἰσαγάγετε τὸν τράχηλον ὑμῶν,"]]},"14":{"p":[["34:14","καὶ ἐργάσασθε τῷ βασιλεῖ Βαβυλῶνος, ὅτι ἄδικα αὐτοὶ προφητεύουσιν ὑμῖν,"]]},"15":{"p":[["34:15","ὅτι οὐκ ἀπέστειλα αὐτοὺς, φησὶ Κύριος, καὶ προφητεύουσι τῷ ὀνόματί μου ἐπ ἀδίκῳ, πρὸς τὸ ἀπολέσαι ὑμᾶς, καὶ ἀπολεῖσθε ὑμεῖς, καὶ οἱ προφῆται ὑμῶν, οἱ προφητεύοντες ὑμῖν ἐπʼ ἀδίκῳ ψευδῆ."]]},"16":{"p":[["34:16","Ὑμῖν, καὶ παντὶ τῷ λαῷ τούτῳ, καὶ τοῖς ἱερεῦσιν ἐλάλησα, λέγων, οὕτως εἶπε Κύριος, μὴ ἀκούετε τῶν λόγων τῶν προφητῶν, τῶν προφητευόντων ὑμῖν, λεγόντων, ἰδοὺ σκεύη οἴκου Κυρίου ἐπιστρέψει ἐκ Βαβυλῶνος· ὅτι ἄδικα αὐτοὶ προφητεύουσιν ὑμῖν. Οὐκ ἀπέστειλα αὐτούς."]]},"18":{"p":[["34:18","Εἰ προφῆταί εἰσι, καὶ εἰ ἔστι λόγος Κυρίου ἐν αὐτοῖς, ἀπαντησάτωσάν μοι, ὅτι οὕτως εἶπε Κύριος."]]},"19":{"p":[["34:19","Καὶ τῶν ἐπιλοίπων σκευῶν,"]]},"20":{"p":[["34:20","ὧν οὐκ ἔλαβε βασιλεὺς Βαβυλῶνος, ὅτε ἀπῴκισε τὸν Ἰεχονίαν ἐξ Ἱερουσαλὴμ,"]]},"22":{"p":[["34:22","εἰς Βαβυλῶνα εἰσελεύσεται, λέγει Κύριος."]]}}}