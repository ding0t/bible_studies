,"yə·hū·ḏāh",7,12],["וְעַל־","H5921",0,0,"wə·‘al-"],["אֱדוֹם","H123","HNp","Edom","’ĕ·ḏō·wm",14,18],["וְעַל־","H5921",0,0,"wə·‘al-"],["בְּנֵי","H1121","HNcmpc",0,"bə·nê"],["עַמּוֹן","H5983","HNp","Ammon","‘am·mō·wn",20,25],["וְעַל־","H5921",0,0,"wə·‘al-"],["מוֹאָב","H4124","HNp","Moab","mō·w·’āḇ",27,31],["וְעַל","H5921",0,0,"wə·‘al"],["כָּל־","H3605","HNcmsc","and all","kāl-",33,40],["קְצוּצֵי","H7112","HVqsmpc","who clip the hair","qə·ṣū·ṣê",71,88],["פֵאָה","H6285","HNcfsa","of their temples","p̄ê·’āh",89,105],["הַיֹּשְׁבִים","H3427","HTd/Vqrmpa","the inhabitants","hay·yō·šə·ḇîm",41,56],["בַּמִּדְבָּר","H4057","HRd/Ncmsa","of the desert","bam·miḏ·bār",57,70],["כִּי","H3588","HC",0,"kî"],["כָל־","H3605","HNcmsc","For all","ḵāl",107,114],["הַגּוֹיִם","H1471","HTd/Ncmpa","these nations","hag·gō·w·yim",115,128],["עֲרֵלִים","H6189","HAampa","[are] uncircumcised","‘ă·rê·lîm",129,146],["וְכָל־","H3605","HC/Ncmsc","and the whole","wə·ḵāl",148,161],["בֵּית","H1004","HNcmsc","house","bêṯ",162,167],["יִשְׂרָאֵל","H3478","HNp","of Israel","yiś·rā·’êl",168,177],["עַרְלֵי־","H6189","HAampc","is uncircumcised","‘ar·lê-",178,194],["לֵֽב׃ס","H3820","HNcmsa","in heart","lêḇ",195,203]]]]}},"g":{"1":{"p":[["8:23","Τίς δώσει κεφαλῇ μου ὕδωρ, καὶ ὀφθαλμοῖς μου πηγὴν δακρύων; καὶ κλαύσομαι τὸν λαόν μου τοῦτον ἡμέρας καὶ νυκτὸς, τοὺς τετραυματισμένους θυγατρὸς λαοῦ μου."]]},"2":{"p":[["9:1","Τίς δῴη μοι ἐν τῇ ἐρήμῳ σταθμὸν ἔσχατον, καὶ καταλείψω τὸν λαόν μου, καὶ ἀπελεύσομαι ἀπʼ αὐτῶν; ὅτι πάντες μοιχῶνται, σύνοδος ἀθετούντων,"]]},"3":{"p":[["9:2","καὶ ἐνέτειναν τὴν γλῶσσαν αὐτῶν ὡς τόξον· ψεῦδος, καὶ οὐ πίστις ἐνίσχυσεν ἐπὶ τῆς γῆς, ὅτι ἐκ κακῶν εἰς κακὰ ἐξήλθοσαν, καὶ ἐμὲ οὐκ ἔγνωσαν, φησὶ Κύριος."]]},"4":{"p":[["9:3","Ἕκαστος ἀπὸ τοῦ πλησίον αὐτοῦ φυλάξασθε, καὶ ἐπʼ ἀδελφοῖς αὐτῶν μὴ πεποίθατε, ὅτι πᾶς ἀδελφὸς πτέρνῃ πτερνιεῖ, καὶ πᾶς φίλος δολίως πορεύσεται."]]},"5":{"p":[["9:4","Ἕκαστος κατὰ τοῦ φίλου αὐτοῦ καταπαίξεται, ἀλήθειαν οὐ μὴ λαλήσωσι· μεμάθηκεν ἡ γλῶσσα αὐτῶν λαλεῖν ψευδῆ, ἠδίκησαν, καὶ οὐ διέλιπον τοῦ ἐπιστρέψαι."]]},"6":{"p":[["9:5","Τόκος ἐπὶ τόκῳ, καὶ δόλος ἐπὶ δόλῳ· οὐκ ἤθελον εἰδέναι με, φησὶ Κύριος."]]},"7":{"p":[["9:6","Διατοῦτο τάδε λέγει Κύριος, ἰδοὺ ἐγὼ πυρώσω αὐτοὺς, καὶ δοκιμῶ αὐτούς· ὅτι ποιήσω ἀπὸ προσώπου πονηρίας θυγατρὸς λαοῦ μου."]]},"8":{"p":[["9:7","Βολὶς τιτρώσκουσα ἡ γλῶσσα αὐτῶν, δόλια τὰ ῥήματα τοῦ στόματος αὐτῶν· τῷ πλησίον αὐτοῦ λαλεῖ εἰρηνικὰ, καὶ ἐν ἑαυτῷ ἔχει τὴν ἔχθραν."]]},"9":{"p":[["9:8","Μὴ ἐπὶ τούτοις οὐκ ἐπισκέψομαι; λέγει Κύριος· ἢ ἐν λαῷ τοιούτῳ οὐκ ἐκδικήσει ἡ ψυχή μου;"]]},"10":{"p":[["9:9","Ἐπὶ τὰ ὄρη λάβετε κοπετὸν, καὶ ἐπὶ τὰς τρίβους τῆς ἐρήμου θρῆνον, ὅτι ἐξέλιπον παρὰ τὸ μὴ εἶναι ἀνθρώπους· οὐκ ἤκουσαν φωνὴν ὑπάρξεως ἀπὸ πετεινῶν τοῦ οὐρανοῦ, καὶ ἕως κτηνῶν, ἐξέστησαν, ᾤχοντο."]]},"11":{"p":[["9:10","Καὶ δώσω τὴν Ἱερουσαλὴμ εἰς μετοικίαν, καὶ εἰς κατοικητήριον δρακόντων, καὶ τὰς πόλεις Ἰούδα εἰς ἀφανισμὸν θήσομαι, παρὰ τὸ μὴ κατοικεῖσθαι."]]},"12":{"p":[["9:11","Τίς ὁ ἄνθρωπος ὁ συνετὸς, καὶ συνέτω τοῦτο; καὶ ᾧ λόγος στόματος Κυρίου πρὸς αὐτὸν, ἀναγγειλάτω ὑμῖν, ἕνεκεν τίνος ἀπώλετο ἡ γῆ, ἀνήφθη, ὡς ἔρημος, παρὰ τὸ μὴ διοδεύεσθαι αὐτήν;"]]},"13":{"p":[["9:12","Καὶ εἶπε Κύριος πρὸς μὲ, διὰ τὸ ἐγκαταλιπεῖν αὐτοὺς τὸν νόμον μου, ὃν ἔδωκα πρὸ προσώπου αὐτῶν, καὶ οὐκ ἤκουσαν τῆς φωνῆς μου,"]]},"14":{"p":[["9:13","ἀλλʼ ἐπορεύθησαν ὀπίσω τῶν ἀρεστῶν τῆς καρδίας αὐτῶν τῆς κακῆς, καὶ ὀπίσω τῶν εἰδώλων ἃ ἐδίδαξαν αὐτοὺς οἱ πατέρες αὐτῶν."]]},"15":{"p":[["9:14","Διατοῦτο τάδε λέγει Κύριος ὁ Θεὸς Ἰσραὴλ, ἰδοὺ ἐγὼ ψωμιῶ αὐτοὺς ἀνάγκας, καὶ ποτιῶ αὐτοὺς ὕδωρ χολῆς,"]]},"16":{"p":[["9:15","καὶ διασκορπιῶ αὐτοὺς ἐν τοῖς ἔθνεσιν, εἰς οὓς οὐκ ἐγίνωσκον αὐτοὶ καὶ οἱ πατέρες αὐτῶν, καὶ ἐπαποστελῶ ἐπʼ αὐτοὺς τὴν μάχαιραν, ἕως τοῦ ἐξαναλῶσαι αὐτοὺς ἐν αὐτῇ."]]},"17":{"p":[["9:16","Τάδε λέγει Κύριος, καλέσατε τὰς θρηνούσας, καὶ ἐλθέτωσαν, καὶ πρὸς τὰς σοφὰς ἀποστείλατε, καὶ φθεγξάσθωσαν,"]]},"18":{"p":[["9:17","καὶ λαβέτωσαν ἐφʼ ὑμᾶς θρῆνον, καὶ καταγαγέτωσαν οἱ ὀφθαλμοὶ ὑμῶν δάκρυα, καὶ τὰ βλέφαρα ὑμῶν ῥείτω ὕδωρ,"]]},"19":{"p":[["9:18","ὅτι φωνὴ οἰκτροῦ ἠκούσθη ἐν Σιών· πῶς ἐταλαιπωρήσαμεν, κατῃσχύνθημεν σφόδρα, ὅτι ἐγκατελίπομεν τὴν γῆν, καὶ ἀπεῤῥίψαμεν τὰ σκηνώματα ἡμῶν;"]]},"20":{"p":[["9:19","Ἀκούσατε δὴ γυναῖκες λόγον Θεοῦ, καὶ δεξάσθω τὰ ὦτα ὑμῶν λόγους στόματος αὐτοῦ, καὶ διδάξατε τὰς θυγατέρας ὑμῶν οἶκτον, καὶ γυνὴ τὴν πλησίον αὐτῆς θρῆνον."]]},"21":{"p":[["9:20","Ὅτι ἀνέβη θάνατος διὰ τῶν θυρίδων ὑμῶν, εἰσῆλθεν εἰς τὴν γῆν ὑμῶν, τοῦ ἐκτρίψαι νήπια ἔξωθεν, καὶ νεανίσκους ἀπὸ τῶν πλατειῶν."]]},"22":{"p":[["9:21","Καὶ ἔσονται οἱ νεκροὶ τῶν ἀνθρώπων εἰς παράδειγμα ἐπὶ προσώπου τοῦ πεδίου τῆς γῆς ὑμῶν, ὡς χόρτος ὀπίσω θερίζοντος, καὶ οὐκ ἔσται ὁ συνάγων."]]},"23":{"p":[["9:22","Τάδε λέγει Κύριος, μὴ καυχάσθω ὁ σοφὸς ἐν τῇ σοφίᾳ αὐτοῦ, καὶ μὴ καυχάσθω ὁ ἰσχυρὸς ἐν τῆ ἰσχύϊ αὐτοῦ, καὶ μὴ καυχάσθω ὁ πλούσιος ἐν τῷ πλούτῳ αὐτοῦ,"]]},"24":{"p":[["9:23","ἀλλʼ ἢ ἐν τούτῳ καυχάσθω ὁ καυχώμενος, συνιεῖν καὶ γινώσκειν, ὅτι ἐγώ εἰμι Κύριος ὁ ποιῶν ἔλεος καὶ κρίμα καὶ δικαιοσύνην ἐπὶ τῆς γῆς, ὅτι ἐν τούτοις τὸ θέλημά μου, λέγει Κύριος."]]},"25":{"p":[["9:24","Ἰδοὺ ἡμέραι ἔρχονται, λέγει Κύριος, καὶ ἐπισκέψομαι ἐπὶ πάντας περιτετμημένους ἀκροβυστίας αὐτῶν."]]},"26":{"p":[["9:25","Ἐπʼ Αἴγυπτον, καὶ ἐπὶ Ἰδουμαίαν, καὶ ἐπὶ Ἐδὼμ, καὶ ἐπὶ υἱοὺς Ἀμμὼν, καὶ ἐπὶ υἱοὺς Μωὰβ, καὶ ἐπὶ πάντα περικειρόμενον τὰ κατὰ πρόσωπον αὐτοῦ, τοὺς κατοικοῦντας ἐν τῇ ἐρήμῳ, ὅτι πάντα τὰ ἔθνη ἀπερίτμητα σαρκὶ, καὶ πᾶς οἶκος Ἰσραὴλ ἀπερίτμητοι καρδίας αὐτῶν."]]}}}