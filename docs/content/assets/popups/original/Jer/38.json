a·ḥă·ri·šū",130,150],["מִמֶּנּוּ","H4480","HR/Sp1cp","to him","mim·men·nū",151,157],["כִּי","H3588","HC","for","kî",159,162],["לֹֽא־","H3808","HTn","no one","lō-",163,169],["נִשְׁמַע","H8085","HVNp3ms","had overheard","niš·ma‘",170,183],["הַדָּבָֽר׃פ","H1697","HTd/Ncmsa","the conversation","had·dā·ḇār",184,200]],"28":[["וַיֵּשֶׁב","H3427","HC/Vqw3ms","remained","way·yê·šeḇ",13,21],["יִרְמְיָהוּ","H3414","HNp","And Jeremiah","yir·mə·yā·hū",0,12],["בַּחֲצַר","H2691","HR/Ncbsc","in the courtyard","ba·ḥă·ṣar",22,38],["הַמַּטָּרָה","H4307","HTd/Ncfsa","of the guard","ham·maṭ·ṭā·rāh",39,51],["עַד־","H5704","HR","until","‘aḏ-",52,57],["יוֹם","H3117","HNcmsa","the day","yō·wm",58,65],["אֲשֶׁר־","H834","HTr",0,"’ă·šer-"],["נִלְכְּדָה","H3920","HVNp3fs","was captured","nil·kə·ḏāh",76,88],["יְרוּשָׁלִָםס","H3389","HNp","Jerusalem","yə·rū·šå̄·lå̄·ms",66,75],["וְהָיָה","H1961","HC/Vqq3ms",0,"wə·hā·yāh"],["כַּאֲשֶׁר","H834","HR/Tr",0,"ka·’ă·šer"],["נִלְכְּדָה","H3920","HVNp3fs",0,"nil·kə·ḏāh"],["יְרוּשָׁלִָֽם׃פ","H3389","HNp",0,"yə·rū·šā·lim"]]},"g":{"1":{"p":[["45:1","Καὶ ἤκουσε Σαφανίας υἱὸς Νάθαν, καὶ Γοδολίας υἱὸς Πασχὼρ, καὶ Ἰωάχαλ υἱὸς Σεμελίου, τοὺς λόγους οὓς Ἱερεμίας ἐλάλει ἐπὶ τὸν λαὸν, λέγων,"]]},"2":{"p":[["45:2","Οὕτως εἶπε Κύριος, ὁ κατοικῶν ἐν τῇ πόλει ταύτῃ, ἀποθανεῖται ἐν ῥομφαίᾳ, καὶ ἐν λιμῷ· καὶ ὁ ἐκπορευόμενος πρὸς τοὺς Χαλδαίους, ζήσεται, καὶ ἔσται ἡ ψυχὴ αὐτοῦ εἰς εὕρημα, καὶ ζήσεται."]]},"3":{"p":[["45:3","Ὅτι οὕτως εἶπε Κύριος, παραδιδομένη παραδοθήσεται ἡ πόλις αὕτη εἰς χεῖρας δυνάμεως βασιλέως Βαβυλῶνος, καὶ συλλήψεται αὐτήν."]]},"4":{"p":[["45:4","Καὶ εἶπον τῷ βασιλεῖ, ἀναιρεθήτω δὴ ὁ ἄνθρωπος ἐκεῖνος, ὅτι αὐτὸς ἐκλύει τὰς χεῖρας τῶν ἀνθρώπων τῶν πολεμούντων τῶν καταλειπομένων ἐν τῇ πόλει, καὶ τὰς χεῖρας παντὸς τοῦ λαοῦ, λαλῶν πρὸς αὐτοὺς κατὰ τοὺς λόγους τούτους· ὅτι ὁ ἄνθρωπος οὗτος οὐ χρησμολογεῖ εἰρήνην τῷ λαῷ τούτῳ ἀλλʼ ἢ πονηρά."]]},"5":{"p":[["45:5","Καὶ εἶπεν ὁ βασιλεὺς, ἰδοὺ αὐτὸς ἐν χερσὶν ὑμῶν· ὅτι οὐκ ἠδύνατο ὁ βασιλεὺς πρὸς αὐτούς."]]},"6":{"p":[["45:6","Καὶ ἔῤῥιψαν αὐτὸν εἰς λάκκον Μελχίου υἱοῦ τοῦ βασιλέως, ὃς ἦν ἐν τῇ αὐλῇ τῆς φυλακῆς, καὶ ἐχάλασαν αὐτὸν εἰς τὸν λάκκον, καὶ ἐν τῷ λάκκῳ οὐκ ἦν ὕδωρ, ἀλλʼ ἢ βόρβορος, καὶ ἦν ἐν τῷ βορβόρῳ."]]},"7":{"p":[["45:7","Καὶ ἤκουσεν Ἀβδεμέλεχ ὁ Αἰθίοψ, καὶ αὐτὸς ἐν οἰκίᾳ τοῦ βασιλέως, ὅτι ἔδωκαν Ἱερεμίαν εἰς τὸν λάκκον· καὶ ὁ βασιλεὺς ἦν ἐν τῇ πύλῃ Βενιαμὶν,"]]},"8":{"p":[["45:8","καὶ ἐξῆλθε πρὸς αὐτὸν, καὶ ἐλάλησε πρὸς τὸν βασιλέα, καὶ εἶπεν,"]]},"9":{"p":[["45:9","ἐπονηρεύσω, ἃ ἐποίησας τοῦ ἀποκτεῖναι τὸν ἄνθρωπον τοῦτον, ἀπὸ προσώπου τοῦ λιμοῦ, ὅτι οὐκ εἰσὶν ἔτι ἄρτοι ἐν τῇ πόλει."]]},"10":{"p":[["45:10","Καὶ ἐνετείλατο ὁ βασιλεὺς τῷ Ἀβδεμέλεχ, λέγων, λάβε εἰς τὰς χεῖράς σου ἐντεῦθεν τριάκοντα ἀνθρώπους, καὶ ἀνάγαγε αὐτὸν ἐκ τοῦ λάκκου, ἵνα μὴ ἀποθάνῃ."]]},"11":{"p":[["45:11","Καὶ ἔλαβεν Ἀβδεμέλεχ τοὺς ἀνθρώπους, καὶ εἰσῆλθεν εἰς τὴν οἰκίαν τοῦ βασιλέως τὴν ὑπόγαιον, καὶ ἔλαβεν ἐκεῖθεν παλαιὰ ῥάκη καὶ παλαιὰ σχοινία, καὶ ἔῤῥιψεν αὐτὰ πρὸς Ἱερεμίαν εἰς τὸν λάκκον,"]]},"12":{"p":[["45:12","καὶ εἶπε, ταῦτα θὲς ὑποκάτω τῶν σχοινίων· καὶ ἐποίησεν Ἱερεμίας οὕτως."]]},"13":{"p":[["45:13","Καὶ εἵλκυσαν αὐτὸν τοῖς σχοινίοις, καὶ ἀνήγαγον αὐτὸν ἐκ τοῦ λάκκου· καὶ ἐκάθισεν Ἱερεμίας ἐν τῇ αὐλῇ τῆς φυλακῆς."]]},"14":{"p":[["45:14","Καὶ ἀπέστειλεν ὁ βασιλεὺς, καὶ ἐκάλεσεν αὐτὸν προς ἑαυτὸν εἰς οἰκίαν Ἀσελεισὴλ, τὴν ἐν οἴκῳ Κυρίου· καὶ εἶπεν αὐτῷ ὁ βασιλεὺς, ἐρωτήσω σε λόγον, καὶ μὴ δὴ κρύψῃς ἀπʼ ἐμοῦ ῥῆμα."]]},"15":{"p":[["45:15","Καὶ εἶπεν Ἱερεμίας τῷ βασιλεῖ, ἐὰν ἀναγγείλω σοι, οὐχὶ θανάτῳ με θανατώσεις; καὶ ἐὰν συμβουλεύσω σοι, οὐ μὴ ἀκούσῃς μου."]]},"16":{"p":[["45:16","Καὶ ὤμοσεν αὐτῷ ὁ βασιλεὺς, λέγων, ζῇ Κύριος ὃς ἐποίησεν ἡμῖν τὴν ψυχὴν ταύτην, εἰ ἀποκτενῶ σε, καὶ εἰ δώσω σε εἰς χεῖρας τῶν ἀνθρώπων τούτων."]]},"17":{"p":[["45:17","Καὶ εἶπεν αὐτῷ Ἱερεμίας, οὕτως εἶπε Κύριος, ἐὰν ἐξελθὼν ἐξέλθῃς πρὸς ἡγεμόνας βασιλέως Βαβυλῶνος, ζήσεται ἡ ψυχή σου, καὶ ἡ πόλις αὕτη οὐ μὴ κατακαυθῇ ἐν πυρὶ, καὶ ζήσῃ σὺ καὶ ἡ οἰκία σου."]]},"18":{"p":[["45:18","Καὶ ἐὰν μὴ ἐξέλθῃς, δοθήσεται ἡ πόλις αὕτη εἰς χεῖρας τῶν Χαλδαίων, καὶ καύσουσιν αὐτὴν ἐν πυρὶ καὶ σὺ οὐ μὴ σωθῇς."]]},"19":{"p":[["45:19","Καὶ εἶπεν ὁ βασιλεὺς τῷ Ἱερεμίᾳ, ἐγὼ λόγον ἔχω τῶν Ἰουδαίων τῶν πεφευγότων πρὸς τοὺς Χαλδαίους, μὴ δώσειν με εἰς χεῖρας αὐτῶν, καὶ καταμωκήσονταί μου."]]},"20":{"p":[["45:20","Καὶ εἶπεν Ἱερεμίας, οὐ μὴ παραδῶσί σε· ἄκουσον τὸν λόγον Κυρίου, ὃν ἐγὼ λέγω πρὸς σὲ, καὶ βέλτιον ἔσται σοι, καὶ ζήσεται ἡ ψυχή σου."]]},"21":{"p":[["45:21","Καὶ εἰ μὴ θέλῃς σὺ ἐξελθεῖν, οὗτος ὁ λόγος ὃν ἔδειξέ μοι Κύριος·"]]},"22":{"p":[["45:22","Καὶ ἰδοὺ πᾶσαι αἱ γυναῖκες αἱ καταλειφθεῖσαι ἐν οἰκίᾳ βασιλέως Ἰούδα, ἐξήγοντο πρὸς ἄρχοντας βασιλέως Βαβυλῶνος· καὶ αὗται ἔλεγον, ἠπάτησάν σε, καὶ δυνήσονταί σοι ἄνδρες εἰρηνικοί σου· καὶ καταλύσουσιν ἐν ὀλισθήμασι πόδα σου, ἀπέστρεψαν ἀπὸ σοῦ,"]]},"23":{"p":[["45:23","καὶ τᾶς γυναῖκάς σου καὶ τὰ τέκνα σου ἐξάξουσι πρὸς τοὺς Χαλδαίους· καὶ σὺ οὐ μὴ σωθῇς, ὅτι ἐν χειρὶ βασιλέως Βαβυλῶνος συλληφθήσῃ, καὶ ἡ πόλις αὕτη κατακαυθήσεται."]]},"24":{"p":[["45:24","Καὶ εἶπεν αὐτῷ ὁ βασιλεὺς, ἄνθρωπος μὴ γνώτω ἐκ τῶν λόγων τούτων, καὶ σὺ οὐ μὴ ἀποθάνῃς."]]},"25":{"p":[["45:25","Καὶ ἐὰν οἱ ἄρχοντες ἀκούσωσιν ὅτι ἐλάλησά σοι, καὶ ἔλθωσι πρὸς σὲ, καὶ εἴπωσί σοι, ἀνάγγειλον ἡμῖν, τί ἐλάλησέ σοι ὁ βασιλεύς; μὴ κρύψῃς ἀφʼ ἡμῶν, καὶ οὐ μὴ ἀνέλωμέν σε· καὶ τί ἐλάλησε πρὸς σὲ ὁ βασιλεύς;"]]},"26":{"p":[["45:26","Καὶ ἐρεῖς αὐτοῖς, ῥίπτω ἐγὼ τὸ ἔλεός μου κατʼ ὀφθαλμοὺς τοῦ βασιλέως, πρὸς τὸ μὴ ἀποστρέψαι με εἰς οἰκίαν Ἰωνάθαν, ἀποθανεῖν με ἐκεῖ."]]},"27":{"p":[["45:27","Καὶ ἤλθοσαν πάντες οἱ ἄρχοντες πρὸς Ἰερεμίαν, καὶ ἠρώτησαν αὐτόν· καὶ ἀνήγγειλεν αὐτοῖς κατὰ πάντας τοὺς λόγους τούτους, οὓς ἐνετείλατο αὐτῷ ὁ βασιλεύς· καὶ ἀπεσιώπησαν, ὅτι οὐκ ἠκούσθη ὁ λόγος Κυρίου."]]},"28":{"p":[["45:28","Καὶ ἐκάθισεν Ἱερεμίας ἐν τῇ αὐλῇ τῆς φυλακῆς, ἕως χρόνου οὗ συνελήφθη Ἱερουσαλήμ."]]}}}