"HTj","Woe","’ō·w-",0,3],["לְךָ",0,0,"to you","lə·ḵā",4,10],["מוֹאָב","H4124","HNp","O Moab","mō·w·’āḇ",12,18],["אָבַד","H6","HVqp3ms","have perished","’ā·ḇaḏ",42,55],["עַם־","H5971","HNcmsc","The people","‘am-",20,30],["כְּמוֹשׁ","H3645","HNp","of Chemosh","kə·mō·wōš",31,41],["כִּֽי־","H3588","HC","for","kî-",57,60],["לֻקְּחוּ","H3947","HVPp3cp","have been taken","luq·qə·ḥū",71,86],["בָנֶיךָ","H1121","HNcmpc/Sp2ms","your sons","ḇā·ne·ḵā",61,70],["בַּשֶּׁבִי","H7628","HRd/Ncbsa","into exile","baš·še·ḇî",87,97],["וּבְנֹתֶיךָ","H1323","HC/Ncfpc/Sp2ms","and your daughters","ū·ḇə·nō·ṯe·ḵā",98,116],["בַּשִּׁבְיָֽה׃","H7633","HRd/Ncbsa","have gone into captivity","baš·šiḇ·yāh",117,141]],"47":[["וְשַׁבְתִּי","H7725","HC/Vqq1cs","I will restore","wə·šaḇ·tî",23,37],["שְׁבוּת־","H7622","HNcfsc","from captivity","šə·ḇūṯ-",43,57],["מוֹאָב","H4124","HNp","Moab","mō·w·’āḇ",38,42],["בְּאַחֲרִית","H319","HR/Ncfsc","Yet in the latter","bə·’a·ḥă·rîṯ",0,17],["הַיָּמִים","H3117","HTd/Ncmpa","days","hay·yā·mîm",18,22],["נְאֻם־","H5002","HNcmsc","declares","nə·’um-",60,68],["יְהוָה","H3068","HNp","the LORD","Yah·weh",69,77],["עַד־","H5704","HR","ends","‘aḏ-",84,88],["הֵנָּה","H2008","HD","Here","hên·nāh",79,83],["מִשְׁפַּט","H4941","HNcmsc","the judgment","miš·paṭ",89,101],["מוֹאָֽב׃ס","H4124","HNp","on Moab","mō·w·’āḇ",102,109]]},"g":{"1":{"p":[["31:1","ΤΗ ΜΩΑΒ οὕτως εἶπε Κύριος, οὐαὶ ἐπὶ Ναβαῦ, ὅτι ὤλετο, ἐλήφθη Καριαθαὶμ, ᾐσχύνθη Ἀμὰθ καὶ Ἀγάθ."]]},"2":{"p":[["31:2","Οὐκ ἔστιν ἔτι ἰατρεία Μωὰβ, γαυρίαμα ἐν Ἐσεβὼν, ἐλογίσατο ἐπʼ αὐτὴν κακά· ἐκόψαμεν αὐτὴν ἀπὸ ἔθνους, καὶ παῦσιν παύσεται· ὄπισθέν σου βαδιεῖται μάχαιρα,"]]},"3":{"p":[["31:3","ὅτι φωνὴ κεκραγότων ἐξ Ὠρωναὶμ, ὄλεθρον καὶ σύντριμμα μέγα·"]]},"4":{"p":[["31:4","Συνετρίβη Μωὰβ, ἀναγγείλατε εἰς Ζογόρα,"]]},"5":{"p":[["31:5","ὅτι ἐπλήσθη Ἀλὼθ ἐν κλαυθμῷ· ἀναβήσεται κλαίων ἐν ὁδῷ Ὠρωναὶμ, κραυγὴν συντρίμματος ἠκούσατε."]]},"6":{"p":[["31:6","Φεύγετε καὶ σώσατε τὰς ψυχὰς ὑμῶν, καὶ ἔσεσθε ὥσπερ ὄνος ἄγριος ἐν ἐρήμῳ."]]},"7":{"p":[["31:7","Ἐπειδὴ ἐπεποίθεις ἐν ὀχυρώματί σου, καὶ σὺ συλληφθήσῃ· καὶ ἐξελεύσεται Χαμὼς ἐν ἀποικίᾳ, καὶ οἱ ἱερεῖς αὐτοῦ, καὶ οἱ ἄρχοντες αὐτοῦ ἅμα."]]},"8":{"p":[["31:8","Καὶ ἥξει ὄλεθρος ἐπὶ πᾶσαν πόλιν, οὐ μὴ σωθῇ, καὶ ἀπολεῖται ὁ αὐλῶν, καὶ ἐξολοθρευθήσεται ἡ πεδινὴ, καθὼς εἶπε Κύριος."]]},"9":{"p":[["31:9","Δότε σημεῖα τῇ Μωὰβ, ὅτι ἁφῇ ἁφθήσεται, καὶ πᾶσαι αἱ πόλεις αὐτῆς εἰς ἄβατον ἔσονται· πόθεν ἔνοικος αὐτῇ;"]]},"10":{"p":[["31:10","Ἐπικατάρατος ὁ ποιῶν τὰ ἔργα Κυρίου ἀμελῶς, ἐξαίρων μάχαιραν αὐτοῦ ἀφʼ αἵματος."]]},"11":{"p":[["31:11","Ἀνεπαύσατο Μωὰβ ἐκ παιδαρίου, καὶ πεποιθὼς ἦν ἐπὶ τῇ δόξῃ αὐτοῦ, οὐκ ἐνέχεεν ἐξ ἀγγείου εἰς ἀγγεῖον, καὶ εἰς ἀποικισμὸν οὐκ ᾤχετο· διατοῦτο ἔστη γεῦμα αὐτοῦ ἐν αὐτῷ, καὶ ὀσμὴ αὐτοῦ οὐκ ἐξέλιπε."]]},"12":{"p":[["31:12","Διατοῦτο ἰδοὺ ἡμέραι αὐτοῦ ἔρχονται, φησὶ Κύριος, καὶ ἀποστελῶ αὐτῷ κλίνοντας, καὶ κλινοῦσιν αὐτὸν, καὶ τὰ σκεύη αὐτοῦ λεπτυνοῦσι, καὶ τὰ κέρατα αὐτοῦ συγκόψουσι."]]},"13":{"p":[["31:13","Καὶ καταισχυνθήσεται Μωὰβ ἀπὸ Χαμὼς, ὥσπερ κατῃσχύνθη οἶκος Ἰσραὴλ ἀπὸ Βαιθὴλ ἐλπίδος αὐτῶν πεποιθότες ἐπʼ αὐτοῖς."]]},"14":{"p":[["31:14","Πῶς ἐρεῖτε, ἰσχυροί ἐσμεν, καὶ ἄνθρωπος ἰσχύων εἰς τὰ πολεμικά;"]]},"15":{"p":[["31:15","Ὤλετο Μωὰβ πόλις αὐτοῦ, καὶ ἐκλεκτοὶ νεανίσκοι αὐτοῦ κατέβησαν εἰς σφαγήν."]]},"16":{"p":[["31:16","Ἐγγὺς ἡμέρα Μωὰβ ἐλθεῖν, καὶ πονηρία αὐτοῦ ταχεῖα σφόδρα."]]},"17":{"p":[["31:17","Κινήσατε αὐτῷ πάντες κυκλόθεν αὐτοῦ, πάντες ἔκδοτε ὄνομα αὐτοῦ· εἴπατε, πῶς συνετρίβη βακτηρία εὐκλεὴς, ῥάβδος μεγαλώματος;"]]},"18":{"p":[["31:18","Κατάβηθι ἀπὸ δόξης, καὶ κάθισον ἐν ὑγρασίᾳ καθημένη· Δαιβὼν ἐκτριβήσεται, ὅτι ὤλετο Μωὰβ, ἀνέβη εἰς σὲ λυμαινόμενος ὀχύρωμά σου."]]},"19":{"p":[["31:19","Ἐφʼ ὁδοῦ στῆθι, καὶ ἔπιδε καθημένη ἐν Ἀρὴρ, καὶ ἐρώτησον φεύγοντα, καὶ σωζόμενον, καὶ εἰπὸν, τί ἐγένετο;"]]},"20":{"p":[["31:20","Κατῃσχύνθη Μωὰβ, ὅτι συνετρίβη· ὀλόλυξον καὶ κέκραξον, ἀνάγγειλον ἐν Ἀρνὼν, ὅτι ὤλετο Μωὰβ,"]]},"21":{"p":[["31:21","καὶ κρίσις ἔρχεται εἰς τὴν γῆν Μεισὼρ ἐπὶ Χελὼν, καὶ Ῥεφὰς, καὶ Μωφὰς,"]]},"22":{"p":[["31:22","καὶ ἐπὶ Δαιβὼν, καὶ ἐπὶ Ναβαῦ, καὶ ἐπʼ οἶκον Δαιθλαθαὶμ,"]]},"23":{"p":[["31:23","καὶ ἐπὶ Καριαθαὶμ, καὶ ἐπʼ οἶκον Γαιμὼλ, καὶ ἐπʼ οἶκον Μαὼν,"]]},"24":{"p":[["31:24","καὶ ἐπὶ Καριὼθ, καὶ ἐπὶ Βοσὸρ, καὶ ἐπὶ πάσας τὰς πόλεις Μωὰβ τὰς πόῤῥω καὶ τὰς ἐγγύς."]]},"25":{"p":[["31:25","Κατεάχθη κέρας Μωὰβ, καὶ τὸ ἐπίχειρον αὐτοῦ συνετρίβη."]]},"26":{"p":[["31:26","Μεθύσατε αὐτὸν, ὅτι ἐπὶ Κύριον ἐμεγαλύνθη· καὶ ἐπικρούσει Μωὰβ ἐν χειρὶ αὐτοῦ, καὶ ἔσται εἰς γέλωτα καὶ αὐτός."]]},"27":{"p":[["31:27","Καὶ εἰ μὴ εἰς γελοιασμὸν ἦν σοι Ἰσραὴλ, καὶ ἐν κλοπαῖς σου εὑρέθη, ὅτι ἐπολέμεις αὐτόν."]]},"28":{"p":[["31:28","Κατέλιπον τὰς πόλεις, καὶ ᾤκησαν ἐν πέτραις οἱ κατοικοῦντες Μωάβ· ἐγενήθησαν ὥσπερ περιστεραὶ νοσσεύουσαι ἐν πέτραις, στόματι βοθύνου."]]},"29":{"p":[["31:29","Καὶ ἤκουσα ὕβριν Μωὰβ, ὕβρισε λίαν ὕβριν αὐτοῦ, καὶ ὑπερηφανίαν αὐτοῦ· καὶ ὑψώθη ἡ καρδία αὐτοῦ."]]},"30":{"p":[["31:30","Ἐγὼ δὲ ἔγνων ἔργα αὐτοῦ· οὐχὶ τὸ ἱκανὸν αὐτῷ οὐχ οὕτως ἐποίησε;"]]},"31":{"p":[["31:31","Διατοῦτο ἐπὶ Μωὰβ ὀλολύζετε πάντοθεν· βοήσατε ἐπʼ ἄνδρας κειράδας αὐχμοῦ."]]},"32":{"p":[["31:32","Ὡς κλαυθμὸν Ἰαζὴρ ἀποκλαύσομαί σοι ἄμπελος Ἀσερημὰ, κλήματά σου διῆλθε θάλασσαν, πόλεις Ἰαζὴρ ἥψαντο, ἐπὶ ὀπώραν σου, ἐπὶ τρυγηταῖς σου ὄλεθρος ἐπέπεσε."]]},"33":{"p":[["31:33","Συνεψήσθη χαρμοσύνη καὶ εὐφροσύνη ἐκ τῆς Μωαβίτιδος· καὶ οἶνος ἦν ἐπὶ ληνοῖς σου, πρωῒ οὐκ ἐπάτησαν, οὐδὲ δείλης οὐκ ἐποίησαν,"]]},"34":{"p":[["31:34","αἱ δὲ ἀπὸ κραυγῆς Ἐσεβὼν ἕως Αἰτὰμ αἱ πόλεις αὐτῶν ἔδωκαν φωνὴν αὐτῶν, ἀπὸ Ζογὸρ ἕως Ὠρωναὶμ, καὶ ἀγγελίαν σαλασία, ὅτι καὶ τὸ ὕδωρ Νεβρεὶν εἰς κατάκαυμα ἔσται."]]},"35":{"p":[["31:35","Καὶ ἀπολῶ τὸν Μωὰβ, φησὶ Κύριος, ἀναβαίνοντα ἐπὶ τὸν βωμὸν, καὶ θυμιῶντα θεοῖς αὐτοῦ."]]},"36":{"p":[["31:36","Διατοῦτο καρδία τοῦ Μωὰβ, ὥσπερ αὐλοὶ βουβήσουσι, καρδία μου ἐπʼ ἀνθρώπους κειράδας ὥσπερ αὐλὸς βομβήσει· διατοῦτο ἃ περιεποιήσατο, ἀπώλετο ἀπὸ ἀνθρώπου."]]},"37":{"p":[["31:37","Πᾶσαν κεφαλὴν ἐν παντὶ τόπῳ ξυρηθήσονται, καὶ πᾶς πώγων ξυρηθήσεται, καὶ πᾶσαι χεῖρες κόψονται, καὶ ἐπὶ πάσης ὀσφύος σάκκος."]]},"38":{"p":[["31:38","Καὶ ἐπὶ πάντων τῶν δωμάτων Μωὰβ, καὶ ἐπὶ ταῖς πλατείαις αὐτῆς, ὅτι συνέτριψα, φησὶ Κύριος, ὡς ἀγγεῖον, οὗ οὐκ ἔστι χρεία αὐτοῦ."]]},"39":{"p":[["31:39","Πῶς κατήλλαξε; πῶς ἔστρεψε νῶτον Μωάβ; ᾐσχύνθη, καὶ ἐγένετο Μωὰβ εἰς γέλωτα, καὶ ἐγκότημα πᾶσι τοῖς κύκλῳ αὐτῆς."]]},"40":{"p":[["31:40","Ὅτι οὕτως εἶπε Κύριος,"]]},"41":{"p":[["31:41","Ἐλήφθη Καριὼθ, καὶ τὰ ὀχυρώματα συνελήφθη,"]]},"42":{"p":[["31:42","καὶ ἀπολεῖται Μωὰβ ἀπὸ ὄχλου, ὅτι ἐπὶ τὸν Κύριον ἐμεγαλύνθη."]]},"43":{"p":[["31:43","Παγὶς καὶ φόβος καὶ βόθυνος ἐπὶ σὲ καθήμενος Μωάβ."]]},"44":{"p":[["31:44","Ὁ φεύγων ἀπὸ προσώπου τοῦ φόβου, ἐμπεσεῖται εἰς τὸν βόθυνον· καὶ ὁ ἀναβαίνων ἐκ τοῦ βοθύνου, καὶ συλληφθήσεται ἐν τῇ παγίδι· ὅτι ἐπάξω ταῦτα ἐπὶ Μωὰβ ἐν ἐνιαυτῷ ἐπισκέψεως αὐτῶν."]]}}}