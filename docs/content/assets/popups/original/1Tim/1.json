ַ אֲדֹנֵינוּ׃","3":"בְּלֶכְתִּי לְמַקְדּוֹנְיָא בִּקַּשְׁתִּיךָ לָשֶׁבֶת בְּאֶפְסוֹס לְצַוֹּת עַל־אֲנָשִׁים אֲחָדִים לְבִלְתִּי יוֹרוּ תּוֹרָה נָכְרִיָּה׃","4":"וְלֹא יִתְעַסְּקוּ בְדִבְרֵי אַגָּדָה וּבְתוֹלְדוֹת הַדֹּרוֹת חִשְּׁבֹנוֹת לְאֵין־קֵץ הַנֹּתְנִים יָדַיִם לְהִתְוַכֵּחַ וְלֹא לְחַזֵּק בֵּית־אֱלֹהִים בָּאֱמוּנָה׃","5":"כִּי־תַכְלִית מִצְוַת הַתּוֹרָה הִיא אַהֲבָה בְּלֵב טָהוֹר בְּרוּחַ נָכוֹן וּבֶאֱמוּנָה נְקִיָּה מִכָּל־סִיג׃","6":"אַךְ יֵשׁ אֲשֶׁר נָטוּ מִנִּי־אֹרַח וַיֵּלְכוּ אַחֲרֵי הֶהָבֶל׃","7":"יִתְאַמְּרוּ לִהְיוֹת מוֹרִים בַּתּוֹרָה וְלֹא־יָבִינוּ אֵת אֲשֶׁר יְדַבֵּרוּן וְלֹא אֶת־הַדָּבָר אֲשֶׁר עָלָיו יַחְלֹטוּן׃","8":"הֵן הַתּוֹרָה יָדַעְנוּ כִּי טוֹבָה הִיא אִם־יֵלֵךְ הָאָדָם בִּנְתִיבֹתֶיהָ כַּמִּשְׁפָּט׃","9":"וְהוּא יָבִין כִּי תוֹרָה נְתוּנָה לֹא לְאַנְשֵׁי צֶדֶק כִּי אִם־לִבְנֵי בְלִיַּעַל מֹרְדִים פּשְׁעִים וְחַטָּאִים עֹשֵׂי תוֹעֵבָה וּנְבָלָה מַכֵּי אָב וְאֵם אוֹ מְרַצְּחִים׃","10":"נֹאֲפִים וְשֹׁכְבִים אֶת־זָכָר גֹּנְבֵי נֶפֶשׁ בָּנִים כֶּחָשִׁים וְנִשְׁבָּעִים לַשָּׁקֶר וְעוֹד אֲחֵרִים כְּמוֹהֶם מַמְרִים בְּתוֹרַת חַיִּים׃","11":"כְּפִי בְּשׁרַת כְּבוֹד הָאֱלֹהִים בָּרוּךְ הוּא אֲשֶׁר הִפְקִיד בְּיָדִי׃","12":"וּלְיֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ הַמְאַזְּרֵנִי חַיִל אֶתֵּן תְּהִלָּה כִּי מָצָא אֶת־לְבָבִי נֶאֱמָן לְפָנָיו וַיַּקְרֵב אֹתִי לְשָׁרְתוֹ׃","13":"אָנֹכִי אֲשֶׁר מְגַדֵּף הָיִיתִי לְפָנִים מְרַדֵּף וּמְחַבֵּל אַךְ רֻחַמְתִּי כִּי עָשִׂיתִי בִשְׁגָגָה בִּבְלִי־אֱמוּנָה׃","14":"וַיִּגְדַּל חֶסֶד אֲדֹנֵינוּ עָלַי עַד־מְאֹד וֶאֱמוּנָה וְאַהֲבָה בְּיֵשׁוּעַ מְשִׁיחֵנוּ׃","15":"אֱמֶת הַדָּבָר וְיָאֲתָה לְכָל־אָדָם לְקַבְּלוֹ כִּי יֵשׁוּעַ הַמָּשִׁיחַ בָּא אֶל־הָאָרֶץ לְהוֹשִׁיעַ אֶת־הַחַטָּאִים וְאָנֹכִי הָרֹאשׁ לָהֶם׃","16":"וּבַעֲבוּר זֹאת רֻחַמְתִּי לְמַעַן יְגַלֶּה בִּי יֵשׁוּעַ הַמָּשִׁיחַ רִאשֹׁנָה אֶת־כָּל־אֹרֶךְ רוּחוֹ לִהְיוֹת לְמוֹפֵת לַבָּאִים אַחֲרַי אֲשֶׁר יַאֲמִינוּ בוֹ לְחַיֵּי עוֹלָם׃","17":"וּלְמֶלֶךְ עוֹלָם שֹׁכֵן עַד אֲשֶׁר עַיִן לֹא תְשׁוּרֶנּוּ הוּא אֱלֹהִים אֶחָד וְהֶחָכָם לְבַדוֹ לוֹ הַגְּדֻלָּה וְהַתִּפְאֶרֶת מֵהָעוֹלָם וְעַד־הָעוֹלָם אָמֵן׃","18":"אֶת־הַמִּצְוָה הַזֹּאת אֲנִי מְצַוְּךָ הַיּוֹם טִימוֹתִיּוֹס בְּנִי כַּאֲשֶׁר דִּבְּרוּ עָלֶיךָ הַנְּבוּאוֹת מֵאָז אֲשֶׁר עַל־פִּיהֶן תִּלָּחֵם מִלְחֶמֶת צֶדֶק׃","19":"כִּי תַחֲזִיק בֶּאֱמוּנָה וּבְרוּחַ נָכוֹן וְלֹא כַאֲנָשִׁים אֲשֶׁר הָיְתָה רוּחַ אַחֶרֶת אִתָּם וָאֳנִיַּת אֱמוּנָתָם נִשְׁבְּרָה׃","20":"וּמֵהֶם הוּמְנִיּוֹס וַאֲלֶכְסַנְדְּרוֹס אֲשֶׁר הִסְגַּרְתִּים בְּיַד הַשָּׂטָן לְמַעַן יִוָּסְרוּ וְלֹא יְגַדְּפוּ עוֹד׃"}}