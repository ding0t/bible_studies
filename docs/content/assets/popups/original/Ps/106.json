t we may give thanks","lə·hō·ḏō·wṯ",57,80],["לְשֵׁם","H8034","HR/Ncmsc","name","lə·šêm",94,98],["קָדְשֶׁךָ","H6944","HNcmsc/Sp2ms","to Your holy","qāḏ·še·ḵā",81,93],["לְהִשְׁתַּבֵּחַ","H7623","HR/Vtc","that we may glory","lə·hiš·tab·bê·aḥ",100,117],["בִּתְהִלָּתֶֽךָ׃","H8416","HR/Ncfsc/Sp2ms","in Your praise","biṯ·hil·lā·ṯe·ḵā",118,132]],"48":[["בָּרוּךְ־","H1288","HVqsmsa","Blessed [be]","bā·rūḵ-",0,10],["יְהוָה","H3068","HNp","the LORD","Yah·weh",11,19],["אֱלֹהֵי","H430","HNcmpc","the God","’ĕ·lō·hê",21,28],["יִשְׂרָאֵל","H3478","HNp","of Israel","yiś·rā·’êl",29,38],["מִן־","H4480","HR","from","min-",40,44],["הָעוֹלָם","H5769","HTd/Ncmsa","everlasting","hā·‘ō·w·lām",45,56],["וְעַד","H5704",0,"to","wə·‘aḏ",57,59],["הָעוֹלָם","H5769","HTd/Ncmsa","everlasting","hā·‘ō·w·lām",60,71],["וְאָמַר","H559","HC/Vqq3ms","say","wə·’ā·mar",92,95],["כָּל־","H3605","HNcmsc","Let all","kāl-",73,80],["הָעָם","H5971","HTd/Ncmsa","the people","hā·‘ām",81,91],["אָמֵן","H543","HD","Amen","’ā·mên",98,102],["הַֽלְלוּ־","H1984","HVpv2mp","Hallelujah","hal·lū-",105,115],["יָֽהּ׃","H3050","HNp",0,"yāh"]]},"g":{"1":{"p":[["105:1","Ἀλληλούϊα. Ἐξομολογεῖσθε τῷ Κυρίῳ, ὅτι χρηστὸς, ὅτι εἰς τὸν αἰῶνα τὸ ἔλεος αὐτοῦ."]]},"2":{"p":[["105:2","Τίς λαλήσει τὰς δυναστείας τοῦ Κυρίου, ἀκουστὰς ποιήσει πάσας τὰς αἰνέσεις αὐτοῦ;"]]},"3":{"p":[["105:3","Μακάριοι οἱ φυλάσσοντες κρίσιν, καὶ ποιοῦντες δικαιοσύνην ἐν παντὶ καιρῷ."]]},"4":{"p":[["105:4","Μνήσθητι ἡμῶν Κύριε ἐν τῇ εὐδοκίᾳ τοῦ λαοῦ σου, ἐπίσκεψαι ἡμᾶς ἐν τῷ σωτηρίῳ σου·"]]},"5":{"p":[["105:5","τοῦ ἰδεῖν ἐν τῇ χρηστότητι τῶν ἐκλεκτῶν σου, τοῦ εὐφρανθῆναι ἐν τῇ εὐφροσύνῃ τοῦ ἔθνους σου, τοῦ ἐπαινεῖσθαι μετὰ τῆς κληρονομίας σου."]]},"6":{"p":[["105:6","Ἡμάρτομεν μετὰ τῶν πατέρων ἡμῶν, ἠνομήσαμεν, ἠδικήσαμεν."]]},"7":{"p":[["105:7","Οἱ πατέρες ἡμῶν ἐν Αἰγύπτῳ οὐ συνῆκαν τὰ θαυμάσιά σου, καὶ οὐκ ἐμνήσθησαν τοῦ πλήθους τοῦ ἐλέους σου· καὶ παρεπίκραναν ἀναβαίνοντες ἐν τῇ ἐρυθρᾷ θαλάσσῃ."]]},"8":{"p":[["105:8","Καὶ ἔσωσεν αὐτοὺς ἕνεκεν τοῦ ὀνόματος αὐτοῦ, τοῦ γνωρίσαι τὴν δυναστείαν αὐτοῦ."]]},"9":{"p":[["105:9","Καὶ ἐπετίμησε τῇ ἐρυθρᾷ θαλάσσῃ, καὶ ἐξηράνθη· καὶ ὡδήγησεν αὐτοὺς ἐν ἀβύσσῳ ὡς ἐν ἐρήμῳ·"]]},"10":{"p":[["105:10","Καὶ ἔσωσεν αὐτοὺς ἐκ χειρὸς μισούντων, καὶ ἐλυτρώσατο αὐτοὺς ἐκ χειρὸς ἐχθροῦ."]]},"11":{"p":[["105:11","Ἐκάλυψεν ὕδωρ τοὺς θλίβοντας αὐτοὺς, εἷς ἐξ αὐτῶν οὐχ ὑπελείφθη."]]},"12":{"p":[["105:12","Καὶ ἐπίστευσαν τοῖς λόγοις αὐτοῦ, καὶ ᾔνεσαν τὴν αἴνεσιν αὐτοῦ."]]},"13":{"p":[["105:13","Ἐτάχυναν, ἐπελάθοντο τῶν ἔργων αὐτοῦ, οὐχ ὑπέμειναν τὴν βουλὴν αὐτοῦ."]]},"14":{"p":[["105:14","Καὶ ἐπεθύμησαν ἐπιθυμίαν ἐν τῇ ἐρήμῳ, καὶ ἐπείρασαν τὸν Θεὸν ἐν ἀνύδρῳ."]]},"15":{"p":[["105:15","Καὶ ἔδωκεν αὐτοῖς τὸ αἴτημα αὐτῶν, καὶ ἐξαπέστειλε πλησμονὴν εἰς τὴν ψυχὴν αὐτῶν."]]},"16":{"p":[["105:16","Καὶ παρώργισαν Μωυσῆν ἐν τῇ παρεμβολῇ, καὶ Ἀαρὼν τὸν ἅγιον Κυρίου."]]},"17":{"p":[["105:17","Ἠνοίχθη ἡ γῆ καὶ κατέπιε Δαθὰν, καὶ ἐκάλυψεν ἐπὶ τὴν συναγωγὴν Ἀβειρών."]]},"18":{"p":[["105:18","Καὶ ἐξεκαύθη πῦρ ἐν τῇ συναγωγῇ αὐτῶν, καὶ φλὸξ κατέφλεξεν ἁμαρτωλούς."]]},"19":{"p":[["105:19","Καὶ ἐποίησαν μόσχον ἐν Χωρὴβ, καὶ προσεκύνησαν τῷ γλυπτῷ·"]]},"20":{"p":[["105:20","Καὶ ἠλλάξαντο τὴν δόξαν αὐτῶν ἐν ὁμοιώματι μόσχου ἔσθοντος χόρτον."]]},"21":{"p":[["105:21","Ἐπελάθοντο τοῦ Θεοῦ τοῦ σώζοντος αὐτοὺς, τοῦ ποιήσαντος μεγάλα ἐν Αἰγύπτῳ,"]]},"22":{"p":[["105:22","θαυμαστὰ ἐν γῇ Χὰμ, καὶ φοβερὰ ἐπὶ θαλάσσης ἐρυθρᾶς."]]},"23":{"p":[["105:23","Καὶ εἶπε τοῦ ἐξολοθρεῦσαι αὐτοὺς, εἰ μὴ Μωυσῆς ὁ ἐκλεκτὸς αὐτοῦ ἔστη ἐν τῇ θραύσει ἐνώπιον αὐτοῦ, τοῦ ἀποστρέψαι ἀπὸ θυμοῦ ὀργῆς αὐτοῦ, τοῦ μὴ ἐξολοθρεῦσαι."]]},"24":{"p":[["105:24","Καὶ ἐξουδένωσαν γῆν ἐπιθυμητὴν, καὶ οὐκ ἐπίστευσαν τῷ λόγῳ αὐτοῦ."]]},"25":{"p":[["105:25","Καὶ ἐγόγγυσαν ἐν τοῖς σκηνώμασιν αὐτῶν, οὐκ εἰσήκουσαν τῆς φωνῆς Κυρίου."]]},"26":{"p":[["105:26","Καὶ ἐπῇρε τὴν χεῖρα αὐτοῦ ἐπʼ αὐτοὺς, τοῦ καταβαλεῖν αὐτοὺς ἐν τῇ ἐρήμῳ,"]]},"27":{"p":[["105:27","καὶ τοῦ καταβαλεῖν τὸ σπέρμα αὐτῶν ἐν τοῖς ἔθνεσι, καὶ διασκορπίσαι αὐτοὺς ἐν ταῖς χώραις."]]},"28":{"p":[["105:28","Καὶ ἐτελέσθησαν τῷ Βεελφεγὼρ, καὶ ἔφαγον θυσίας νεκρῶν."]]},"29":{"p":[["105:29","Καὶ παρώξυναν αὐτὸν ἐν τοῖς ἐπιτηδεύμασιν αὐτῶν, καὶ ἐπληθύνθη ἐν αὐτοῖς ἡ πτῶσις."]]},"30":{"p":[["105:30","Καὶ ἔστη Φινεὲς καὶ ἐξιλάσατο, καὶ ἐκόπασεν ἡ θραῦσις."]]},"31":{"p":[["105:31","Καὶ ἐλογίσθη αὐτῷ εἰς δικαιοσύνην, εἰς γενεὰν καὶ γενεὰν ἕως τοῦ αἰῶνος."]]},"32":{"p":[["105:32","Καὶ παρώργισαν αὐτὸν ἐπὶ ὕδατος ἀντιλογίας, καὶ ἐκακώθη Μωυσῆς διʼ αὐτούς·"]]},"33":{"p":[["105:33","Ὅτι παρεπίκραναν τὸ πνεῦμα αὐτοῦ, καὶ διέστειλεν ἐν τοῖς χείλεσιν αὐτοῦ."]]},"34":{"p":[["105:34","Οὐκ ἐξωλόθρευσαν τὰ ἔθνη ἃ εἶπε Κύριος αὐτοῖς."]]},"35":{"p":[["105:35","Καὶ ἐμίγησαν ἐν τοῖς ἔθνεσι, καὶ ἔμαθον τὰ ἔργα αὐτῶν."]]},"36":{"p":[["105:36","Καὶ ἐδούλευσαν τοῖς γλυπτοῖς αὐτῶν, καὶ ἐγενήθη αὐτοῖς εἰς σκάνδαλον."]]},"37":{"p":[["105:37","Καὶ ἔθυσαν τοὺς υἱοὺς αὐτῶν καὶ τὰς θυγατέρας αὐτῶν τοῖς δαιμονίοις,"]]},"38":{"p":[["105:38","καὶ ἐξέχεαν αἷμα ἀθῶον, αἷμα υἱῶν αὐτῶν καὶ θυγατέρων, ὧν ἔθυσαν τοῖς γλυπτοῖς Χαναάν· καὶ ἐφονοκτονήθη ἡ γῆ ἐν τοῖς αἵμασι,"]]},"39":{"p":[["105:39","καὶ ἐμιάνθη ἐν τοῖς ἔργοις αὐτῶν· καὶ ἐπόρνευσαν ἐν τοῖς ἐπιτηδεύμασιν αὐτῶν."]]},"40":{"p":[["105:40","Καὶ ὠργίσθη θυμῷ Κύριος ἐπὶ τὸν λαὸν αὐτοῦ, καὶ ἐβδελύξατο τὴν κληρονομίαν αὐτοῦ."]]},"41":{"p":[["105:41","Καὶ παρέδωκεν αὐτοὺς εἰς χεῖρας ἐχθρῶν, καὶ ἐκυρίευσαν αὐτῶν οἱ μισοῦντες αὐτούς."]]},"42":{"p":[["105:42","Καὶ ἔθλιψαν αὐτοὺς οἱ ἐχθροὶ αὐτῶν, καὶ ἐταπεινώθησαν ὑπὸ τὰς χεῖρας αὐτῶν."]]},"43":{"p":[["105:43","Πλεονάκις ἐῤῥύσατο αὐτοὺς, αὐτοὶ δὲ παρεπίκραναν αὐτὸν ἐν τῇ βουλῇ αὐτῶν· καὶ ἐταπεινώθησαν ἐν ταῖς ἀνομίαις αὐτῶν."]]},"44":{"p":[["105:44","Καὶ εἶδε Κύριος ἐν τῷ θλίβεσθαι αὐτοὺς, ἐν τῷ αὐτὸν εἰσακοῦσαι τῆς δεήσεως αὐτῶν."]]},"45":{"p":[["105:45","Καὶ ἐμνήσθη τῆς διαθήκης αὐτοῦ, καὶ μετεμελήθη κατὰ τὸ πλῆθος τοῦ ἐλέους αὐτοῦ."]]},"46":{"p":[["105:46","Καὶ ἔδωκεν αὐτοὺς εἰς οἰκτιρμοὺς ἐναντίον πάντων τῶν αἰχμαλωτευσάντων αὐτούς."]]},"47":{"p":[["105:47","Σῶσον ἡμᾶς Κύριε ὁ Θεὸς ἡμῶν, καὶ ἐπισυνάγαγε ἡμᾶς ἐκ τῶν ἐθνῶν, τοῦ ἐξομολογήσασθαι τῷ ὀνόματί σου τῷ ἁγίῳ, τοῦ ἐγκαυχᾶσθαι ἐν τῇ αἰνέσει σου."]]},"48":{"p":[["105:48","Εὐλογητὸς Κύριος ὁ Θεὸς Ἰσραὴλ, ἀπὸ τοῦ αἰῶνος καὶ ἕως τοῦ αἰῶνος· καὶ ἐρεῖ πᾶς ὁ λαὸς, γένοιτο, γένοιτο."]]}}}