mies","’ō·wy·ḇe·ḵā",4,16],["יְהוָה","H3068","HNp","O LORD","Yah·weh",31,37],["אֲשֶׁר","H834","HTr","[and]","’ă·šer",39,42],["חֵרְפוּ","H2778","HVpp3cp","have mocked","ḥê·rə·p̄ū",43,54],["עִקְּבוֹת","H6119","HNcmpc","every step","‘iq·qə·ḇō·wṯ",55,65],["מְשִׁיחֶֽךָ׃","H4899","HNcmsc/Sp2ms","of Your anointed one","mə·šî·ḥe·ḵā",66,86]]]]},"52":{"p":[["89:53",[["בָּרוּךְ","H1288","HVqsmsa","Blessed be","bā·rūḵ",0,10],["יְהוָה","H3068","HNp","the LORD","Yah·weh",11,19],["לְעוֹלָם","H5769","HR/Ncmsa","forever","lə·‘ō·w·lām",20,27],["אָמֵן","H543","HD","Amen","’ā·mên",29,33],["וְאָמֵֽן׃","H543","HC/D","and amen","wə·’ā·mên",34,42]]]]}},"g":{"1":{"p":[["88:1","Συνέσεως Αἰθὰμ τῷ Ἰσραηλίτῃ."],["88:2","Τὰ ἐλέη σου Κύριε εἰς τὸν αἰῶνα ᾄσομαι, εἰς γενεὰν καὶ γενεὰν ἀπαγγελῶ τὴν ἀλήθειάν σου ἐν τῷ στόματί μου."]]},"2":{"p":[["88:3","Ὅτι εἶπας, εἰς τὸν αἰῶνα ἔλεος οἰκοδομηθήσεται, ἐν τοῖς οὐρανοῖς ἑτοιμασθήσεται ἡ ἀλήθειά σου·"]]},"3":{"p":[["88:4","Διεθέμην διαθήκην τοῖς ἐκλεκτοῖς μου, ὤμοσα Δαυὶδ τῷ δούλῳ μου."]]},"4":{"p":[["88:5","Ἕως τοῦ αἰῶνος ἑτοιμάσω τὸ σπέρμα σου, καὶ οἰκοδομήσω εἰς γενεὰν καὶ γενεὰν τὸν θρόνον σου· διάψαλμα."]]},"5":{"p":[["88:6","Ἐξομολογήσονται οἱ οὐρανοὶ τὰ θαυμάσιά σου Κύριε, καὶ τὴν ἀλήθειάν σου ἐν ἐκκλησίᾳ ἁγίων."]]},"6":{"p":[["88:7","Ὅτι τίς ἐν νεφέλαις ἰσωθήσεται τῷ Κυρίῳ; καὶ τίς ὁμοιωθήσεται τῷ Κυρίῳ ἐν υἱοῖς Θεοῦ;"]]},"7":{"p":[["88:8","Ὁ Θεὸς ἐνδοξαζόμενος ἐν βουλῇ ἁγίων, μέγας καὶ φοβερὸς ἐπὶ πάντας τοὺς περικύκλῳ αὐτοῦ."]]},"8":{"p":[["88:9","Κύριε ὁ Θεὸς τῶν δυνάμεων, τίς ὅμοιός σοι; δυνατὸς εἶ Κύριε, καὶ ἡ ἀλήθειά σου κύκλῳ σου."]]},"9":{"p":[["88:10","Σὺ δεσπόζεις τοῦ κράτους τῆς θαλάσσης, τὸν δὲ σάλον τῶν κυμάτων αὐτῆς σὺ καταπραΰνεις."]]},"10":{"p":[["88:11","Σὺ ἐταπείνωσας ὡς τραυματίαν ὑπερήφανον, καὶ ἐν τῷ βραχίονι τῆς δυνάμεώς σου διεσκόρπισας τοὺς ἐχθρούς σου."]]},"11":{"p":[["88:12","Σοί εἰσιν οἱ οὐρανοὶ, καὶ σή ἐστιν ἡ γῆ, τὴν οἰκουμένην καὶ τὸ πλήρωμα αὐτῆς σὺ ἐθεμελίωσας."]]},"12":{"p":[["88:13","Τὸν Βοῤῥᾶν καὶ θάλασσας σὺ ἔκτισας, Θαβὼρ καὶ Ἑρμὼν ἐν τῷ ὀνόματί σου ἀγαλλιάσονται."]]},"13":{"p":[["88:14","Σὸς ὁ βραχίων μετὰ δυναστείας· κραταιωθήτω ἡ χείρ σου, ὑψωθήτω ἡ δεξιά σου."]]},"14":{"p":[["88:15","Δικαιοσύνη καὶ κρίμα ἑτοιμασία τοῦ θρόνου σου· ἔλεος καὶ ἀλήθεια προπορεύσονται πρὸ προσώπου σου."]]},"15":{"p":[["88:16","Μακάριος ὁ λαὸς ὁ γινώσκων ἀλαλαγμόν· Κύριε ἐν τῷ φωτὶ τοῦ προσώπου σου πορεύσονται,"]]},"16":{"p":[["88:17","καὶ ἐν τῷ ὀνόματί σου ἀγαλλιάσονται ὅλην τὴν ἡμέραν, καὶ ἐν τῇ δικαιοσύνῃ σου ὑψωθήσονται."]]},"17":{"p":[["88:18","Ὅτι τὸ καύχημα τῆς δυνάμεως αὐτῶν σὺ εἶ, καὶ ἐν τῇ εὐδοκίᾳ σου ὑψωθήσεται τὸ κέρας ἡμῶν·"]]},"18":{"p":[["88:19","ὅτι τοῦ Κυρίου ἡ ἀντίληψις, καὶ τοῦ ἁγίου Ἰσραὴλ βασιλέως ἡμῶν."]]},"19":{"p":[["88:20","Τότε ἐλάλησας ἐν ὁράσει τοῖς υἱοῖς σου, καὶ εἶπας, ἐθέμην βοήθειαν ἐπὶ δυνατὸν, ὕψωσα ἐκλεκτὸν ἐκ τοῦ λαοῦ μου."]]},"20":{"p":[["88:21","Εὗρον Δαυὶδ τὸν δοῦλόν μου, ἐν ἐλέει ἁγίῳ ἔχρισα αὐτόν."]]},"21":{"p":[["88:22","Ἡ γὰρ χείρ μου συναντιλήψεται αὐτῷ, καὶ ὁ βραχίων μου κατισχύσει αὐτόν."]]},"22":{"p":[["88:23","Οὐκ ὠφελήσει ἐχθρὸς ἐν αὐτῷ, καὶ υἱὸς ἀνομίας οὐ προσθήσει τοῦ κακῶσαι αὐτόν."]]},"23":{"p":[["88:24","Καὶ συγκόψω ἀπὸ προσώπου αὐτοῦ τοὺς ἐχθροὺς αὐτοῦ, καὶ τοὺς μισοῦντας αὐτὸν τροπώσομαι."]]},"24":{"p":[["88:25","Καὶ ἡ ἀλήθειά μου καὶ τὸ ἔλεός μου μετʼ αὐτοῦ, καὶ ἐν τῷ ὀνόματί μου ὑψωθήσεται τὸ κέρας αὐτοῦ."]]},"25":{"p":[["88:26","Καὶ θήσομαι ἐν θαλάσσῃ χεῖρα αὐτοῦ, καὶ ἐν ποταμοῖς δεξιὰν αὐτοῦ."]]},"26":{"p":[["88:27","Αὐτὸς ἐπικαλέσεταί με, πατήρ μου εἶ σὺ, Θεός μου καὶ ἀντιλήπτωρ τῆς σωτηρίας μου."]]},"27":{"p":[["88:28","Κᾀγὼ πρωτότοκον θήσομαι αὐτὸν, ὑψηλὸν παρὰ τοῖς βασιλεῦσι τῆς γῆς."]]},"28":{"p":[["88:29","Εἰς τὸν αἰῶνα φυλάξω αὐτῷ τὸ ἔλεός μου, καὶ ἡ διαθήκη μου πιστὴ αὐτῷ."]]},"29":{"p":[["88:30","Καὶ θήσομαι εἰς τὸν αἰῶνα τοῦ αἰῶνος τὸ σπέρμα αὐτοῦ, καὶ τὸν θρόνον αὐτοῦ ὡς τὰς ἡμέρας τοῦ οὐρανοῦ."]]},"30":{"p":[["88:31","Ἐὰν ἐγκαταλίπωσιν οἱ υἱοὶ αὐτοῦ τὸν νόμον μου, καὶ τοῖς κρίμασί μου μὴ πορευθῶσιν·"]]},"31":{"p":[["88:32","ἐὰν τὰ δικαιώματά μου βεβηλώσωσι, καὶ τὰς ἐντολάς μου μὴ φυλάξωσιν·"]]},"32":{"p":[["88:33","Ἐπισκέψομαι ἐν ῥάβδῳ τὰς ἀνομίας αὐτῶν, καὶ ἐν μάστιξι τὰς ἁμαρτίας αὐτῶν."]]},"33":{"p":[["88:34","Τὸ δὲ ἔλεός μου οὐ μὴ διασκεδάσω ἀπʼ αὐτοῦ, οὐδὲ μὴ ἀδικήσω ἐν τῇ ἀληθείᾳ μου,"]]},"34":{"p":[["88:35","οὐδὲ μὴ βεβηλώσω τὴν διαθήκην μου, καὶ τὰ ἐκπορευόμενα διὰ τῶν χειλέων μου οὐ μὴ ἀθετήσω."]]},"35":{"p":[["88:36","Ἅπαξ ὤμοσα ἐν τῷ ἁγίῳ μου, εἰ τῷ Δαυὶδ ψεύσομαι."]]},"36":{"p":[["88:37","Τὸ σπέρμα αὐτοῦ εἰς τὸν αἰῶνα μενεῖ, καὶ ὁ θρόνος αὐτοῦ ὡς ὁ ἥλιος ἐναντίον μου,"]]},"37":{"p":[["88:38","καὶ ὡς ἡ σελήνη κατηρτισμένη εἰς τὸν αἰῶνα, καὶ ὁ μάρτυς ἐν οὐρανῷ πιστός· διάψαλμα."]]},"38":{"p":[["88:39","Σὺ δὲ ἀπώσω καὶ ἐξουδένωσας, ἀνεβάλου τὸν χριστόν σου."]]},"39":{"p":[["88:40","Κατέστρεψας τὴν διαθήκην τοῦ δούλου σου, ἐβεβήλωσας εἰς τὴν γῆν τὸ ἁγίασμα αὐτοῦ."]]},"40":{"p":[["88:41","Καθεῖλες πάντας τοὺς φραγμοῦς αὐτοῦ, ἔθου τὰ ὀχυρώματα αὐτοῦ δειλίαν."]]},"41":{"p":[["88:42","Διήρπασαν αὐτὸν πάντες οἱ διοδεύοντες ὁδὸν, ἐγενήθη ὄνειδος τοῖς γείτοσιν αὐτοῦ."]]},"42":{"p":[["88:43","Ὕψωσας τὴν δεξιὰν τῶν ἐχθρῶν αὐτοῦ, εὔφρανας πάντας τοὺς ἐχθροὺς αὐτοῦ."]]},"43":{"p":[["88:44","Ἀπέστρεψας τὴν βοήθειαν τῆς ῥομφαίας αὐτοῦ, καὶ οὐκ ἀντελάβου αὐτοῦ ἐν τῷ πολέμῳ."]]},"44":{"p":[["88:45","Κατέλυσας ἀπὸ καθαρισμοῦ αὐτὸν, τὸν θρόνον αὐτοῦ εἰς τὴν γῆν κατέῤῥαξας,"]]},"45":{"p":[["88:46","ἐσμίκρυνας τὰς ἡμέρας τοῦ θρόνου αὐτοῦ, κατέχεας αὐτοῦ αἰσχύνην· διάψαλμα."]]},"46":{"p":[["88:47","Ἕως πότε Κύριε ἀποστρέφῃ εἰς τέλος; ἐκκαυθήσεται ὡς πῦρ ἡ ὀργή σου;"]]},"47":{"p":[["88:48","Μνήσθητι τίς ἡ ὑπόστασίς μου· μὴ γὰρ ματαίως ἔκτισας πάντας τοὺς υἱοὺς τῶν ἀνθρώπων;"]]},"48":{"p":[["88:49","Τίς ἐστιν ἄνθρωπος, ὃς ζήσεται καὶ οὐκ ὄψεται θάνατον; ῥύσεται τὴν ψυχὴν αὐτοῦ ἐκ χειρὸς ᾅδου; διάψαλμα."]]},"49":{"p":[["88:50","Ποῦ ἐστι τὰ ἐλέη σου τὰ ἀρχαῖα, Κύριε, ἃ ὤμοσας τῷ Δαυὶδ ἐν τῇ ἀληθείᾳ σου;"]]},"50":{"p":[["88:51","Μνήσθητι Κύριε τοῦ ὀνειδισμου τῶν δούλων σου οὗ ὑπέσχον ἐν τῷ κόλπῳ μου πολλῶν ἐθνῶν·"]]},"51":{"p":[["88:52","οὗ ὠνείδισαν οἱ ἐχθροί σου Κύριε, οὗ ὠνείδισαν τὸ ἀντάλλαγμα τοῦ χριστοῦ σου."]]},"52":{"p":[["88:53","Εὐλογητὸς Κύριος εἰς τὸν αἰῶνα· γένοιτο, γένοιτο."]]}}}