,"HVqrmpc/Sp1cs","above my foes","qā·may",46,59],["תְּרוֹמְמֵנִי","H7311","HVoi2ms/Sp1cs","You exalt me","tə·rō·wm·mê·nî",33,45],["מֵאִישׁ","H376","HR/Ncmsc","men","mê·’îš",88,91],["חָמָס","H2555","HNcmsa","from violent","ḥā·mās",75,87],["תַּצִּילֵֽנִי׃","H5337","HVhi2ms/Sp1cs","You rescue me","taṣ·ṣî·lê·nî",61,74]]]]},"49":{"p":[["18:50",[["עַל־","H5921","HR","Therefore","‘al-",0,9],["כֵּן","H3651","HTm",0,"kên"],["אוֹדְךָ","H3034","HVhi1cs/Sp2ms","I will praise You","’ō·wḏ·ḵā",10,27],["בַגּוֹיִם","H1471","HRd/Ncmpa","among the nations","ḇag·gō·w·yim",37,54],["יְהוָה","H3068","HNp","O LORD","Yah·weh",29,35],["וּלְשִׁמְךָ","H8034","HC/R/Ncmsc/Sp2ms","to Your name","ū·lə·šim·ḵā",76,88],["אֲזַמֵּֽרָה׃","H2167","HVph1cs","I will sing praises","’ă·zam·mê·rāh",56,75]]]]},"50":{"p":[["18:51",[["מַגְדִּל","H1431","HVhrmsa","Great","maḡ·dil",0,5],["יְשׁוּעוֹת","H3444","HNcfpc","salvation","yə·šū·‘ō·wṯ",6,15],["מַלְכּוֹ","H4428","HNcmsc/Sp3ms","{He brings to} His king","mal·kōw"],["וְעֹשֶׂה","H6213","HC/Vqrmsa","He shows","wə·‘ō·śeh",39,47],["חֶסֶד","H2617","HNcmsa","loving devotion","ḥe·seḏ",48,63],["לִמְשִׁיחוֹ","H4899","HR/Ncmsc/Sp3ms","to His anointed","lim·šî·ḥōw",64,79],["לְדָוִד","H1732","HR/Np","to David","lə·ḏā·wiḏ",81,89],["וּלְזַרְעוֹ","H2233","HC/R/Ncmsc/Sp3ms","and his descendants","ū·lə·zar·‘ōw",90,109],["עַד־","H5704","HR","forever","‘aḏ-",110,117],["עוֹלָֽם׃","H5769","HNcmsa",0,"‘ō·w·lām"]]]]}},"g":{"1":{"p":[["17:1","Εἰς τὸ τέλος τῷ παιδὶ Κυρίου τῷ Δαυὶδ, ἃ ἐλάλησε τῷ Κυρίῳ, τοὺς λόγους τῆς ᾠδῆς ταύτης, ἐν ἡμέρᾳ ᾗ ἐῤῥύσατο αὐτὸν Κύριος ἐκ χειρὸς πάντων τῶν ἐχθρῶν αὐτοῦ, καὶ ἐκ χειρὸς Σαοὺλ, καὶ εἶπεν,"],["17:2","Αγαπήσω σε, Κύριε ἰσχύς μου."]]},"2":{"p":[["17:3","Κύριος στερέωμά μου, καὶ καταφυγή μου, καὶ ῥύστης μου· ὁ Θεός μου βοηθός μου, ἐλπιῶ ἐπʼ αὐτόν· ὑπερασπιστής μου, καὶ κέρας σωτηρίας μου, καὶ ἀντιλήπτωρ μου."]]},"3":{"p":[["17:4","Αἰνῶν ἐπικαλέσομαι Κύριον, καὶ ἐκ τῶν ἐχθρῶν μου σωθήσομαι."]]},"4":{"p":[["17:5","Περιέσχον με ὠδῖνες θανάτου, καὶ χείμαῤῥοι ἀνομίας ἐξετάραξάν με."]]},"5":{"p":[["17:6","Ὠδῖνες ᾅδου περιεκύκλωσάν με, προέφθασάν με παγίδες θανάτου."]]},"6":{"p":[["17:7","Καὶ ἐν τῷ θλίβεσθαί με ἐπεκαλεσάμην τὸν Κύριον, καὶ πρὸς τὸν Θεόν μου ἐκέκραξα· ἤκουσεν ἐκ ναοῦ ἁγίου αὐτοῦ φωνῆς μου. καὶ ἡ κραυγή μου ἐνώπιον αὐτοῦ εἰσελεύσεται εἰς τὰ ὦτα αὐτοῦ."]]},"7":{"p":[["17:8","Καὶ ἐσαλεύθη, καὶ ἔντρόμος ἐγενήθη ἡ γῆ, καὶ τὰ θεμέλια τῶν ὀρέων ἐταράχθησαν, καὶ ἐσαλεύθησαν, ὅτι ὠργίσθη αὐτοῖς ὁ Θεός."]]},"8":{"p":[["17:9","Ἀνέβη καπνὸς ἐν ὀργῇ αὐτοῦ, καὶ πῦρ ἀπὸ προσώπου αὐτοῦ κατεφλόγισεν, ἄνθρακες ἀνήφθησαν ἀπʼ αὐτοῦ."]]},"9":{"p":[["17:10","Καὶ ἔκλινεν οὐρανὸν καὶ κατέβη, καὶ γνόφος ὑπὸ τοὺς πόδας αὐτοῦ."]]},"10":{"p":[["17:11","Καὶ ἐπέβη ἐπὶ χερουβὶμ καὶ ἐπετάσθη, ἐπετάσθη ἐπὶ πτερύγων ἀνέμων."]]},"11":{"p":[["17:12","Καὶ ἔθετο σκότος ἀποκρυφὴν αὐτοῦ, κύκλῳ αὐτοῦ ἡ σκηνὴ αὐτοῦ, σκοτεινὸν ὕδωρ ἐν νεφέλαις ἀέρων."]]},"12":{"p":[["17:13","Ἀπὸ τῆς τηλαυγήσεως ἐνώπιον αὐτοῦ αἱ νεφέλαι διῆλθον, χάλαζα καὶ ἄνθρακες πυρός."]]},"13":{"p":[["17:14","Καὶ ἐβρόντησεν ἐξ οὐρανοῦ Κύριος, καὶ ὁ ὕψιστος ἔδωκε φωνὴν αὐτοῦ."]]},"14":{"p":[["17:15","Καὶ ἐξαπέστειλε βέλη καὶ ἐσκόρπισεν αὐτοὺς, καὶ ἀστραπὰς ἐπλήθυνε καὶ συνετάραξεν αὐτούς."]]},"15":{"p":[["17:16","Καὶ ὤφθησαν αἱ πηγαὶ τῶν ὑδάτων, καὶ ἀνεκαλύφθη τὰ θεμέλια τῆς οἰκουμένης· ἀπὸ ἐπιτιμήσεώς σου Κύριε, ἀπὸ ἐνπνεύσεως πνεύματος ὀργῆς σου."]]},"16":{"p":[["17:17","Ἐξαπέστειλεν ἐξ ὕψους καὶ ἔλαβέ με, προσελάβετό με ἐξ ὑδάτων πολλῶν."]]},"17":{"p":[["17:18","Ῥύσεταί με ἐξ ἐχθρῶν μου δυνατῶν, καὶ ἐκ τῶν μισούντων με, ὅτι ἐστερεώθησαν ὑπὲρ ἐμέ."]]},"18":{"p":[["17:19","Προέφθασάν με ἐν ἡμέρᾳ κακώσεώς μου, καὶ ἐγένετο Κύριος ἀντιστήριγμά μου."]]},"19":{"p":[["17:20","Καὶ ἐξήγαγέ με εἰς πλατυσμὸν, ῥύσεταί με, ὅτι ἠθέλησέ με."]]},"20":{"p":[["17:21","Καὶ ἀνταποδώσει μοι Κύριος κατὰ τὴν δικαιοσύνην μου, καὶ κατὰ τὴν καθαριότητα τῶν χειρῶν μου ἀνταποδώσει μοι."]]},"21":{"p":[["17:22","Ὅτι ἐφύλαξα τὰς ὁδοὺς Κυρίου, καὶ οὐκ ἠσέβησα ἀπὸ τοῦ Θεοῦ μου."]]},"22":{"p":[["17:23","Ὅτι πάντα τὰ κρίματα αὐτοῦ ἐνώπιόν μου, καὶ τὰ δικαιώματα αὐτοῦ οὐκ ἀπέστησαν ἀπʼ ἐμοῦ."]]},"23":{"p":[["17:24","Καὶ ἔσομαι ἄμωμος μετʼ αὐτοῦ, καὶ φυλάξομαι ἀπὸ τῆς ἀνομίας μου."]]},"24":{"p":[["17:25","Καὶ ἀνταποδώσει μοι Κύριος κατὰ τὴν δικαιοσύνην μου, καὶ κατὰ τὴν καθαριότητα τῶν χειρῶν μου ἐνώπιον τῶν ὀφθαλμῶν αὐτοῦ."]]},"25":{"p":[["17:26","Μετὰ ὁσίου ὁσιωθήσῃ, καὶ μετὰ ἀνδρὸς ἀθώου ἀθῶος ἔσῃ·"]]},"26":{"p":[["17:27","Καὶ μετὰ ἐκλεκτοῦ ἐκλεκτὸς ἔσῃ, καὶ μετὰ στρεβλοῦ διαστρέψεις."]]},"27":{"p":[["17:28","Ὅτι σὺ λαὸν ταπεινὸν σώσεις, καὶ ὀφθαλμοὺς ὑπερηφάνων ταπεινώσεις."]]},"28":{"p":[["17:29","Ὅτι σὺ φωτιεῖς λύχνον μου Κύριε, ὁ Θεός μου φωτιεῖς τὸ σκότος μου."]]},"29":{"p":[["17:30","Ὅτι ἐν σοὶ ῥυσθήσομαι ἀπὸ πειρατηρίου, καὶ ἐν τῷ Θεῷ μου ὑπερβήσομαι τεῖχος."]]},"30":{"p":[["17:31","Ὁ Θεός μου, ἄμωμος ἡ ὁδὸς αὐτοῦ, τὰ λόγια Κυρίου πεπυρωμένα, ὑπερασπιστής ἐστι πάντων τῶν ἐλπιζόντων ἐπʼ αὐτόν."]]},"31":{"p":[["17:32","Ὅτι τίς Θεὸς πλὴν τοῦ Κυρίου; καὶ τίς Θεὸς πλὴν τοῦ Θεοῦ ἡμῶν;"]]},"32":{"p":[["17:33","Ὁ Θεὸς ὁ περιζωννύων με δύναμιν, καὶ ἔθετο ἄμωμον τὴν ὁδόν μου·"]]},"33":{"p":[["17:34","ὁ καταρτιζόμενος τοὺς πόδας μου ὡσεὶ ἐλάφου, καὶ ἐπὶ τὰ ὑψηλὰ ἱστῶν με·"]]},"34":{"p":[["17:35","Διδάσκων χεῖράς μου εἰς πόλεμον· καὶ ἔθου τόξον χαλκοῦν τοὺς βραχίονάς μου,"]]},"35":{"p":[["17:36","καὶ ἔδωκάς με ὑπερασπισμὸν σωτηρίας μου· καὶ ἡ δεξιά σου ἀντελάβετό μου, καὶ ἡ παιδεία σου ἀνώρθωσέ με εἰς τέλος, καὶ ἡ παιδεία σου αὐτή με διδάξει."]]},"36":{"p":[["17:37","Ἐπλάτυνας τὰ διαβήματά μου ὑποκάτω μου, καὶ οὐκ ἠσθένησαν τὰ ἴχνη μου."]]},"37":{"p":[["17:38","Καταδιώξω τοὺς ἐχθρούς μου, καὶ καταλήψομαι αὐτοὺς, καὶ οὐκ ἀποστραφήσομαι, ἕως ἂν ἐκλείπωσιν."]]},"38":{"p":[["17:39","Ἐκθλίψω αὐτοὺς, καὶ οὐ μὴ δύνωνται στῆναι, πεσοῦνται ὑπὸ τοὺς πόδας μου."]]},"39":{"p":[["17:40","Καὶ περιέζωσάς με δύναμιν εἰς πόλεμον, συνεπόδισας πάντας τοὺς ἐπανισταένους ἐπʼ ἐμὲ ὑποκάτω μου."]]},"40":{"p":[["17:41","Καὶ τοὺς ἐχθρούς μου ἔδωκάς μοι νῶτον, καὶ τοὺς μισοῦντάς με ἐξωλόθρευσας."]]},"41":{"p":[["17:42","Ἐκέκραξαν, καὶ οὐκ ἦν ὁ σώζων· πρὸς Κύριον, καὶ οὐκ εἰσήκουεν αὐτῶν."]]},"42":{"p":[["17:43","Καὶ λεπτυνῶ αὐτοὺς ὡς χοῦν κατὰ πρόσωπον ἀνέμου, ὡς πηλὸν πλατειῶν λεανῶ αὐτούς."]]},"43":{"p":[["17:44","Ῥῦσαί με ἐξ ἀντιλογιῶν λαοῦ, καταστήσεις με εἰς κεφαλὴν ἐθνῶν· λαὸς ὃν οὐκ ἔγνων, ἐδούλευσέ μοι,"]]},"44":{"p":[["17:45","εἰς ἀκοὴν ὠτίου ὑπήκουσέ μοι· υἱοὶ ἀλλότριοι ἐψεύσαντό μοι,"]]},"45":{"p":[["17:46","υἱοὶ ἀλλότριοι ἐπαλαιώθησαν, καὶ ἐχώλαναν ἀπὸ τῶν τρίβων αὐτῶν."]]},"46":{"p":[["17:47","Ζῇ Κύριος, καὶ εὐλογητὸς ὁ Θεός μου, καὶ ὑψωθήτω ὁ Θεὸς τῆς σωτηρίας μου."]]},"47":{"p":[["17:48","Ὁ Θεὸς ὁ διδοὺς ἐκδικήσεις ἐμοὶ, καὶ ὑποτάξας λαοὺς ὑπʼ ἐμὲ,"]]},"48":{"p":[["17:49","ὁ ῥύστης μου ἐξ ἐχθρῶν ὀργίλων· ἀπὸ τῶν ἐπανισταμένων ἐπʼ ἐμὲ ὑψώσεις με, ἀπὸ ἀνδρὸς ἀδίκου ῥύσῃ με."]]},"49":{"p":[["17:50","Διὰ τοῦτο ἐξομολογήσομαί σοι ἐν ἔθνεσι, Κύριε, καὶ τῷ ὀνόματί σου ψαλῶ."]]},"50":{"p":[["17:51","Μεγαλύνων τὰς σωτηρίας τοῦ βασιλέως αὐτοῦ, καὶ ποιῶν ἔλεος τῷ χριστῷ αὐτοῦ τῷ Δαυὶδ, καὶ τῷ σπέρματι αὐτοῦ ἕως αἰῶνος."]]}}}