,"HC","For","kî",0,3],["שָׁחָה","H7743",0,"has sunk","šā·ḥāh",13,21],["לֶעָפָר","H6083","HRd/Ncmsa","to the dust","le·‘ā·p̄ār",22,33],["נַפְשֵׁנוּ","H5315","HNcbsc/Sp1cp","our soul","nap̄·šê·nū",4,12],["דָּבְקָה","H1692","HVqp3fs","cling","dā·ḇə·qāh",46,51],["לָאָרֶץ","H776","HRd/Ncbsa","to the earth","lā·’ā·reṣ",52,64],["בִּטְנֵֽנוּ׃","H990","HNcfsc/Sp1cp","our bodies","biṭ·nê·nū",35,45]]]]},"26":{"p":[["44:27",[["קוּמָֽה","H6965","HVqv2ms/Sh","Rise up","qū·māh",0,7],["עֶזְרָתָה","H5833","HNcfsc/Sh","be our help","‘ez·rā·ṯāh",9,20],["לָּנוּ",0,0,0,"lā·nū"],["וּפְדֵנוּ","H6299","HC/Vqv2ms/Sp1cp","Redeem us","ū·p̄ə·ḏê·nū",22,31],["לְמַעַן","H4616","HR","on account of","lə·ma·‘an",32,45],["חַסְדֶּֽךָ׃","H2617","HNcmsc/Sp2ms","Your loving devotion","ḥas·de·ḵā",46,66]]]]}},"g":{"1":{"p":[["43:1","Εἰς τὸ τέλος, τοῖς υἱοῖς Κορὲ εἰς σύνεσιν ψαλμός."],["43:2","Ὁ Θεὸς ἐν τοῖς ὠσὶν ἡμῶν ἠκούσαμεν, οἱ πατέρες ἡμῶν ἀνήγγειλαν ἡμῖν, ἔργον ὃ εἰργάσω ἐν ταῖς ἡμέραις αὐτῶν, ἐν ἡμεραίς ἀρχαίαις."]]},"2":{"p":[["43:3","Ἡ χείρ σου ἔθνη ἐξωλόθρευσε, καὶ κατεφύτευσας αὐτοὺς, ἐκάκωσας λαοὺς καὶ ἐξέβαλες αὐτούς."]]},"3":{"p":[["43:4","Οὐ γὰρ ἐν τῇ ῥομφαίᾳ αὐτῶν ἐκληρονόμησαν γῆν, καὶ ὁ βραχίων αὐτῶν οὐκ ἔσωσεν αὐτοὺς, ἀλλὰ ἡ δεξιά σου καὶ ὁ βραχίων σου, καὶ ὁ φωτισμὸς τοῦ προσώπου σου, ὅτι εὐδόκησας ἐν αὐτοῖς."]]},"4":{"p":[["43:5","Σὺ εἶ αὐτὸς ὁ βασιλεύς μου καὶ ὁ Θεός μου, ὁ ἐντελλόμενος τὰς σωτηρίας Ἰακώβ."]]},"5":{"p":[["43:6","Ἐν σοὶ τοὺς ἐχθροὺς ἡμῶν κερατιοῦμεν, καὶ ἐν τῷ ὀνόματί σου ἐξουθενώσομεν τοὺς ἐπανισταμένους ἡμῖν."]]},"6":{"p":[["43:7","Οὐ γὰρ ἐπὶ τῷ τόξῳ μου ἐλπιῶ, καὶ ἡ ῥομφαία μου οὐ σώσει με."]]},"7":{"p":[["43:8","Ἔσωσας γὰρ ἡμᾶς ἐκ τῶν θλιβόντων ἡμᾶς, καὶ τοὺς μισοῦντας ἡμᾶς κατῄσχυνας."]]},"8":{"p":[["43:9","Ἐν τῷ Θεῷ ἐπαινεθησόμεθα ὅλην τὴν ἡμέραν, καὶ ἐν τῷ ὀνόματί σου ἐξομολογησόμεθα εἰς τὸν αἰῶνα. διάψαλμα."]]},"9":{"p":[["43:10","Νυνὶ δὲ ἀπώσω καὶ κατῄσχυνας ἡμᾶς, καὶ οὐκ ἐξελεύσῃ ἐν ταῖς δυνάμεσιν ἡμῶν."]]},"10":{"p":[["43:11","Ἀπέστρεψας ἡμᾶς εἰς τὰ ὀπίσω παρὰ τοὺς ἐχθροὺς ἡμῶν, καὶ οἱ μισοῦντες ἡμᾶς διήρπαζον ἑαυτοῖς."]]},"11":{"p":[["43:12","Ἔδωκας ἡμᾶς ὡς πρόβατα βρώσεως, καὶ ἐν τοῖς ἔθνεσι διέσπειρας ἡμᾶς·"]]},"12":{"p":[["43:13","Ἀπέδου τὸν λαόν σου ἄνευ τιμῆς, καὶ οὐκ ἦν πλῆθος ἐν τοῖς ἀλαλάγμασιν αὐτῶν."]]},"13":{"p":[["43:14","Ἔθου ἡμᾶς ὄνειδος τοῖς γείτοσιν ἡμῶν, μυκτηρισμὸν καὶ καταγέλωτα τοῖς κύκλῳ ἡμῶν."]]},"14":{"p":[["43:15","Ἔθου ἡμᾶς εἰς παραβολὴν ἐν τοῖς ἔθνεσι, κίνησιν κεφαλῆς ἐν τοῖς λαοῖς."]]},"15":{"p":[["43:16","Ὅλην τὴν ἡμέραν ἡ ἐντροπή μου κατεναντίον μου ἐστὶ, καὶ ἡ αἰσχύνη τοῦ προσώπου μου ἐκάλυψέ με,"]]},"16":{"p":[["43:17","ἀπὸ φωνῆς ὀνειδίζοντος καὶ παραλαλοῦντος, ἀπὸ προσώπου ἐχθροῦ καὶ ἐκδιώκοντος."]]},"17":{"p":[["43:18","Ταῦτα πάντα ἦλθεν ἐφʼ ἡμᾶς, καὶ οὐκ ἐπελαθόμεθά σου, καὶ οὐκ ἠδικήσαμεν ἐν διαθήκῃ σου."]]},"18":{"p":[["43:19","Καὶ οὐκ ἀπέστη εἰς τὰ ὀπίσω ἡ καρδία ἡμῶν, καὶ ἐξέκλινας τὰς τρίβους ἡμῶν ἀπὸ τῆς ὁδοῦ σου."]]},"19":{"p":[["43:20","Ὅτι ἐταπείνωσας ἡμᾶς ἐν τόπῳ κακώσεως, καὶ ἐπεκάλυψεν ἡμᾶς σκιὰ θανάτου."]]},"20":{"p":[["43:21","Εἰ ἐπελαθόμεθα τοῦ ὀνόματος τοῦ Θεοῦ ἡμῶν, καὶ εἰ διεπετάσαμεν χεῖρας ἡμῶν πρὸς θεὸν ἀλλότριον,"]]},"21":{"p":[["43:22","οὐχὶ ὁ Θεὸς ἐκζητήσει ταῦτα; αὐτὸς γὰρ γινώσκει τὰ κρύφια τῆς καρδίας."]]},"22":{"p":[["43:23","Ὅτι ἕνεκά σου θανατούμεθα ὅλην τὴν ἡμέραν, ἐλογίσθημεν ὡς πρόβατα σφαγῆς."]]},"23":{"p":[["43:24","Ἐξεγέρθητι, ἱνατί ὑπνοῖς Κύριε; ἀνάστηθι, καὶ μὴ ἀπώσῃ εἰς τέλος."]]},"24":{"p":[["43:25","Ἱνατί τὸ πρόσωπόν σου ἀποστρέφεις; ἐπιλανθάνῃ τῆς πτωχείας ἡμῶν καὶ τῆς θλίψεως ἡμῶν;"]]},"25":{"p":[["43:26","Ὅτι ἐταπεινώθη εἰς χοῦν ἡ ψυχὴ ἡμῶν, ἐκολλήθη εἰς γῆν ἡ γαστὴρ ἡμῶν."]]},"26":{"p":[["43:27","Ἀνάστα Κύριε, βοήθησον ἡμῖν, καὶ λύτρωσαι ἡμᾶς ἕνεκεν τοῦ ὀνόματός σου."]]}}}