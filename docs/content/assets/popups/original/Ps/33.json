7":{"p":[["32:7","Συνάγων ὡσεὶ ἀσκὸν ὕδατα θαλάσσης, τιθεὶς ἐν θησαυροῖς ἀβύσσους."]]},"8":{"p":[["32:8","Φόβηθήτω τὸν Κύριον πᾶσα ἡ γῆ, ἀπʼ αὐτοῦ δὲ σαλευθήτωσαν πάντες οἱ κατοικοῦντες τὴν οἰκουμένην."]]},"9":{"p":[["32:9","Ὅτι αὐτὸς εἶπε καὶ ἐγενήθησαν, αὐτὸς ἐνετείλατο καὶ ἐκτίσθησαν."]]},"10":{"p":[["32:10","Κύριος διασκεδάζει βουλὰς ἐθνῶν, ἀθετεῖ δὲ λογισμοὺς λαῶν, καὶ ἀθετεῖ βουλὰς ἀρχόντων."]]},"11":{"p":[["32:11","Ἡ δὲ βουλὴ τοῦ Κυρίου εἰς τὸν αἰῶνα μένει, λογισμοὶ τῆς καρδίας αὐτοῦ ἀπὸ γενεῶν εἰς γενεάς."]]},"12":{"p":[["32:12","Μακάριον τὸ ἔθνος οὗ ἐστι Κύριος ὁ Θεὸς αὐτοῦ, λαὸς ὃν ἐξελέξατο εἰς κληρονομίαν ἑαυτῷ."]]},"13":{"p":[["32:13","Ἐξ οὐρανοῦ ἐπέβλεψεν ὁ Κύριος, εἶδε πάντας τοὺς υἱοὺς τῶν ἀνθρώπων."]]},"14":{"p":[["32:14","Ἐξ ἑτοίμου κατοικητηρίου αὐτοῦ ἐπέβλεψεν ἐπὶ πάντας τοὺς κατοικοῦντας τὴν γῆν."]]},"15":{"p":[["32:15","Ὁ πλάσας κατὰ μόνας τὰς καρδίας αὐτῶν, ὁ συνιεὶς πάντα τὰ ἔργα αὐτῶν."]]},"16":{"p":[["32:16","Οὐ σώζεται βασιλεὺς διὰ πολλὴν δύναμιν, καὶ γίγας οὐ σωθήσεται ἐν πλήθει ἰσχύος αὐτοῦ."]]},"17":{"p":[["32:17","Ψευδὴς ἵππος εἰς σωτηρίαν, ἐν δὲ πλήθει δυνάμεως αὐτοῦ οὐ σωθήσεται."]]},"18":{"p":[["32:18","Ἰδοὺ οἱ ὀφθαλμοὶ Κυρίου ἐπὶ τοὺς φοβουμένους αὐτὸν, τοὺς ἐλπίζοντας ἐπὶ τὸ ἔλεος αὐτοῦ,"]]},"19":{"p":[["32:19","ῥύσασθαι ἐκ θανάτου τὰς ψυχὰς αὐτῶν, καὶ διαθρέψαι αὐτοὺς ἐν λιμῷ."]]},"20":{"p":[["32:20","Ἡ ψυχὴ ἡμῶν ὑπομένει τῷ Κυρίῳ, ὅτι βοηθὸς καὶ ὑπερασπιστὴς ἡμῶν ἐστιν."]]},"21":{"p":[["32:21","Ὅτι ἐν αὐτῷ εὐφρανθήσεται ἡ καρδία ἡμῶν, καὶ ἐν τῷ ὀνόματι τῷ ἁγίῳ αὐτοῦ ἠλπίσαμεν."]]},"22":{"p":[["32:22","Γένοιτο τὸ ἔλεός σου, Κύριε, ἐφʼ ἡμᾶς, καθάπερ ἠλπίσαμεν ἐπὶ σέ."]]}}}