ֶם כִּי גַם־לָכֶם אָדוֹן בַּשָּׁמָיִם׃","2":"הִתְעוֹרְרוּ לִהִתְפַּלֵּל תָּמִיד וְשִׁקְדוּ לְהַעְתִּיר בְּתוֹדָה׃","3":"וְחַלּוּ אֶת־פְּנֵי הָאֱלֹהִים גַּם־בַּעֲדֵנוּ לִפְתֹּחַ לָנוּ שַׁעַר לְנִיב שְׂפָתֵינוּ לְגַלּוֹת סוֹד הַמָּשִׁיחַ אֲשֶׁר בִּגְלָלוֹ אָסוּר אָנִי׃","4":"לְמַעַן יִוָּדַע לַכֹּל כַּאֲשֶׁר אַבִּיעַ כַּמִּשְׁפָּט׃","5":"הִתִהַלְּכוּ בִתְבוּנָה בְּקֶרֶב אֵלֶּה אֲשֶׁר מִחוּץ לַעֲדָתֵנוּ וּזְבַנוּ יַת־עִדָּנָא׃","6":"יְהִי דְבַרְכֶם מָהוּל בְּחֵן כְּמוֹ מְמֻלָּח בַּמֶּלַח וְתֵדְעוּ לְהָשִׁיב נְכֹחוֹת לְכָל־אִישׁ וָאִישׁ׃","7":"עַל־דְּבַר מַעֲמָדִי הֲלֹא טוּכִיקוֹס יַגִּיד לָכֶם הַכֹּל הוּא אָח אָהוּב וּמְשָׁרֵת נֶאֱמָן גֶּבֶר עֲמִיתִי וְעֶבֶד לַאֲדֹנֵינוּ׃","8":"כִּי לַדָּבָר הַזֶּה שְׁלַחְתִּיו אֲלֵיכֶם לָדַעַת אֶת־שְׁלוֹמֵנוּ וּלְדַבֵּר נִחֻמִים עַל־לִבְּכֶם׃","9":"וְעִמּוֹ גַּם־אוֹנִיסִימוֹס בֶּן־אַרְצְכֶם אָח נֶאֱמָן וְיַקִּיר לִי הֵמָּה יוֹדִיעוּ אֶתְכֶם כָּל־אֲשֶׁר נַעֲשָׂה פֹּה׃","10":"אֲרִיסְטַרְכוֹס אֲשֶׁר הוּא עָצוּר עִמָּדִי שֹׁאֵל לִשְׁלוֹמְכֶם גַּם־מַרְקוֹס בֶּן־אֲחוֹת בַּר־נַבָּא אֲשֶׁר נִדְרַשְׁתֶּם לְקַבֵּל פָּנָיו בְּבוֹאוֹ׃","11":"וְגַם־יֵשׁוּעַ הַנִּקְרָא בְשֵׁם יוּסְטוֹס אֲשֶׁר הֵם מִן־הַנִּמּוֹלִים הֵם לְבַדָּם תָּמְכוּ בְיָדִי בְּמַלְכוּת הָאֱלֹהִים וַיָּשִׁיבוּ אֶת־נַפְשִׁי׃","12":"אֶפַּפְרָס בֶּן־אַרְצְכֶם וְעֶבֶד יֵשׁוּעַ הַמָּשִׁיחַ שֹׁאֵל לִשְׁלוֹמְכֶם הוּא אֲשֶׁר גָּבַר בִּתְפִלּוֹתָיו בְּכָל־עֵת לְהַעֲמִידְכֶם לִפְנֵי הָאֱלֹהִים שְׁלֵמִים וּמְמֻלָּאִים בִּמְלֹא חֶפְצוֹ׃","13":"כִּי עֵד אֲנִי לוֹ אֲשֶׁר קִנְאָתוֹ גָדְלָה לָכֶם וּלְיֹשְׁבֵי לוּדְקְיָא וּלְיֹשְׁבֵי הִירַפּוֹלִיס׃","14":"יְדִידֵנוּ לוּקָס הָרֹפֵא וְדִימָס שֹׁאֲלִים לִשְׁלוֹמְכֶם׃","15":"שַׁאֲלוּ לִשְׁלוֹם אַחֵינוּ אֲשֶׁר בְּלוּדְקְיָא וְלִשְׁלוֹם נוּמְפָס וְהַקָּהָל אֲשֶׁר בְּבֵיתָם׃","16":"אַחֲרֵי קְרִיאַת הָאִגֶּרֶת הַזֹּאת בְּאָזְנֵיכֶם תְּנוּהָ לְהִקָּרֵא גַּם־בְּאָזְנֵי קְהַל לוּדְקְיָא וְהָאִגֶּרֶת אֲשֶׁר לְלוּדְקְיָא תִּקְרְאוּ בָהּ גַּם־אַתֶּם׃","17":"וְאִמְרוּ אֶל־אַרְכִפּוֹס זָכוֹר אֶת־מִשְׁמֶרֶת הַכְּהֻנָּה אֲשֶׁר לָקַחְתָּ מִלִּפְנֵי הָאָדוֹן לְמַלֹּאתָהּ׃","18":"זֹאת שְׁאֵלַת שָׁלוֹם בִּכְתָב יָדִי אֲנִי פוֹלוֹס זִכְרוּ לְמוֹסֵרָי וְחֶסֶד אֵל עִמָּכֶם אָמֵן׃"}}