4":"אִם תִּקְרְאוּ דְבָרַי תּוּכְלוּ לְהַכִּיר כְּי הַדַּעַת אִתִּי בְּסוֹד הַמָּשִׁיחַ׃","5":"אֲשֶׁר לֹא נוֹדַע לִבְנֵי אָדָם בְּדֹרוֹת מִקֶּדֶם כַּאֲשֶׁר נִגְלָה כַיּוֹם לִשְׁלִיחָיו הַקְּדֹשִׁים וְלִנְבִיאָיו עַל־פִּי הָרוּחַ׃","6":"כִּי יִקְחוּ הַגּוֹיִם חֵלֶק גַּם־הֵם בְּנַחֲלָתוֹ לִהְיוֹת כְּאֵבָרִים בִּגְוִיָּתוֹ וַחֲבֵרִים לִפְנֵי יֵשׁוּעַ הַמָּשִׁיחַ לְקַבֵּל הַבְטָחָתוֹ עַל־פִּי הַבְּשׂרָה׃","7":"אֲשֶׁר הָיִיתִי לָהּ לִמְשָׁרֵת בְּמַתְּנַת חֶסֶד אֱלֹהִים אֲשֶׁר נָתַן לִי לְפִי פְּעֻלַּת גְּבוּרָתוֹ׃","8":"אֲנִי הַצָּעִיר בַּצְּעִירִים בֵּין הַקְּדוֹשִׁים נָתוּן לִי הַחֶסֶד הַזֶּה לְבַשֵּׂר אֶל־הַגּוֹיִם חֹסֶן הַמָּשִׁיחַ כִּי־רַב הוּא לְאֵין חֵקֶר׃","9":"וּלְהָאִיר עֵינֵי־כֹל לָדַעַת עֵרֶךְ הַסּוֹד אֲשֶׁר צָפוּן הָיָה מֵעוֹלָם בֵּאלֹהִים יוֹצֵר הַכֹּל עַל־יְדֵי יֵשׁוּעַ הַמָּשִׁיחַ׃","10":"וּבָזֹאת יִוָּדַע עַל־פִּי הָעֵדָה לְרָאשֵׁי הַצָּבָא וּלְגִבֹּרֵי כֹחַ בַּמָּרוֹם נִפְלְאוֹת חָכְמַת אֱלֹהִים׃","11":"כָּעֵצָה אֲשֶׁר יָעַץ מִקֶּדֶם בְּיֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","12":"אֲשֶׁר בּוֹ נוֹסִיף אֹמֶץ לָגֶשֶׁת אֵלָיו בֶּאֱמוּנָתוֹ בְּלֵב נָכוֹן׃","13":"עַל־כֵּן זֹאת אֲנִי מְבַקֵּשׁ אַל־נָא תִּתְעַטְּפוּ בְצָרוֹתַי אֲשֶׁר אֲפָפוּנִי לְמַעַנְכֶם כִּי זֹאת הִיא תִּפְאַרְתְּכֶם׃","14":"עַל־כֵּן אֶכְרְעָה עַל בִּרְכָּי לִפְנֵי אָבִי אֲדוֹנֵינוּ יֵשׁוּעַ הַמָּשִׁיחַ׃","15":"אֲשֶׁר נִקְרָא שְׁמוֹ עַל כָּל־צִבְאוֹתָיו בַּשָּׁמַיִם וּבָאָרֶץ׃","16":"וְהוּא יִתֵּן לָכֶם כְּפִי־חֹסֶן כְּבוֹדוֹ לְהִתְאַזֵּר בִּגְבוּרָה עַל־פִּי רוּחוֹ בָּאָדָם הַפְּנִימִי׃","17":"וְהַמָּשִׁיחַ יִשְׁכֹּן בְּקֶרֶב לִבְּכֶם בֶּאֱמוּנָה כִּי תַשְׁרִישׁוּ וְתִוָּסְדוּ בְּאַהֲבָה׃","18":"אָז תּוּכְלוּ לְהַשְׂכִּיל עִם כָּל־הַקְּדוֹשִׁים מַה־הוּא הָרֹחַב וְהָאֹרֶךְ וְהַגֹּבַה וְהָעֹמֶק׃","19":"וּלְהִתְבּוֹנֵן בְּאַהֲבַת הַמָּשִׁיחַ אֲשֶׁר מִדַּעַת נִשְׂגָּבָה עַד־אֲשֶׁר תִּמָּלְאוּ מִכָּל־מְלֹא הָאֱלֹהִים׃","20":"וְהוּא אֲשֶׁר יָדָיו רַב לוֹ לְעוֹרֵר בַּכֹּחַ לִבֵּנוּ וְלַעֲשׂוֹת לָנוּ יֶתֶר עַל־כָּל־מִשְׁאֲלוֹתֵינוּ וּמַחְשְׁבוֹתֵינוּ׃","21":"לוֹ הוּא הַכָּבוֹד בְּתוֹךְ הָעֵדָה וּבְיֵשׁוּעַ הַמָּשִׁיחַ מִדּוֹר לְדוֹר וּמֵהָעוֹלָם וְעַד־הָעוֹלָם אָמֵן׃"}}