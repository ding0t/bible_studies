כֶם׃","7":"אַךְ לְאִישׁ אִישׁ מִמֶּנּוּ חֻלַּק מְנָת חָסֶד כְּמִדַּת מַתְּנַת הַמָּשִׁיחַ׃","8":"עַל־כֵּן הוּא אֹמֵר עָלָה לַמָּרוֹם שָׁבָה שֶׁבִי וַיִּתֵּן מַתָּנוֹת לָאָדָם׃","9":"וְכִי נֹאמַר כִּי־עָלָה אֵין זֶה כִּי אִם־יָרַד בָּרִאשֹׁנָה לְתַחְתִּיּוֹת אָרֶץ׃","10":"הַיֹּרֵד הוּא הָעֹלֶה לְמַעְלָה מִכָּל־שְׁמֵי מָרוֹם לְמַלֵּא אֶת־הַכֹּל׃","11":"וְהוּא נָתַן אֶת־אֵלֶּה לִהְיוֹת שְׁלִיחִים וְאֶת־אֵלֶּה נְבִיאִים וְאֶת־אֵלֶּה מְבַשְּׂרִים וְאֶת־אֵלֶּה רֹעִים וּמוֹרִים׃","12":"לְהַשְׁלִים אֶת־הַקְּדֹשִׁים לִמְלֶאכֶת עֲבֹדַת הַקֹּדֶשׁ לְמַעַן יִבָּנֶה גּוּף הַמָּשִׁיחַ׃","13":"עַד אֲשֶׁר כֻּלָּנוּ נָבוֹא לְיַחֵד לְבָבֵנוּ בֶּאֱמוּנָה אַחַת וּבְדַעַת בֶּן־הָאֱלֹהִים וְהָיִינוּ לְאָדָם שָׁלֵם בַּמִּדָּה כִּמְלֹא קוֹמַת הַמָשִׁיחַ׃","14":"לְבִלְתִּי נִהְיֶה עוֹד עוֹלֲלִים נִדָּפִים וְנִגְרָשִׁים מִפְּנֵי כָל־רוּחַ בְּתוֹרַת אֲנָשִׁים וְתַרְמִיתָם אֲשֶׁר בְּנִכְלֵיהֶם יָצוּדוּ חֵרֶם׃","15":"כִּי אִם־נַחֲזִיק בָּאֱמֶת מֵאַהֲבָה וְהָלַכְנוּ הָלוֹךְ וְגָדוֹל לִפְנֵי הַמָּשִׁיחַ אֲשֶׁר הוּא הָרֹאשׁ׃","16":"וּבוֹ מֻדְבָּק וּמְקֻשָּׁר כָּל־הַגּוּף עִם כָּל־פרקיו וַחֲלָקָיו אֶל־נָכוֹן אֲשֶׁר בְּאַהֲבָה יַעַבְדוּן לְהַגְדִּילוֹ וּלְהַאֲדִירוֹ כְּדֵי כֹחָם׃","17":"וְעַתָּה הַעִדֹתִי בָכֶם לִפְנֵי הָאָדוֹן לֵאמֹר אַל־תֵּלְכוּ כְּיֶתֶר הַגּוֹיִם אֲשֶׁר אַחֲרֵי הַבְלֵי שָׁוְא לִבָּם הֹלֵךְ׃","18":"מְאוֹר דַּעְתָּם חָשַׁךְ וְחַיֵּי אֱלֹהִים מוּזָרִים לָהֶם עֵקֶב אֲשֶׁר הִקְשׁוּ רוּחָם בְּאִוַּלְתָּם׃","19":"הֵם אֲשֶׁר טָפַשׁ לִבָּם וַיִּתְמַכְּרוּ לַעֲשׂוֹת כָּל־נְבָלָה וְתוֹעֵבָה וְלֹא יֵדְעוּ שָׂבְעָה׃","20":"וְאַתֶּם לֹא כָזֹאת לְמַדְתֶּם דַּרְכֵי הַמָּשִׁיח׃","21":"אִם רַק מַקְשִׁיבִים הֱיִיתֶם לְקוֹלוֹ וְלִמּוּדֵי דְבָרוֹ אַתֶּם כִּי הֵם אֱמֶת בִּפְנֵי יֵשׁוּעַ׃","22":"וְעֵן עֲזַבְתֶּם דַּרְכֵיכֶם הָרִאשֹׁנִים עַד־לְהָסִיר מֵעֲלֵיכֶם אֶת־הָאָדָם הַקַּדְמֹנִי הַנִּשְׁחָת וְהַנִּתְעֶה בְּתַאֲוָתוֹ׃","23":"לְהִתְחַדֵּשׁ בְּרוּחַ חֲדָשָׁה בְּקֶרֶב לִבְּכֶם׃","24":"וְלִלְבּשׁ אֶת־הָאָדָם הֶחָדָשׁ הַנִּבְרָא בְצֶדֶק וּבְקֹדֶשׁ בֶּאֱמֶת כְּלֵב הָאֱלֹהִים׃","25":"עַל־כֵּן הַרְחִיקוּ שֶׁקֶר מִכֶּם וְדַבְּרוּ אֱמֶת אִישׁ אֶת־רֵעוֹ כִּי אֵבָרִים אֲנַחְנוּ אִישׁ לְאָחִיו׃","26":"רִגְזוּ וְאַל־תֶּחֱטָאוּ וְלֹא תָבוֹא הַשֶּׁמֶשׁ בְּעוֹד רֹגֶז בְּאַפְּכֶם׃","27":"פֶּן־תִּתְּנוּ מָקוֹם לַשָּׂטָן׃","28":"מִי שֶׁגָּנַב אַל־יֹסֵף לִגְנֹב עוֹד כִּי אִם־יַעֲמֹל לַעֲשׂוֹת טוֹב בְּיָדָיו לִהְיוֹת לוֹ לָתֵת לָאֶבְיוֹן׃","29":"כָּל־דְּבַר בְּלִיַּעַל לֹא־יֵצֵא מִפִּיכֶם כִּי אִם־דְּבָרִים טוֹבִים וּנְכֹחִים לְהָשִׁיב נֶפֶשׁ וְלָתֶת־חֵן לְשֹׁמְעֵיהֶם׃","30":"וְאַל־תְּעַצְּבוּ אֶת־רוּחַ הַקֹּדֶשׁ הוּא רוּחַ הָאֱלֹהִים אֲשֶׁר בּוֹ נֶחְתָּמִים אַתֶּם עַד יוֹם הַגְּאֻלָּה׃","31":"וְהַרְחִיקוּ מִכֶּם כָּל־מְרִירוּת לֵב וַחֲרוֹן אָף רֹגֶז וּתְלוּנָּה וּנְאָצָה עִם כָּל־דָּבָר רָע׃","32":"אֲבָל חֹנְנִים תִּהְיוּ זֶה לָזֶה מְרַחֲמִים וְסַלָּחִים אִישׁ לְאָחִיו כַּאֲשֶׁר גַּם־הָאֱלֹהִים סָלַח לָכֶם בַּמָּשִׁיחַ׃"}}