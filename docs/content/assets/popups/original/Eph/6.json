ִתְעוֹדְדוּ בַאֲדֹנֵינוּ וּבְעֹז גְּבוּרָתוֹ׃","11":"חִגְרוּ כְלֵי־נֶשֶׁק אֱלֹהִים לְמַעַן תּוּכְל לָקוּם לִפְנֵי נִכְלֵי הַשָּׂטָן׃","12":"כִּי לֹא עִם־בָּשָׂר וָדָם מִלְחָמָה לָנוּ אַךְ עִם־אַלּוּפִים וְאֵילִים שַׁלִּיטֵי אֶרֶץ מַאְפֵּלְיָה וּמַלְאֲכֵי רָעִים אֲשֶׁר בַּמְּרוֹמִים׃","13":"עַל־כֵּן קְחוּ לָכֶם כְּלֵי־נֶשֶׁק אֱלֹהִים וְתוּכְלוּ לְהִתְיַצֵּב בִּפְנֵי הַקָּמִים עֲלֵיכֶם בְּיוֹם רָע וּלְהִשָּׁאֵר נִצָּבִים בִּכְלוֹת כָּל־קְרָב׃","14":"עִמְדוּ־נָא מָתְנֵיכֶם חֲגוּרֵי אֱמֶת וְשִׁרְיוֹן צֶדֶק לְבוּשְׁכֶם׃","15":"וּפְעָמֵיכֶם יָפוֹת בַּנְּעָלִים לְבַשֵּׂר בְּשׂרַת הַשָּׁלוֹם׃","16":"וּבַכֹּל עִרְכוּ מָגֵן הָאֱמוּנָה אֲשֶׁר תּוּכְּלוּ לְכַבּוֹת בּוֹ חִצִּים לֹהֲטִים מִיַּד הַצָּר׃","17":"וְהִתְיַצְּבוּ בְכֹבַע הַיְשׁוּעָה וּבְחֶרֶב הָרוּחַ אֲשֶׁר הוּא דְּבַר הָאֱלֹהִים׃","18":"וְהִתְפַּלְּלוּ בְכָל־עֵת כָּל־תְּפִלָּה וּתְחִינָּה מִקֶּרֶב לֵב וָרוּחַ וְשֹׁקְדִים תִּהְיוּ לְהַעְתִּיר וּלְהִתְחַנֵּן בְּעַד כָּל־הַקְּדוֹשִׁים׃","19":"וְגַם־בְּעַד נַפְשִׁי כִּי יוּשַׂם דָּבָר בְּפִי וְעֹז כִּי־אֶפְתַּח שְׂפָתַי לְהַגִּיד סוֹד הַבְּשׁרָה׃","20":"הַבְּשׁרָה אֲשֶׁר אֲנִי מַלְאָכָהּ אָסוּר בִּכְבָלִים וּלְהִנָּתֶן־לִי לְמַלֵּל בְּיָד רָמָה כַּאֲשֶׁר נָכוֹן לִי׃","21":"אַךְ לְבַעֲבוּר תֵּדְעוּן מָה עִמָּדִי וְכָל־אֲשֶׁר אֲנִי עֹשֶׂה הִנֵּה טוּכִיקוֹס הָאָח הָאָהוּב וְהַמְשָׁרֵת הַנֶּאֱמָן לַאֲדֹנֵינוּ יַגִּיד לָכֶם כֹּל׃","22":"כִּי לַדָּבָר הַזֶּה שְׁלַחְתִּיו אֲלֵיכֶם לְהוֹדִיעֲכֶם מַה מַּעֲשֵׂינוּ וּלְנַחֵם אֶת־לִבְּכֶם׃","23":"שָׁלוֹם אַהֲבָה וֶאֱמוּנָה אֶל־הָאַחִים מֵאֵת אֱלֹהִים אָבִינוּ וּמֵאֵת יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","24":"חֶסֶד לְכָל־הָאֹהֵב אֶת־אֲדֹנֵינוּ יֵשׁוּעַ הַמָּשִׁיחַ בְּאַהֲבָה נִצָּחַת׃"},"q":{"10":[["Dan 4:30","4:30","ἀπεκρίθη ὁ βασιλεὺς, καὶ εἶπεν, οὐχ αὕτη ἐστὶ Βαβυλὼν ἡ μεγάλη, ἣν ἐγὼ ᾠκοδόμησα εἰς οἶκον βασιλείας, ἐν τῷ κράτει τῆς ἰσχύος μου, εἰς τιμὴν τῆς δόξης μου;",[17,18,19,20,21]],[null,null,null,[6,7,8,9,10]]]}}