ּצָה בְלִבּוֹ מִקֶּדֶם׃","10":"לְקַבֵּץ בַּמָּשִׁיחַ בִּמְלֹאת יְמֵי הַפְּקֻדָּה כֹּל אֲשֶׁר בַּשָּׁמַיִם וְכֹל אֲשֶׁר בָּאָרֶץ וְהָיוּ בוֹ לַאֲחָדִים׃","11":"וְגַם עַל־יָדוֹ נַחֲזִיק בַּמּוֹרָשָׁה כַּאֲשֶׁר נִבְחַרְנוּ לָהּ מֵאָז מִטַּעַם הָעֹשֶׂה כֹּל כַּעֲצַת חֶפְצוֹ׃","12":"לְמַעַן יֵרָאֶה עָלֵינוּ הֲדַר כְּבוֹדוֹ בִּהְיוֹת אֲנַחְנוּ הָרִאשֹׁנִים אֲשֶׁר בָּטַחְנוּ בַּמָּשִׁיחַ׃","13":"וּבוֹ בֹטְחִים גַּם־אַתֶּם אַחֲרֵי אֲשֶׁר שְׁמַעְתֶּם אֶת־דְּבַר הָאֱמֶת אֶת־דְּבַר הַבְּשׁרָה לִתְשׁוּעַתְכֶם וְכַאֲשֶׁר הֶאֱמַנְתֶּם בּוֹ כֵּן גַּם־נֶחְתָּמִים אַתֶּם בְּרוּחַ הַקֹּדֶשׁ כַּאֲשֶׁר דִּבֵּר׃","14":"אֲשֶׁר עֵרָבוֹן הוּא לְמוֹרָשָׁתֵנוּ עַד אֲשֶׁר־תִּגָּאֵל וְהָיְתָה־לָּנוּ לַאֲחֻזָּה לִתְהִלַּת שֵׁם כְּבוֹדוֹ׃","15":"וַאֲשֶׁר עַל־כֵּן גַּם־אָנֹכִי אַחֲרֵי שָׁמְעִי אֶת־אֱמוּנַתְכֶם בְּיֵשׁוּעַ אֲדֹנֵינוּ וְאַהֲבַתְכֶם לְכָל־הַקְּדוֹשִׁים׃","16":"לֹא חָדַלְתִּי מֵהוֹדוֹת בַּעַדְכֶם וּלְהַזְכִּירְכֶם בִּתְפִלּוֹתַי׃","17":"כִּי אֱלֹהֵי יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ אֲבִי הַכָּבוֹד יִתֵּן לָכֶם רוּחַ הַחָכְמָה וְהֶחָזוֹן לָדַעַת אֹתוֹ׃","18":"וּלְהָאִיר עֵינֵי שִׂכְלְכֶם לְהַשְׂכִּיל מָה הִיא תִקְוַת קְרוּאָיו וּמֶה חֹסֶן כָּבוֹד לִקְדשָׁיו בְּנַחֲלָתוֹ׃","19":"וּמָה עֹצֶם גֹּדֶל גְּבוּרָתוֹ אֲשֶׁר פָּעַל בָּנוּ הַמַּאֲמִינִים בּוֹ לְפִי תֹקֶף עֻזּוֹ׃","20":"הוּא אֲשֶׁר פָּעַל בַּמָּשִׁיחַ בַּאֲשֶׁר הֲקִימוֹ מִן־הַמֵּתִים וַיּוֹשִׁיבֵהוּ לִימִינוֹ בַּמָּרוֹם׃","21":"גָּבוֹהַּ מִכָּל־מִשְׂרָה וְשִׁלְטוֹן וּגְבוּרָה וּמֶמְשָׁלָה וּמִכָּל־אֲשֶׁר נִקְרָא בְשֵׁם גַּם־בָּעוֹלָם הַזֶּה וְגַם־בָּעוֹלָם הַבָּא׃","22":"וְכֹל שָׁת תַּחַת רַגְלָיו וַיִּתְּנֵהוּ לְרֹאשׁ לְכָל־הָעֵדָה׃","23":"אֲשֶׁר הִיא גְוִיָּתוֹ וּמְלֹאוֹ כִּי מָלֵא הוּא אֶת־כֹּל בַּכֹּל׃"}}