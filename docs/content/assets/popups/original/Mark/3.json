 כִּי מַר־לוֹ מְאֹד מִקְּשִׁי לִבָּם וַיֹּאמֶר אֶל־הָאִישׁ הַהוּא הוֹשֵׁט אֶת־יָדֶךָ וַיֹּשֶׁט אֹתָהּ וַתָּשָׁב יָדוֹ לְאֵיתָנָהּ כָּאַחֶרֶת׃","6":"וְהַפְּרוּשִׁים יָצְאוּ וַיָּחִישׁוּ לְהִוָּעֵץ עִם־אַנְשֵׁי הוֹרְדוֹס בַּמֶּה לְהַשְׁחִיתוֹ׃","7":"וַיִּפֶן יֵשׁוּעַ וַיַּעֲבֹר מִשָּׁם עִם־תַּלְמִידָיו דֶּרֶךְ הַיָּם וַהֲמוֹן עַם־רָב הָלְכוּ אַחֲרָיו מִן־הַגָּלִיל וּמִן־יְהוּדָה׃","8":"וּמִירוּשָׁלַיִם וּמֵאֱדוֹם וּמֵעֵבֶר לַיַּרְדֵּן וּמִסְּבִיבוֹת צֹר וְצִידוֹן קָהָל גָּדוֹל בָּאוּ אֵלָיו כִּי שָׁמְעוּ אֵת כָּל־אֲשֶׁר עָשָׂה׃","9":"וַיֹּאמֶר אֶל־תַּלְמִידָיו לְהָכֶן־לוֹ אֳנִיָּה קְטַנָּה מִפְּנֵי הֲמוֹן הָעָם לְבִלְתִּי יִדְחֲקוּן אֹתוֹ׃","10":"כִּי הֶעֱלָה אֲרֻכָה לָרַבִּים עַד־אֲשֶׁר הִתְמַלְּאוּ עָלָיו כָּל־הַמְנֻגָּעִים בִּרְצוֹתָם לִנְגֹּעַ בּוֹ׃","11":"וְאֵלֶּה אֲשֶׁר רוּחַ טֻמְאָה בָּם בִּרְאוֹתָם אֹתוֹ נָפְלוּ לְפָנָיו וַיִּצְעֲקוּ לֵאמֹר אַתָּה הוּא בֶּן־הָאֱלֹהִים׃","12":"וְהוּא גָעֹר גָּעַר בָּם לְבִלְתִּי יוֹדִיעוּ מִי הוּא׃","13":"וַיַּעַל אֶל־הָהָר וַיִּקְרָא אֶל־אֵלֶּה אֲשֶׁר חָפֵץ בָּם וַיָּבֹאוּ אֵלָיו׃","14":"וַיִּפְקֹד שְׁנֵים עָשָׂר אֲנָשִׁים לִהְיוֹת אֶצְלוֹ וְלִקְרֹא אֶת־בְּשׂוֹרָתוֹ בְּכֹל אֲשֶׁר יִשְׁלָחֵם׃","15":"וְכֹחַ נָתַן בְּיָדָם לִרְפֹּא אֶת־הַתַּחֲלֻאִים לְגָרֵשׁ רוּחוֹת רָעוֹת׃","16":"וַיְכַנֶּה אֶת־שִׁמְעוֹן בְּשֵׁם פֶּטְרוֹס׃","17":"וְאֶת־יַעֲקֹב בֶּן־זַבְדִּי וְאֶת־יוֹחָנָן אֲחִי יַעֲקֹב כִּנָּה בְּשֵׁם בְּנֵי־רָגֶשׁ אֲשֶׁר הוּא כְּשֵׁם בְּנֵי־רָעַם׃","18":"וְאֶת־אַנְדְּרַי וְאֶת־פִּילִפּוּס וְאֶת־בַּר־תַּלְמַי וְאֶת־מַתִּתְיָהוּ וְאֶת־תּוֹמָא וְאֶת־יַעֲקֹב בֶּן־חַלְפַי וְאֶת־תַּדַּי וְאֶת־שִׁמְעוֹן הַכְּנַעֲנִי׃","19":"וְאֶת־יְהוּדָה אִישׁ־קְרִיּוֹת הוּא הַמַּסְגִּיר אֹתוֹ וַיָּבֹא הַבָּיְתָה׃","20":"וַהֲמוֹן הָעָם נִקְבְּצוּ שָׁם לָרֹב עַד כִּי־לֹא יָכְלוּ לֶאֱכָל־לָחֶם׃","21":"וְכַאֲשֶׁר שָׁמְעוּ בְנֵי מִשְׁפַּחְתּוֹ יָצְאוּ לְהַחֲזִיק בּוֹ כִּי אָמְרוּ סָר טַעְמוֹ׃","22":"וְהַסּוֹפְרִים אֲשֶׁר יָרְדוּ מִירוּשָׁלַיִם אָמְרוּ כִּי בַּעַל־זְבוּב דָּבַק בּוֹ וְכִי עַל־יְדֵי שַׂר־הַשֵּׁדִים הוּא מְגָרֵשׁ אֶת־הַשֵּׁדִים׃","23":"וַיִּקְרָא אֲלֵיהֶם לָבֹא אֵלָיו וַיִּפְתַּח בְּמָשָׁל פִּיו לֵאמֹר אֵיךְ יוּכַל הַשָּׂטָן לְגָרֵשׁ אֶת־הַשָּׂטָן׃","24":"הֲלֹא מַמְלָכָה הַנִּפְלְגָה עַל־נַפְשָׁהּ הַמַּמְלָכָה הַהִיא לֹא תָקוּם׃","25":"וּבַיִת הַנִּפְלָג עַל־נַפְשׁוֹ הַבַּיִת הַהוּא לֹא־יוּכַל לָקוּם׃","26":"וְאִם־הַשָּׂטָן קָם עַל־נַפְשׁוֹ כִּי נִפְלְגָה רוּחוֹ לֹא־יוּכַל קוּם כִּי בָא עַד־קִצּוֹ׃","27":"לֹא יוּכַל אִישׁ לָבֹא בֵּית הַגִּבּוֹר וְלִשְׁלֹל אֶת־כֵּלָיו אִם־לֹא יֶאְסֹר אֶת־הַגִּבּוֹר רִאשֹׁנָה וְאַחַר יִשְׁלֹל אֵת אֲשֶׁר בְּבֵיתוֹ׃","28":"אָמֵן אֲנִי אֹמֵר לָכֶם הֵן יֵשׁ סְלִיחָה לִבְנֵי אָדָם עַל־כָּל־עֲוֹנוֹתָם וְגִדֻּפֹתָם אֶשֶׁר יְגַדֵּפוּן׃","29":"אֶפֶס הַמְגַדֵּף אֶת־רוּחַ הַקֹּדֶשׁ לֹא תִהְיֶה־לּוֹ סְלִיחָה עֲדֵי־עַד כִּי יִנָּתֵן לַמִּשְׁפָּט בִּפְּלִלִים לְעוֹלְמֵי עוֹלָמִים׃","30":"כִּי־הֵם אָמְרוּ רוּחַ טֻמְאָה דָבְקָה בּוֹ׃","31":"וַיָּבֹאוּ אִמּוֹ וְאֶחָיו וַיַּעַמְדוּ מִחוּץ וַיִּשְׁלְחוּ אֵלָיו לָצֵאת אֲלֵיהֶם׃","32":"וְעַם־רָב אֲשֶׁר יָשְׁבוּ סָבִיב לוֹ אָמְרוּ אֵלָיו הִנֵּה אִמְּךָ וְאַחֶיךָ מִחוּץ מְבַקְשִׁים לִרְאוֹתֶךָ׃","33":"וַיַּעַן וַיֹּאמֶר אֲלֵיהֶם מִי אִמִּי וּמִי אֶחָי׃","34":"וַיַּבֵּט כֹּה וָכֹה אֶל־הַיֹּשְׁבִים סָבִיב לוֹ וַיֹּאמַר הִנֵּה אִמִּי וְאֶחָי׃","35":"כִּי אִישׁ אִישׁ אֲשֶׁר יַעֲשֶׂה רְצוֹן הָאֱלֹהִים הוּא אָחִי וַאֲחֹתִי וְאִמִּי׃"}}