n",23,33],["πρὸς","G4314","PREP",0,"pros"],["ἀλλήλους·","G240","C-APM","one another","allēlous",34,45],["Τίς","G5101","I-NSM","Who","Tis",48,51],["ἄρα","G686","PRT-I",0,"ara"],["οὗτός","G3778","D-NSM","this","houtos",55,59],["ἐστιν","G1510",0,"is","estin",52,54],["ὅτι","G3754","CONJ","that","hoti",61,65],["καὶ","G2532","CONJ","even","kai",66,70],["ὁ","G3588","T-NSM","the","ho",71,74],["ἄνεμος","G417","N-NSM","wind","anemos",75,79],["καὶ","G2532","CONJ","and","kai",80,83],["ἡ","G3588","T-NSF","the","hē",84,87],["θάλασσα","G2281","N-NSF","sea","thalassa",88,91],["ὑπακούει","G5219","V-PAI-3S","obey","hypakouei",92,96],["αὐτῷ;","G846","P-DSM","Him","autō",97,100]]},"s":{"1":"וַיָּשָׁב וַיָּחֶל לְלַמֵּד עוֹד הַפַּעַם עַל־שְׂפַת הַיָּם וַהֲמוֹן עַם־רָב נִקְהֲלוּ אֵלָיו עַד אֲשֶׁר־יָרַד וַיֵּשֶׁב בָּאֳנִיָּה בְּתוֹךְ הַיָּם וְכָל־הָעָם עֹמְדִים עַל־הַחוֹף בַּיַּבָּשָׁה׃","2":"וַיְאַלְּפֵם דְּבָרִים רַבִּים בִּמְשָׁלָיו וַיַּטֵּף אֲלֵיהֶם לִקְחוֹ׃","3":"הַאֲזִינוּ לְאִמְרֵי־פִי הִנֵּה הַזֹּרֵעַ יָצָא לִזְרֹעַ׃","4":"וַיְהִי בְּזָרְעוֹ וַיְפַזֵּר מִן־הַזֶּרַע עַל־יַד הַדָּרֶךְ וַיָּבֹא עוֹף הַשָּׁמַיִם וַיֹאכְלֶנּוּ׃","5":"וְיֵשׁ מִן־הַזֶּרַע אֲשֶׁר נָפַל עַל־אַדְמַת סֶלַע וְלֹא הָיָה שָׁם דֵּי עָפָר וַיְמַהֵר לִצְמֹחַ מִבְּלִי אֲשֶׁר הָיָה לוֹ עֹמֶק אֲדָמָה׃","6":"וַיְהִי כִּזְרֹחַ הַשֶּׁמֶשׁ וַיִּצָּרֵב וַיִּיבָשׁ כִּי לֹא הָיָה־לוֹ שֹׁרֶשׁ לְמָטָּה׃","7":"וְיֵשׁ אֲשֶׁר נָפַל אֶל־הַקֹּצִים וַיַּעֲלוּ הַקֹּצִים וַיְבַלְּעֻהוּ וְלֹא עָשָׂה תְּבוּאָה׃","8":"וְיֵשׁ אֲשֶׁר נָפַל עַל־חֶלְקָה טוֹבָה וַיּוֹצֵא פְּרִי תְבוּאָה הֹלֵךְ הָלוֹךְ וָרָב עַד אֲשֶׁר־עָשָׂה שְׁלֹשִׁים שְׁעָרִים וְשִׁשִּׁים שְׁעָרִים וּמֵאָה שְׁעָרִים׃","9":"וַיֹּאמַר אֲלֵיהֶם מִי אֲשֶׁר אָזְנַיִם לוֹ לִשְׁמֹעַ יִשְׁמָע׃","10":"וַיְהִי בְּשִׁבְתּוֹ לְבַדּוֹ וַיָּבֹאוּ אֵלֶּה אֲשֶׁר דָּבְקוּ בוֹ עִם־שְׁנֵים הֶעָשָׂר וַיִּשְׁאָלֻהוּ עַל־דְּבַר מְשָׁלָיו׃","11":"וַיֹּאמֶר אֲלֵיהֶם לָכֶם נִתַּן לָדַעַת רָזֵי מַלְכוּת הָאֱלֹהִים וְאֵלֶּה אֲשֶׁר מִבַּחוּץ רַק מְשָׁלִים יִשְׁמְעוּ בַּכֹּל׃","12":"לְמַעַן רָאוֹ יִרְאוּ וְלֹא יֵדְעוּ וְשָׁמוֹעַ יִשְׁמְעוּ וְלֹא יָבִינוּ פֶּן־יָשׁוּבוּ וְנִסְלַח לָהֶם׃","13":"וַיֹּאמֶר אֲלֵיהֶם אִם־הַמָּשָׁל הַזֶּה לֹא הֲבִינוֹתֶם אֵיךְ תָּבִינוּ שְׁאָר הַמְּשָׁלִים׃","14":"הַזֹּרֵעַ הֲלֹא הוּא הַזֹּרֵעַ אֶת־דְּבַר הַמַּלְכוּת׃","15":"וַאֲשֶׁר עַל־יַד הַדֶּרֶךְ הֵם אֵלֶּה אֲשֶׁר יְקַבְּלוּ אֶת־הַזֶּרַע בְּשָׁמְעָם אֶת־אֲשֶׁר נֶאֱמַר לָהֶם אַךְ הַשָּׂטָן יָחִישׁ לָבוֹא וְנָשָׂא אֶת־הַזֶּרַע הַזָּרוּעַ בָּם׃","16":"וְכֵן הַזֶּרַע הַזָּרוּעַ עַל־חֶלְקַת סֶלַע הֵם אֵלֶּה אֲשֶׁר יְמַהֲרוּ לִשְׁמֹעַ אֶת־דְּבַר הַמַּלְכוּת בְּשִׂמְחָה׃","17":"אֶפֶס כִּי־אֵין לָהֶם שֹׁרֶשׁ בְּנַפְשָׁם וְרַק כִּמְעַט רֶגַע יַעֲמֹדוּ וְאַחֲרֵי־כֵן כִּי תִקְרֶה כָל־צָרָה וְרָדְפוּ אֹתָם עַל־דְּבַר אֱמוּנָתָם יִכָּשְׁלוּ כְּרָגַע׃","18":"וְהַזֶּרַע הַזָּרוּעַ אֶל־הַקֹּצִים הֵם אֵלֶּה אֲשֶׁר יִשְׁמְעוּ דְּבַר־הַמַּלְכוּת׃","19":"וְדַאֲגוֹת הָעוֹלָם הַזֶּה וְנִכְלֵי הָעשֶׁר וַחֲפָצִים אֲחֵרִים בָּאִים וּמְבַלְּעִים אֶת־הַדָּבָר וְלֹא יַעֲשֶׂה־צֶּמַח׃","20":"וְהַזֶּרַע הַזָּרוּעַ בַּחֶלְקָה הַטּוֹבָה הֵם הַשֹּׁמְעִים אֶת־הַדָּבָר וְיִצְפְּנֻהוּ עַד אֲשֶׁר־יָנוּב תְּנוּבָה שְׁלֹשִׁים שְׁעָרִים וְשִׁשִּׁים שְׁעָרִים וּמֵאָה שְׁעָרִים׃","21":"וַיֹּאמֶר אֲלֵיהֶם הֲיוּבָא הַנֵּר לְשׂוּמוֹ תַּחַת הָאֵיפָה אוֹ תַּחַת הַמִּטָּה וְלֹא לְהַעֲלֹתוֹ אֶל־הַמְּנוֹרָה׃","22":"כִּי אֵין־דָּבָר נֶעְלָם אֲשֶׁר לֹא־יִגָּלֶה וְאֵין נִסְתָּר אֲשֶׁר־לֹא יֵצֵא לָאוֹר׃","23":"מִי אֲשֶׁר אָזְנַיִם לוֹ לִשְׁמֹעַ יִשְׁמָע׃","24":"וַיֹּאמֶר אֲלֵיהֶם שִׂימוּ לִבְּכֶם לַאֲשֶׁר אַתֶּם שֹׁמְעִים בַּמִּדָּה אֲשֶׁר אַתֶּם תָּמֹדּוּ בָּהּ יִמַּד לָכֶם גַּם־אַתֶּם וְעוֹד יֻתַּן לָכֶם נוֹסָפוֹת׃","25":"כִּי מִי אֲשֶׁר יֶשׁ־לוֹ יֻתַּן לוֹ עוֹד וּמִי אֲשֶׁר אֵין־לוֹ יֻקַּח מִמֶּנּוּ גַּם אֲשֶׁר יֶשׁ־לוֹ׃","26":"וַיֹּאמֶר עוֹד נִמְשָׁלָה מַלְכוּת הָאֱלֹהִים כָּאִישׁ הַשָּׁת זֶרַע בָּאָרֶץ׃","27":"וְהָלַךְ־לוֹ לִישׁוֹן וְקָם לַיְלָה וָיוֹם וְהַזֶּרַע יִצְמַח וְיִגְדָּל אַךְ אֵיכָה נֶעֶשְׂתָה כָזֹאת הוּא לֹא יֵדָע׃","28":"כִּי הָאָרֶץ תּוֹצִיא צִמְחָהּ מֵאֵלֶיהָ אֶת־הַקָּנֶה רִאשֹׁנָה אַחֲרֵי־כֵן אֶת־הַשִּׁבֹּלֶת וַאַחֲרֵי־כֵן אֶת־הַחִטָּה בַּשִּׁבֹּלֶת הַמְּלֵאָה׃","29":"וְאָז יָחִישׁ יָנִיף מַגָּל עַל־תְּבוּאַת הַקָּמָה כִּי בָשַׁל קָצִיר׃","30":"וַיּוֹסֶף וַיֹּאמַר מַה־דְּמוּת לְמַלְכוּת הָאֱלֹהִים וּמַה־מָּשָׁל נְשַׁוֶּה־לָּהּ׃","31":"דִּמְיוֹנָהּ לְגַרְגַּר חַרְדָּל אֲשֶׁר הוּשַׁת בָּאָרֶץ וְהוּא קָטֹן מִכָּל־זֶרַע אֲשֶׁר עַל־פְּנֵי הָאֲדָמָה׃","32":"וְאַחֲרֵי אֲשֶׁר נִזְרַע יָצִיץ יִגְדַּל מִכָּל־יֶרֶק וַעֲנָפִים גְּדוֹלִים יוֹצִיא עַד־אֲשֶׁר עוֹף הַשָּׁמַיִם יְקַנְּנוּ בְצִלּוֹ׃","33":"וּבְמְשָׁלִים רַבִּים כָּאֵלֶּה הִטִּיף אֲלֵיהֶם מִלָּתוֹ כְּפִי־אֲשֶׁר יָכְלוּ שְׂאֵת׃","34":"וְלֹא דִבֶּר אֲלֵיהֶם דָּבָר בִּבְלִי מָשָׁל וּבְשִׁבְתּוֹ עִם־תַּלְמִידָיו לְבַדָּם בֵּאֵר לָהֶם אֶת־הַמְּשָׁלִים כֻּלָּם׃","35":"בַּיּוֹם הַהוּא לְעֵת עֶרֶב אָמַר אֲלֵיהֶם נַעְבְּרָה־נָּא אֶל־עֵבֶר הַיָּם׃","36":"וַיְשַׁלְּחוּ אֶת־הֲמוֹן הָעָם וַיַּעֲבִירוּ אֹתוֹ בָּאֳנִיָּה הַהִיא אֲשֶׁר יָשַׁב בָּהּ מֵאָז וָאֳנִיּוֹת אֲחֵרוֹת סָבִיב לוֹ׃","37":"וַתָּקָם סוּפָה וּסְעָרָה גְדוֹלָה בַּיָּם וְהַגַּלִּים שָׁטְפוּ אֶל־הָאֳנִיָּה עַד־לְמַלְּאוֹתָהּ מָיִם׃","38":"וְהוּא נִרְדָּם בְּיַרְכְּתֵי הָאֳנִיָּה וְהַכְּסָתוֹת מְרַאֲשֹׁתָיו וַיָּעִירוּ אֹתוֹ לֵאמֹר רַבֵּנוּ הֲכִי לֹא תָחוּשׁ לָנוּ כִּי אֹבְדִים אֲנָחְנוּ׃","39":"וַיֵּעוֹר וַיִּגְעַר בָּרוּחַ וַיֹּאמֶר אֶל־הַיָּם דֹּם וְהֵרָגַע וַיִּשְׁתֹּק הָרוּחַ וַתְּהִי דְּמָמָה גְדוֹלָה׃","40":"אָז אָמַר אֲלֵיהֶם מַדּוּעַ כֹּה תֶחֱרָדוּן הַעוֹד אֵין אֵמֻן בָּכֶם׃","41":"וְהֵם יָרְאוּ יִרְאָה גְדוֹלָה וַיֹּאמְרוּ אִישׁ אֶל־אָחִיו מִי הוּא זֶה אֲשֶׁר גַּם־הָרוּחַ וְהַיָּם מַקְשִׁיבִים לְקוֹלוֹ׃"}}