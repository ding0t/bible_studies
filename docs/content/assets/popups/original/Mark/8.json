ּ לָתֵת לָהֶם אוֹת מִן־הַשָּׁמָיִם׃","12":"וַיֵּאָנַח בִּמְרִירוּת רוּחוֹ לֵאמֹר מַדּוּעַ יְבַקֵּשׁ הַדּוֹר הַזֶּה אוֹת אָמֵן אֲנִי אֹמֵר לָכֶם כִּי אוֹת לֹא יִנָּתֵן לַדּוֹר הַזֶּה׃","13":"וַיַּעֲזֹב אֹתָם וַיָּשָׁב וַיַּעֲבֹר בָּאֳנִיָּה אֶל־עֵבֶר הַיָּם׃","14":"וְהֵם שָׁכְחוּ לָקַחַת אִתָּם צֵדָה לַדָּרֶךְ וְלֹא־נִמְצָא בָאֳנִיָּתָם בִּלְתִּי כִּכַּר־לֶחֶם אֶחָת׃","15":"וְהוּא הִזְהִיר אֹתָם לֵאמֹר רְאוּ הִשָּׁמְרוּ לָכֶם מֵחֻמְצַת הַפְּרוּשִׁים וּמִשְּׂאֹר הוֹרְדוֹס׃","16":"וַיְהִי הֵם נְדוֹנִים אִישׁ אֶת־אָחִיו לֵאמֹר עַל כִּי־לֶחֶם אֵין אִתָּנוּ׃","17":"וַיֵּדַע יֵשׁוּעַ וַיֹּאמֶר אֲלֵיהֶם לָמָּה־זֶּה אַתֶּם נְדוֹנִים עַל כִּי־אֵין לָכֶם לָחֶם הֲכִי לֹא תָבִינוּ וְלֹא תַשְׂכִּילוּ וְלִבְּכֶם כָּבֵד עַד־כֹּה׃","18":"עֵינַיִם לָכֶם וְלֹא תִרְאוּ וְאָזְנַיִם לָכֶם וְלֹא תַקְשִׁיבוּ וְלֹא תִזְכֹּרוּ׃","19":"כַּאֲשֶׁר פָּרַסְתִּי אֶת־חֲמֵשֶׁת הַלֶּחֶם לַחֲמֵשֶׁת אֲלָפִים כַּמָּה סַלִּים מְלֵאִים פְּתוֹתִים נְשָׂאתֶם מֵהֶם וַיֹּאמְרוּ אֵלָיו שְׁנֵים־עָשָׂר׃","20":"וּמִן־הַשֶּׁבַע לְאַרְבַּעַת הָאֲלָפִים כַּמָּה סַלִּים מְלֵאִים פְּתוֹתִים נְשָׂאתֶם מֵהֶם וַיֹּאמְרוּ אֵלָיו שִׁבְעָה׃","21":"וַיֹּאמֶר אֲלֵיהֶם הֲכִי עוֹד לֹא תַשְׂכִּילוּ עַד־כֹּה׃","22":"וַיָּבֹאוּ אֶל־בֵּית צָיְדָה וַיָּבִיאוּ אֵלָיו אִישׁ עִוֵּר וַיְבַקְשֻׁהוּ לְתִתּוֹ לָגַעַת בּוֹ׃","23":"וַיַּחֲזֵק בְּיַד הָעִוֵּר וַיּוֹצִיאֵהוּ אֶל־מִחוּץ לָעִיר וַיָּרָק בְּעֵינָיו וְאֶת־יָדָיו שָׂם עָלָיו וַיִּשְׁאָלֵהוּ אִם־הוּא רֹאֶה מְאוּמָה׃","24":"וַיִּשָּׂא אֶת־עֵינָיו וַיֹּאמַר אֲנִי רֹאֶה אֲנָשִׁים כִּי אֲנִי רֹאֶה אֹתָם הֹלְכִים כְּמוֹ־עֵצִים׃","25":"וַיָּשֶׂם אֶת־יָדָיו שֵׁנִית עַל־עֵינָיו וַיִּפְקַח אֹתָן אָז הִתְרַפֵּא וַיַּרְא כָּל־דָּבָר אֶל־נָכוֹן׃","26":"וַיְשַׁלְּחֵהוּ אֶל־בֵּיתוֹ וַיֹּאמַר אַל־תָּבֹא בָּעִיר וְאַל לְהַגִּיד לְאִישׁ דָּבָר בָּעִיר׃","27":"וַיֵּצֵא יֵשׁוּעַ מִשָּׁם וַיֵּלֶךְ עִם־תַּלְמִידָיו אֶל־הַכְּפָרִים בְּקִיסְרִין אֲשֶׁר לְפִילִפּוֹס וַיְהִי בַּדֶּרֶךְ וַיִּשְׁאַל אֹתָם לֵאמֹר מָה־אֹמְרִים הָאֲנָשִׁים עָלַי מִי־אָנִי׃","28":"וַיַּעֲנוּ וַיֹּאמְרוּ יוֹחָנָן הַמְטַבֵּל וְיֵשׁ אֹמְרִים אֵלִיָּהוּ וַאֲחֵרִים אֹמְרִים אֶחָד מִן־הַנְּבִיאִים׃","29":"וַיִּשְׁאַל אֹתָם לֵאמֹר וְאַתֶּם מַה־תֹּאמְרוּ עָלַי מִי־אָנִי וַיַּעַן פֶּטְרוֹס וַיֹּאמֶר אֵלָיו אַתָּה הוּא הַמָּשִׁיחַ׃","30":"וַיְצַו עֲלֵיהֶם לְבִלְתִּי הַגֵּד לְאִישׁ עַל־אֹדוֹתָיו׃","31":"אָז הֵחֵל לְהוֹרֹתָם לֵאמֹר רַבִּים מַכְאֹבִים לְבֶן־הָאָדָם וְהַזְּקֵנִים וְרָאשֵׁי הַכֹּהֲנִים וְהַסּוֹפְרִים יִמְאֲסוּ בוֹ וִימִיתֻהוּ וּמִקְצֵה שְׁלֹשֶׁת יָמִים יָקוּם׃","32":"וְאֶת־הַדָּבָר הַזֶּה הִגִּיד בַּאֵר הֵיטֵב וַיִּקַּח אֹתוֹ פֶּטְרוֹס וַיָּחֶל לְהוֹכִיחוֹ בִּדְבָרִים׃","33":"אַךְ הוּא פָּנָה כֹּה וָכֹה וַיַּבֵּט אֶל־תַּלְמִידָיו וַיִּגְעַר בְּפֶטְרוֹס לֵאמֹר סוּר שָׁטָן מֵעַל־פָּנַי כִּי לֹא תַשְׂכִּיל אֶת־אֲשֶׁר לֵאלֹהִים כִּי אִם־אֶת־אֲשֶׁר לָאָדָם׃","34":"וַיִּקְרָא אֶל־הָעָם וְאֶל־תַּלְמִידָיו וַיֹּאמֶר אֲלֵיהֶם מִי־הֶחָפֵץ לָלֶכֶת אַחֲרַי יַשְׁלִיךְ אֶת־נַפְשׁוֹ מִנֶּגֶד וְיִשָּׂא אֶת־צְלָבוֹ וְיֵלֵךְ אַחֲרָי׃","35":"כִּי מִי־הֶחָפֵץ לְהַצִּיל אֶת־נַפְשׁוֹ תִּכָּרֶת־לוֹ וּמִי־אֲשֶׁר־יַכְרִית אֶת־נַפְשׁוֹ לְמַעֲנִי וּלְמַעַן הַבְּשׂוֹרָה יִמְצָאֶנָּה׃","36":"כִּי מַה־בֶּצַע לְאִישׁ אִם־יִקְנֶה־לּוֹ אֶת־כָּל־הָאָרֶץ וְנַפְשׁוֹ תִּכָּרֶת־לוֹ׃","37":"אוֹ מַה־יִּתֶּן אִישׁ פִּדְיוֹן נַפְשׁוֹ׃","38":"כִּי כָּל־אִישׁ אֲשֶׁר יֵבוֹשׁ מִמֶּנִּי וּמִדְּבָרַי בַּדּוֹר הַבֹּגֵד וְהַפּשֵׁעַ הַזֶּה אַף בֶּן־הָאָדָם יֵבוֹשׁ מִמֶּנּוּ גַּם־הוּא כַּאֲשֶׁר יָבֹא בִכְבוֹד אָבִיו עִם־מַלְאָכָיו הַקְּדוֹשִׁים׃"}}