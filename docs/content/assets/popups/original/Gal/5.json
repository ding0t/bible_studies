ָשִׁיחַ וְאַל־תִּתָּפְשׂוּ עוֹד בְּעֹל הָעַבְדוּת׃","2":"הִנֵּה אֲנִי פוֹלוֹס מַגִּיד לָכֶם אִם־תִּמּוֹלוּ הַמָּשִׁיחַ לֹא־לְהוֹעִיל לָכֶם׃","3":"וְעוֹד אֲנִי מַזְהִיר כָּל־אִישׁ אֲשֶׁר יִמּוֹל מְצֻוֶּה הוּא לַעֲשׂוֹת אֶת־כָּל־דִּבְרֵי הַתּוֹרָה׃","4":"נִפְרָדִים מֵעִם הַמָּשִׁיחַ אַתֶּם הַמִּצְטַדְּקִים בַּתּוֹרָה וְנָסוֹג מֵאַחַר הֶחָסֶד׃","5":"כִּי־אֲנַחְנוּ בְּרוּחַ וּבֶאֱמוּנָה נִשָּׂא עֵינֵינוּ אֶל־צְדָקָה כַּאֲשֶׁר קִוִּינוּ לָהּ׃","6":"כִּי לִפְנֵי יֵשׁוּעַ הַמָּשִׁיחַ אֵין־יֶתֶר עָז לֹא לַמּוּלָה וְלֹא לָעָרְלָה כִּי אִם־לֶאֱמוּנָה בַּעֲלַת פְּעָלִים בְּאַהֲבָה׃","7":"וְאַתֶּם מְרוּצַתְכֶם טוֹבָה הָיָתָה מִי סָגַר עֲלֵיכֶם מֵהַשֵּׂג אֶת־הָאֱמֶת׃","8":"לֹא מִפִּי הַקֹּרֵא אֶתְכֶם דִּבְרֵי מְפַתֵּיכֶם יָצָאוּ׃","9":"מְעַט שְׂאֹר יַחֲמִיץ אֵת כָּל־הָעֲרִיסָה׃","10":"וַאֲנִי בֹטֵחַ בָּכֶם לִפְנֵי אֲדֹנֵינוּ כִּי מַחֲשָׁבָה זָרָה לֹא תַעֲלֶה עַל־לִבְּכֶם אַךְ הָעֹכֵר אֶתְכֶם וִיהִי מִי שֶׁיִּהְיֶה עֲוֹנוֹ יִשָּׂא׃","11":"וַאֲנִי אַחַי אִם עוֹד אֶקְרָא לְהִמּוֹל עַל־מַה־זֶּה אֲנִי נִרְדָּף הֲלֹא סָר מִכְשׁוֹל הַצְּלִיב וְאֵינֶנּוּ׃","12":"מִי־יִתֵּן אֵפוֹא וּמְסַלְּפֵי דַרְכֵיכֶם יִמָּלוּ׃","13":"כִּי דְרוֹר נִקְרָא לָכֶם אַחַי אַךְ לֹא דְרוֹר לְהַחֲטִיא אֶת־בְּשַׂרְכֶם כִּי אִם־לַעֲבֹד אִישׁ אֶת־רֵעֵהוּ בְּאַהֲבָה׃","14":"כִּי כָל־הַתּוֹרָה תּוּקַם בַּמִּצְוָה הָאַחַת הַזֹּאת וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ׃","15":"אַךְ אִם־תְּנַשְּׁכוּ וְתֹאכְלוּ אִישׁ אֶת־רֵעֵהוּ רְאוּ פֶּן־אִישׁ בְּיַד רֵעֵהוּ תִּסָּפוּ׃","16":"וַאֲנִי הִנְנִי אֹמֵר הִתְהַלְּכוּ כְאַנְשֵׁי רוּחַ וְאָז לֹא תְמָלְאוּן אֶת תַּאֲוַת הַבָּשָׂר׃","17":"כִּי הַבָּשָׂר מִתְאַוֶּה אֶת־אֲשֶׁר לֹא יֹאבֶה הָרוּחַ וְהָרוּחַ אֶת־אֲשֶׁר לֹא יֹאבֶה הַבָּשָׂר כִּי שְׁנֵיהֶם צָרִים זֶה לָזֶה עַד אֲשֶׁר לֹא תוּכְלוּן עֲשׂוֹת כַּאֲשֶׁר תַּחְפֹּצוּ׃","18":"וְאִם־תֵּלְכוּן כַּאֲשֶׁר יוֹלִכֲכֶם הָרוּחַ אֵינְכֶם עוֹד תַּחַת מִשְׁטַר הַתּוֹרָה׃","19":"וּמַעַלְלֵי הַבָּשָׂר יְדוּעִים וְאֵלֶּה הֵם נִאוּף זְנוּת זִמָּה וַעֲגָבִים׃","20":"עֲבֹדַת אֱלִילִים וּכְשָׁפִים אֵיבָה מְרִיבָה וְקִנְאָה כַּעַשׂ מָדוֹן מַחְלֹקֶת וּמִפְלָגּוֹת׃","21":"מַשְׂטֵמָה וָרֶצַח וְדַרְכֵי סֹבְאִים וְזוֹלְלִים וְעוֹד אֲחֵרִים כְּמוֹהֶם אֲשֶׁר עֲלֵיהֶם אֲנִי אֹמֵר כַּאֲשֶׁר מֵאָז אָמַרְתִּי כִּי־עֹשֵׂי אֵלֶּה לֹא יִירְשׁוּ מַלְכוּת הָאֱלֹהִים׃","22":"וּפְרִי הָרוּחַ הוּא אַהֲבָה שִׂמְחָה וְשָׁלוֹם אֹרֶךְ אַפַּיִם נְדִיבוֹת חֶסֶד וֶאֱמוּנָה׃","23":"עֲנָוָה וְהַצְנֵעַ לֶכֶת וּלְמִדּוֹת כָּאֵלֶּה אֵין תּוֹרָה׃","24":"וּמִי אֲשֶׁר לְיֵשׁוּעַ הַמָּשִׁיחַ הֵם הִצְלִיבוּ אֶת־הַבָּשָׂר עִם־כָּל־תְּשׁוּקָתוֹ וְתַאֲוָתוֹ׃","25":"אִם־חַיֵּי הָרוּחַ בָּנוּ נֵלְכָה גַּם־בְּאָרְחוֹת הָרוּחַ׃","26":"וְכָבוֹד שָׁוְא לֹא נִרְדֹּף לְהִתְגָּרוֹת אִישׁ בְּרֵעֵהוּ אוֹ לְקַנֵּא אִישׁ בְּרֵעֵהוּ׃"},"q":{"14":[["Lev 19:18","19:18","Καὶ οὐκ ἐκδικᾶταί σου ἡ χείρ· καὶ οὐ μηνιεῖς τοῖς υἱοῖς τοῦ λαοῦ σου· καὶ ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν· ἐγώ εἰμι Κύριος.",[15,16,17,18,19,20]],[null,null,null,[10,11,12,13,14,15]]]}}