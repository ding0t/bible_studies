ת־אִשְׁתּוֹ עַל־כָּל־דָּבָר׃","4":"וַיַּעַן וַיֹּאמַר הֲלֹא קְרָאתֶם כִּי הָעֹשֶׂה מִקֶּדֶם זָכָר וּנְקֵבָה עָשָׂה אֹתָם׃","5":"וְאָמַר עַל־כֵּן יַעֲזָב־אִישׁ אֶת־אָבִיו וְאֶת־אִמּוֹ וְדָבַק בְּאִשְׁתּוֹ וְהָיוּ שְׁנֵיהֶם לְבָשָׂר אֶחָד׃","6":"וְלָזֹאת אֵפוֹא אֵינָם עוֹד שְׁנַיִם כִּי אִם־בָּשָׂר אֶחָד וְלָכֵן אֵת אֲשֶׁר חִבֵּר אֱלֹהִים אַל־יַפְרֵד אָדָם׃","7":"וַיֹּאמְרוּ אֵלָיו וְלָמָּה־זֶּה צִוָּה מֹשֶׁה לָתֵת סֵפֶר כְּרִיתֻת וּלְשַׁלְּחָהּ׃","8":"וַיֹּאמֶר אֲלֵיהֶם בַּעֲבוּר קְשִׁי לְבַבְכֶם נָתַן לָכֶם מֹשֶׁה לְשַׁלַּח אֶת־נְשֵׁיכֶם אֲבָל לֹא הָיָה כֵן מִקֶּדֶם׃","9":"וַאֲנִי אֹמֵר לָכֶם אִישׁ אִישׁ אֲשֶׁר יְשַׁלַּח אֶת־אִשְׁתּוֹ אִם לֹא עַל־דְּבַר זְנוּת וְנֹשֵׂא לוֹ אַחֶרֶת נֹאֵף הוּא וְהַנֹּשֵׂא אֶת־הַגְּרוּשָׁה נֹאֵף הוּא׃","10":"וַיֹּאמְרוּ אֵלָיו תַּלְמִידָיו אִם דְּבַר אִישׁ וְאִשָּׁה כָּכָה הוּא לֹא־טוֹב לָקַחַת אִשָּׁה׃","11":"וַיֹּאמֶר אֲלֵיהֶם לֹא כָל־אִישׁ רַב־כֹּחַ הוּא לִסְבֹּל הַדָּבָר הַזֶּה כִּי־אִם רַק אֵלֶּה אֲשֶׁר נִתַּן לָהֶם׃","12":"כִּי יֵשׁ סָרִיסִים אֲשֶׁר נוֹלְדוּ כֵן מֵרֶחֶם אִמָּם וְיֵשׁ אֲשֶׁר נַעֲשׂוּ סָרִיסִים בִּידֵי אָדָם וְיֵשׁ אֲשֶׁר מִנַּפְשָׁם נִהְיוּ לְסָרִיסִים לְמַעַן מַלְכוּת הַשָּׁמָיִם מִי אֲשֶׁר כֹּחוֹ רַב לוֹ לִסְבֹּל יִסְבֹּל׃","13":"אָז הוּבְאוּ יְלָדִים לְפָנָיו לְבַעֲבוּר יָשִׂים אֶת־יָדָיו עֲלֵיהֶם וְיִתְפַּלֵּל בַּעֲדָם וַיִּגְעֲרוּ־בָם הַתַּלְמִידִים׃","14":"וַיֹּאמֶר יֵשׁוּעַ אֲלֵיהֶם הַנִּיחוּ לַיְלָדִים וְאַל־תִּכְלְאוּ אֹתָם מִבֹּא אֵלָי כִּי מֵאֵלֶּה מַלְכוּת הַשָּׁמָיִם׃","15":"וַיָּשֶׂם אֶת־יָדָיו עֲלֵיהֶם וַיִּפֶן וַיֵּלַךְ׃","16":"וְהִנֵּה־אִישׁ נִגַּשׁ אֵלָיו וַיֹּאמַר רַבִּי הַטּוֹב אֵי־זֶה הַטּוֹב אֶעֱשֶׂה לָרֶשֶׁת חַיֵּי עוֹלָם׃","17":"וַיֹּאמֶר אֵלָיו לָמָּה־זֶּה קָרָאתָ לִי טוֹב אֵין־טוֹב כִּי אִם־אֶחָד הוּא הָאֱלֹהִים וְאִם־נִכְסַפְתָּ לָבֹא אֶל־הַחַיִּים שְׁמֹר אֵת הַמִּצְוֹת׃","18":"וַיֹּאמֶר אֵלָיו אֵי־זֹה הֵנָּה וַיַּעַן יֵשׁוּעַ לֹא תִּרְצָח לֹא תִּנְאָף לֹא תִּגְנֹב לֹא־תַעֲנֶה עֵד שָׁקֶר׃","19":"כַּבֵּד אֶת־אָבִיךָ וְאֶת־אִמֶּךָ וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ׃","20":"וַיֹּאמֶר הַנַּעַר אֵלָיו כָּל־אֵלֶּה שָׁמַרְתִּי מִנְּעוּרָי וּמַה־יֶּחְסַר לִי עוֹד׃","21":"וַיֹּאמֶר אֵלָיו יֵשׁוּעַ אִם־חָפַצְתָּ לִהְיוֹת תָּמִים לֵךְ וּמְכֹר אֶת־כָּל־אֲשֶׁר־לְךָ וְתֵן לַעֲנִיִּים וְהָיָה לְךָ אוֹצָר בַּשָּׁמָיִם וּבֹא וְלֵךְ אַחֲרָי׃","22":"וְהַנַּעַר כְּשָׁמְעוֹ הַדָּבָר הַזֶּה הִתְעַצֵּב אֶל־לִבּוֹ וַיֵּלֶךְ־לוֹ כִּי־נְכָסִים רַבִּים הָיוּ לוֹ׃","23":"וַיֹּאמֶר יֵשׁוּעַ אֶל־תַּלְמִידָיו אָמֵן אֲנִי אֹמֵר לָכֶם מַה־קָּשֶׁה לְאִישׁ עָשִׁיר לָבֹא אֶל־מַלְכוּת הַשָּׁמָיִם׃","24":"וְעוֹד אֲנִי אֹמֵר לָכֶם כִּי־נָקֵל לַגָּמָל לַעֲבֹר דֶּרֶךְ חֻר הַמַּחַט מִבֹּא עָשִׁיר אֶל־מַלְכוּת הָאֱלֹהִים׃","25":"וְתַלְמִידָיו שָׁמְעוּ וַיִּשְׁתּוֹמְמוּ עַד־מְאֹד לֵאמֹר מִי אֵפוֹא יוּכַל לְהִוָּשֵׁעַ׃","26":"וַיַּבֶּט־בָּם יֵשׁוּעַ וַיֹּאמֶר אֲלֵיהֶם מִבְּנֵי־אָדָם יִפָּלֵא הַדָּבָר הַזֶּה אַךְ מֵאֱלֹהִים לֹא יִפָּלֵא כָּל־דָּבָר׃","27":"וַיַּעַן פֶּטְרוֹס וַיֹּאמֶר אֵלָיו הִנֵּה אֲנַחְנוּ עָזַבְנוּ אֶת־כֹּל וַנֵּלֶךְ אַחֲרֶיךָ וּמָה אֵפוֹא יִהְיֶה־לָּנוּ׃","28":"וַיֹּאמֶר יֵשׁוּעַ אֲלֵיהֶם אָמֵן אֲנִי אֹמֵר לָכֶם כִּי אַתֶּם הַהֹלְכִים אַחֲרָי כַּאֲשֶׁר יֵשֵׁב בֶּן־הָאָדָם עַל־כִּסֵּא כְבוֹדוֹ בְּהִתְחַדֵּשׁ הַבְּרִיאָה גַּם־אַתֶּם תֵּשְׁבוּ אָז עַל־שְׁנֵים עָשָׂר כִּסְאוֹת לִשְׁפֹּט אֶת־שְׁנֵים עָשָׂר שִׁבְטֵי יִשְׂרָאֵל׃","29":"וְכָל־אִישׁ אֲשֶׁר יַעֲזֹב בָּתִּים אוֹ אַחִים אוֹ אֲחָיוֹת אוֹ אָב אוֹ אֵם אוֹ אִשָּׁה אוֹ בָנִים אוֹ שָׂדוֹת לְמַעַן שְׁמִי יִמְצָא מֵאָה שְׁעָרִים וְחַיֵּי עוֹלָם יִירָשׁ׃","30":"וְרַבִּים הֵם הָרִאשֹׁנִים אֲשֶׁר יִהְיוּ אַחֲרֹנִים וְהָאַחֲרֹנִים רִאשֹׁנִים׃"},"q":{"5":[["Gen 2:24","2:24","Ἕνεκεν τούτου καταλείψει ἄνθρωπος τὸν πατέρα αὐτοῦ καὶ τὴν μητέρα, καὶ προσκολληθήσεται πρὸς τὴν γυναῖκα αὐτοῦ· καὶ ἔσονται οἱ δύο εἰς σάρκα μίαν.",[1,2,3,4,5,7,8,9,10,15,16,17,18,19,20,21,22]],[null,null,null,[3,4,5,6,7,8,9,10,11,15,16,17,18,19,20,21,22]]],"19":[["Lev 19:18","19:18","Καὶ οὐκ ἐκδικᾶταί σου ἡ χείρ· καὶ οὐ μηνιεῖς τοῖς υἱοῖς τοῦ λαοῦ σου· καὶ ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν· ἐγώ εἰμι Κύριος.",[14,15,16,17,18,19,20]],[null,null,null,[6,7,8,9,10,11,12]]]}}