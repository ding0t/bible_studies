ιν","G2851","N-ASF","punishment","kolasin",35,45],["αἰώνιον,","G166","A-ASF","eternal","aiōnion",27,34],["οἱ","G3588","T-NPM","the","hoi",51,54],["δὲ","G1161","CONJ","but","de",47,50],["δίκαιοι","G1342","A-NPM","righteous","dikaioi",55,64],["εἰς","G1519","PREP","into","eis",65,69],["ζωὴν","G2222","N-ASF","life","zōēn",78,82],["αἰώνιον.","G166","A-ASF","eternal","aiōnion",70,77]]},"s":{"1":"אָז תִּדְמֶה מַלְכוּת הַשָּׁמַיִם לְעֶשֶׂר בְּתוּלוֹת אֲשֶׁר לָקְחוּ אֶת־נֵרֹתֵיהֶן וַתֵּצֶאנָה לִקְרַאת הֶחָתָן׃","2":"חָמֵשׁ מֵהֵן בְּנוֹת־כֶּסֶל וְחָמֵשׁ בְּנוֹת תְּבוּנָה׃","3":"וְהַכְּסִילוֹת לָקְחוּ אֶת־נֵרֹתֵיהֶן וְלֹא־לָקְחוּ עִמָּהֶן שָׁמֶן׃","4":"וְהַנְּבוֹנוֹת לָקְחוּ שֶׁמֶן בִּכְלֵיהֶן עִם־הַנֵּרוֹת׃","5":"וְכַאֲשֶׁר אֵחַר הֶחָתָן לָבֹא נָמוּ יָשְׁנוּ כֻלָּן׃","6":"וַיְהִי בַּחֲצִי הַלַּיְלָה וַתַּעֲבֹר הָרִנָּה הִנֵּה הֶחָתָן בָּא צְאֶינָה לִקְרָאתוֹ׃","7":"אָז הֵקִיצוּ כָּל־הַבְּתוּלוֹת הָאֵלֶּה וַתֵּיטַבְנָה אֶת־נֵרֹתֵיהֶן׃","8":"וַתֹּאמַרְנָה הַכְּסִילוֹת אֶל־הַנְּבוֹנוֹת תְּנֶינָה לָנוּ מִשַּׁמְנְכֶן פֶּן־יִכְבּוּ נֵרֹתֵינוּ׃","9":"וְהַנְּבוֹנוֹת עָנוּ לֵאמֹר לֹא כֵן פֶּן־לֹא יִשְׂפֹּק לָנוּ וְלָכֶן לֵכְנָה אֶל־מֹכְרֵי שֶׁמֶן וּקְנֶינָה לָכֵן׃","10":"וַיְהִי בְּלֶכְתָּן לִקְנוֹת וְהִנֵּה הֶחָתָן בָּא וְאֵלֶּה אֲשֶׁר נָכֹנוּ בָּאוּ אִתּוֹ אֶל־חֲתֻנָּתוֹ וְהַדֶּלֶת נִסְגָּרָה׃","11":"וְאַחֲרֵי־כֵן בָּאוּ יֶתֶר הַבְּתוּלוֹת וַתֹּאמַרְנָה אֲדֹנֵינוּ אֲדֹנֵינוּ פְּתַח־נָא לָנוּ׃","12":"וְהוּא עָנָה וְאָמַר אָמֵן אֲנִי אֹמֵר לָכֶן כִּי לֹא יָדַעְתִּי אֶתְכֶן׃","13":"עַל־כֵּן עִמְדוּ עַל־מִשְׁמַרְתְּכֶם כִּי אֵינְכֶם יֹדְעִים אֶת־הַיּוֹם וְאֶת־הַשָּׁעָה אֲשֶׁר יָבֹא בָהּ בֶּן־הָאָדָם׃","14":"כִּי כְּמוֹ־אִישׁ נֹסֵעַ אֶל־מִחוּץ לָאָרֶץ אֲשֶׁר קָרָא לַעֲבָדָיו וַיַּפְקֵד בְּיָדָם אֶת־הוֹנוֹ׃","15":"לְאֶחָד מֵהֶם נָתָן חָמֵשׁ כִּכָּרִים לְאַחֵר שְׁתַּיִם וּלְאַחֵר אֶחָת לְאִישׁ אִישׁ כְּפִי יְכֹלֶת יָדוֹ וַיְמַהֵר וַיִּסַּע לְדַרְכּוֹ׃","16":"וְזֶה אֲשֶׁר לָקַח חָמֵשׁ הַכִּכָּרִים הָלַךְ וַיִּסְחַר בָּהֶן וַיַּעַשׂ חָמֵשׁ כִּכָּרִים אֲחֵרוֹת׃","17":"וְכֵן זֶה אֲשֶׁר לָקַח שְׁתָּיִם רָכַשׁ שְׁתַּיִם אֲחֵרוֹת׃","18":"וְזֶה אֲשֶׁר לָקַח אֶת־הַכִּכָּר הָאֵחַת אָזַל לוֹ וַיַּחְפֹּר בָּאֲדָמָה וַיִּטְמֹן אֶת־כֶּסֶף אֲדֹנָיו׃","19":"וְאַחֲרֵי יָמִים רַבִּים שָׁב אֲדוֹן הָעֲבָדִים הָאֵלֶּה מִדַּרְכּוֹ וַיְחַשֵּׁב עִמָּהֶם׃","20":"וַיִּגַּשׁ זֶה אֲשֶׁר לָקַח חָמֵשׁ הַכִּכָּרִים וַיָּבֵא חָמֵשׁ כִּכָּרִים אֲחֵרוֹת לֵאמֹר אֲדֹנִי חָמֵשׁ כִּכָּרִים נָתַתָּ בְּיָדִי וְהִנֵּה רָכַשְׁתִּי עוֹד חָמֵשׁ כִּכָּרִים אֲחֵרוֹת׃","21":"וַיַּעַן אֹתוֹ אֲדֹנָיו הֵיטַבְתָּ עֶבֶד טוֹב וְנֶאֱמָן נֶאֱמָן הָיִיתָ בִמְעַט וַאֲנִי אַפְקִידְךָ עַל־הַרְבֵּה בֹּא אֶל־שִׂמְחַת אֲדֹנֶיךָ׃","22":"וְזֶה אֲשֶׁר לָקַח כִּכְּרַיִם נִגַּשׁ גַּם־הוּא וַיֹּאמַר אֲדֹנִי שְׁתֵּי כִכָּרִים נָתָתָּ לִּי וְהִנֵּה רָכַשְׁתִּי עֲלֵיהֶן עוֹד כִּכְּרָיִם׃","23":"וַיַּעַן אֹתוֹ אֲדֹנָיו הֵיטַבְתָּ עֶבֶד טוֹב וְנֶאֱמָן נֶאֱמָן הָיִיתָ בִמְעַט וַאֲנִי אַפְקִידְךָ עַל־הַרְבֵּה בֹּא אֶל־שִׂמְחַת אֲדֹנֶיךָ׃","24":"וַיִּגַּשׁ גַּם־זֶה אֲשֶׁר לָקַח כִּכָּר אַחַת וַיֹּאמַר אֲדֹנִי יְדַעְתִּיךָ כִּי־אִישׁ קָשֶׁה אָתָּה קֹצֵר בַּאֲשֶׁר לֹא זָרַעְתַּ וְכֹנֵס בַּאֲשֶׁר לֹא פִזָּרְתָּ׃","25":"וָאִירָא וָאֵלֵךְ וָאֶטְמֹן כִּכָּרְךָ בָּאֲדָמָה וְעַתָּה הֵא־לְךָ אֵת אֲשֶׁר־לָךְ׃","26":"וַיַּעַן אֲדֹנָיו וַיֹּאמֶר אֵלָיו עֶבֶד רָע וְעָצֵל יָדַעְתָּ כִּי־קֹצֵר אֲנִי בַּאֲשֶׁר לֹא זָרַעְתִּי וְכֹנֵס אֲנִי בַּאֲשֶׁר לֹא פִזָּרְתִּי׃","27":"וְעַל־כֵּן הָיָה עָלֶיךָ לָתֵת כַּסְפִּי לְמַחֲלִיפֵי־כָסֶף וַאֲנִי בְּבֹאִי הָיִיתִי מֹצֵא אֵת אֲשֶׁר־לִי בְּתַרְבִּית׃","28":"לָכֵן קְחוּ אֶת־הַכִּכָּר מִיָּדוֹ וּתְנוּ לָזֶה אֲשֶׁר־לוֹ כִּכָּרִים עָשֶׂר׃","29":"כִּי מִי אֲשֶׁר יֶשׁ־לוֹ יִנָּתֵן־לוֹ וְיַעְדִּיף וּמִי אֲשֶׁר אֵין־לוֹ יֻקַּח מִמֶּנּוּ גַּם אֵת אֲשֶׁר יֶשׁ־לוֹ׃","30":"וְאֶת הָעֶבֶד הַזֶּה אֲשֶׁר לֹא יִצְלַח לַכֹּל הַשְׁלִיכוּ אֶל־אֹפֶל וְצַלְמָוֶת שָׁם יִהְיֶה בְכִי וַחֲרֹק שִׁנָּיִם׃","31":"וְהָיָה כִּי יָבוֹא בֶּן־הָאָדָם בִּגְדֻלָּתוֹ וְכָל־הַמַּלְאָכִים הַקְּדשִׁים עִמּוֹ אָז יֵשֵׁב עַל־כִּסֵּא כְבוֹדוֹ׃","32":"וְנִקְבְּצוּ לְפָנָיו כָּל־הַגּוֹיִם וְהִפְרִיד בֵּינֵיהֶם בֵּין אֶחָד לָאֶחָד כַּאֲשֶׁר יַפְרִיד הָרֹעֶה אֶת־הַכְּשָׂבִים מִבֵּין הָעִזִּים׃","33":"וְהֶעֱמִיד אֶת־הַכְּשָׂבִים לִימִינוֹ וְאֶת־הָעִזִּים לִשְׂמֹאלוֹ׃","34":"אָז יֹאמַר הַמֶּלֶךְ לַאֲשֶׁר מִימִינוֹ בֹּאוּ בְּרוּכֵי אָבִי וּרְשׁוּ אֶת־הַמַּלְכוּת אֲשֶׁר הִתְעַתְּדָה לָכֶם לְמִן־הִוָּסֵד עוֹלָם׃","35":"כִּי רָעַבְתִּי וַתַּאֲכִילֻנִי צָמֵאתִי וַתַּשְׁקוּנִי אֹרֵחַ הָיִיתִי וַתַּאַסְפוּנִי׃","36":"עֵרֹם וַתְּכַסֻּנִי חָלִיתִי וַתְּבַקְּרֻנִי עָצוּר בַּכֶּלֶא הָיִיתִי וַתָּבֹאוּ אֵלָי׃","37":"אָז יַעֲנוּ אֹתוֹ הַצַּדִּיקִים לֵאמֹר אֲדֹנֵינוּ מָתַי רְאִינוּךָ רָעֵב וַנַּשְׂבִּיעֶךָ אוֹ צָמֵא וַנַּשְׁקֶךָ׃","38":"מָתַי רְאִינוּךָ אֹרֵחַ וַנְּאַסְפֶךָ אוֹ עֵרֹם וַנְּכַסֶּךָ׃","39":"וּמָתַי רְאִינוּךָ חֹלֶה אוֹ עָצוּר בַּכֶּלֶא וַנָּבֹא אֵלֶיךָ׃","40":"וְהַמֶּלֶךְ יַעֲנֶה אֹתָם לֵאמֹר אָמֵן אֲנִי אֹמֵר לָכֶם אֵת אֲשֶׁר עֲשִׂיתֶם לְאֶחָד מֵאַחַי הַקְּטַנִּים הָאֵלֶּה לְנַפְשִׁי עֲשִׂיתֶם׃","41":"אָז יֹאמַר גַּם־לַאֲשֶׁר מִשְּׂמֹאלוֹ לְכוּ מֵעָלַי אֲרוּרִים אֶל־אֵשׁ עוֹלָם אֲשֶׁר הִתְעַתְּדָה לְשָׂטָן וּלְמַלְאָכָיו׃","42":"כִּי רָעַבְתִּי וְלֹא נְתַתֶּם לִי לֶאֱכֹל צָמֵאתִי וְלֹא נְתַתֶּם לִי לִשְׁתּוֹת׃","43":"אֹרֵחַ הָיִיתִי וְלֹא אֲסַפְתּוּנִי עֵרֹם וְלֹא כִסִּיתוּנִי חֹלֶה הָיִיתִי וְעָצוּר בַּכֶּלֶא וְלֹא בִקַּרְתּוּנִי׃","44":"וְהֵם גַּם־הֵם יַעֲנוּ אֵלָיו לֵאמֹר אֲדֹנֵינוּ מָתַי רְאִינוּךָ רָעֵב אוֹ צָמֵא אוֹ אֹרֵחַ אוֹ עָרֹם אוֹ חֹלֶה אוֹ עָצוּר בַּכֶּלֶא וְלֹא בָאנוּ לְעֶזְרֶךָ׃","45":"וְהוּא יַעֲנֶה אֹתָם לֵאמֹר אָמֵן אֲנִי אֹמֵר לָכֶם אֵת אֲשֶׁר לֹא עֲשִׂיתֶם לְאַחַד הַקְּטַנִּים הָאֵלֶּה לְנַפְשִׁי לֹא עֲשִׂיתֶם׃","46":"וְכֵן יֵלְכוּ אֵלֶּה לְדִרְאוֹן עוֹלָם וְהַצַּדִּיקִים לְחַיֵּי עוֹלָם׃"}}