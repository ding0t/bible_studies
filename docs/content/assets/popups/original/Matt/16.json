ְכְּרוּ אֶת־חֲמֵשֶׁת הַלֶּחֶם אָכְלוּ חֲמֵשֶׁת אֲלָפִים וְכַמָּה סַלִּים אֲשֶׁר נְשָׂאתֶם׃","10":"וְגַם־שִׁבְעַת הַלֶּחֶם אָכְלוּ אַרְבַּעַת אֲלָפִים וְכַמָּה סַלִּים אֲשֶׁר נְשָׂאתֶם׃","11":"וְאֵיךְ לֹא תַשְׂכִּילוּ כִּי לֹא עַל־דְּבַר לֶחֶם אָמַרְתִּי לָכֶם כִּי אִם־לְהִשָּׁמֵר מִשְּׂאֹר הַפְּרוּשִׁים וְהַצַּדּוּקִים׃","12":"אָז הֵבִינוּ כִּי לֹא אָמַר לָהֶם לְהִשָּׁמֵר מִשְּׂאֹר הַלָּחֶם כִּי אִם־מִתּוֹרַת הַפְּרוּשִׁים וְהַצַּדּוּקִים׃","13":"וַיָּבֹא יֵשׁוּעַ אֶל־גְּלִילוֹת קִיסְרִין אֲשֶׁר לְפִילִפּוֹס וַיִּשְׁאַל אֶת־תַּלְמִידָיו לֵאמֹר מָה־אֹמְרִים הָאֲנָשִׁים עָלַי מִי הוּא בֶּן־הָאָדָם׃","14":"וַיַּעֲנוּ יֵשׁ אֹמְרִים יוֹחָנָן הַמְטַבֵּל וְיֵשׁ אֹמְרִים אֵלִיָּהוּ וַאֲחֵרִים אֹמְרִים יִרְמְיָהוּ אוֹ אֶחָד מִן־הַנְּבִיאִים׃","15":"וַיֹּאמֶר אֲלֵיהֶם וְאַתֶּם מַה־תֹּאמְרוּ עָלַי מִי אָנִי׃","16":"וַיַּעַן שִׁמְעוֹן פֶּטְרוֹס וַיֹּאמַר אַתָּה הוּא הַמָּשִׁיחַ בֶּן־אֱלֹהִים חַיִּים׃","17":"וַיַּעַן יֵשׁוּעַ וַיֹּמֶר אֵלָיו אַשְׁרֶיךָ שִׁמְעוֹן בַּר־יוֹנָה לֹא בָשָׂר וָדָם גִּלָּה־לְךָ זֶה כִּי אִם־אָבִי אֲשֶׁר בַּשָּׁמָיִם׃","18":"וְגַם־אֲנִי אַגִּיד לְךָ כִּי אַתָּה הוּא כֵּיפָא וְעַל־הַכֵּף הַזֶּה אֶבְנֶה אֶת־קְהִלָּתִי וְשַׁעֲרֵי שְׁאוֹל לֹא יִגְבְּרוּ עָלֶיהָ׃","19":"וְנָתַתִּי לְךָ אֶת־מַפְתְּחוֹת מַלְכוּת הַשָּׁמָיִם אֶת־אֲשֶׁר תֶּאֱסֹר עַל־הָאָרֶץ אָסוּר יִהְיֶה בַּשָּׁמַיִם וְאֶת־אֲשֶׁר תַּתִּיר עַל־הָאָרֶץ מֻתָּר יִהְיֶה בַשָּׁמָיִם׃","20":"אָז צִוָּה עַל־תַּלְמִידָיו לְבִלְתִּי הַגֵּד לְאִישׁ כִּי הוּא יֵשׁוּעַ הַמָּשִׁיחַ׃","21":"מֵהָעֵת הַהִיא הֵחֵל יֵשׁוּעַ לְהוֹרֹת לְתַלְמִידָיו כִּי עָלָיו לָלֶכֶת יְרוּשָׁלַיְמָה לִהְיוֹת מְעֻנֶּה עַד־מְאֹד עַל־יְדֵי הַזְּקֵנִים וְרָאשֵׁי הַכֹּהֲנִים וְהַסּוֹפְרִים וְגַם מוֹת יוּמָת וּבַיּוֹם הַשְּׁלִשִׁי יָקוּם׃","22":"וַיִּקָּחֵהוּ פֶטְרוֹס וַיָּחֶל לִגְעָר־בּוֹ לֵאמֹר חָלִלָה לְּךָ אֲדֹנִי חָלִלָה לְּךָ מִדָּבָר כָּזֶה׃","23":"וַיִּפֶן וַיֹּאמֶר אֶל־פֶּטְרוֹס סוּר שָׂטָן מֵעַל פָּנַי לְמוֹקֵשׁ אַתָּה לִי כִּי לֹא תַשְׂכִּיל אֵת אֲשֶׁר לֵאלֹהִים כִּי־אִם אֵת אֲשֶׁר לָאָדָם׃","24":"אָז אָמַר יֵשׁוּעַ אֶל־תַּלְמִידָיו מִי הֶחָפֵץ לָלֶכֶת אַחֲרַי יַשְׁלִיךְ אֶת־נַפְשׁוֹ מִנֶּגֶד וְיִשָּׂא אֶת־צְלָבוֹ וְיֵלֵךְ אַחֲרָי׃","25":"כִּי מִי הֶחָפֵץ לְהַצִּיל אֶת־נַפְשׁוֹ תִּכָּרֶת־לוֹ וּמִי אֲשֶׁר יַכְרִית אֶת־נַפְשׁוֹ לְמַעֲנִי יִמְצָאֶנָּה׃","26":"כִּי מַה־בֶּצַע לְאִישׁ אִם יִקְנֶה־לּוֹ אֶת־כָּל־הָאָרֶץ וְנַפְשׁוֹ תִכָּרֶת־לוֹ אוֹ מַה־יִּתֵּן אִישׁ פִּדְיוֹן נַפְשׁוֹ׃","27":"כִּי עָתִיד בֶּן־הָאָדָם לָבֹא בִּכְבוֹד אָבִיו עִם־מַלְאָכָיו וְאָז יְשַׁלֵּם לְכָל־אִישׁ כְּמַעֲשֵׂהוּ׃","28":"אָמֵן אֲנִי אֹמֵר לָכֶם יֵשׁ מִן־הַנִּצָּבִים פֹּה אֲשֶׁר לֹא־יִטְעֲמוּ מָוֶת עַד כִּי־יִרְאוּ אֶת־בֶּן־הָאָדָם בָּא בְּמַלְכוּתוֹ׃"}}