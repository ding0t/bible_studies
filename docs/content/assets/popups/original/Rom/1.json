ose who","hoi",47,56],["τὰ","G3588","T-APN","such","ta",60,64],["τοιαῦτα","G5108","D-APN","things","toiauta",65,71],["πράσσοντες","G4238","V-PAP-NPM","do","prassontes",57,59],["ἄξιοι","G514","A-NPM","worthy","axioi",76,82],["θανάτου","G2288","N-GSM","of death","thanatou",83,91],["εἰσίν","G1510",0,"are","eisin",72,75],["οὐ","G3756","PRT-N","{they} not","ou"],["μόνον","G3440",0,"only","monon",102,106],["αὐτὰ","G846","P-APN","these things","auta",122,134],["ποιοῦσιν","G4160","V-PAI-3P","continue to do","poiousin",107,121],["ἀλλὰ","G235","CONJ","but","alla",136,139],["καὶ","G2532","CONJ","also","kai",140,144],["συνευδοκοῦσιν","G4909","V-PAI-3P","approve of","syneudokousin",145,155],["τοῖς","G3588","T-DPM","those who","tois",156,165],["πράσσουσιν.","G4238","V-PAP-DPM","practice [them]","prassousin",166,179]]},"s":{"1":"פּוֹלוֹס עֶבֶד יֵשׁוּעַ הַמָּשִׁיחַ שָׁלִיחַ נִבְחָר וּמְקֻדָּשׁ לְבַשֵּׂר אֶת־בְּשׁרַת הָאֱלֹהִים׃","2":"אֲשֶׁר מִקֶּדֶם הִגִּיד אֹתָהּ עַל־פִּי נְבִיאָיו בְּכִתְבֵי הַקֹּדֶשׁ׃","3":"עַל־דְּבַר בְּנוֹ אֲשֶׁר יָצָא מִזֶּרַע דָּוִד לְפִי בְשָׂרוֹ׃","4":"וְהוּכַן בֶּן־הָאֱלֹהִים בִּגְבוּרָה לְפִי רוּחַ הַקֹּדֶשׁ בַּהֲקִיצוֹ מִן־הַמֵּתִים הוּא יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","5":"וְעַל־יָדוֹ נִתַּן לָנוּ חֵן וּמַלְאֲכוּת־יָהּ לְהַטּוֹת אֶת־לֵב כָּל־הַגּוֹיִם לָאֱמוּנָה בַּעֲבוּר שְׁמוֹ׃","6":"וּבְתוֹכָם הִנְּכֶם גַּם־אַתֶּם קְרִיאֵי יֵשׁוּעַ הַמָּשִׁיחַ׃","7":"כָּל־הַקָּהָל בְּרוֹמִי יְדִידֵי אֱלֹהִים בְּחִירָיו וּקְדֹשָׁיו חֶסֶד וְשָׁלוֹם יִתֵּן לָכֶם אֱלֹהִים אָבִינוּ וְיֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","8":"בְּפֵתַח דְּבָרַי אוֹדֶה אֶת־אֱלֹהַי בְּיֵשׁוּעַ הַמָּשִׁיחַ בְּעַד־כֻּלְכֶם כִּי אֱמוּנַתְכֶם שָׁמְעָה בְּכָל הָעוֹלָם׃","9":"וְהָאֱלֹהִים אֲשֶׁר בִּבְשׁרַת בְּנוֹ אֲנִי עֹבֵד אֹתוֹ בְּרוּחִי וְנַפְשִׁי הוּא עֵדִי כִּי לֹא־חָדַלְתִּי מֵהַזְכִּיר אֶתְכֶם׃","10":"וּמַעְתִּיר אֲנִי תָמִיד בִּתְפִלּוֹתַי לְמָתַי אֵפוֹא אַצְלִיחַ דַּרְכִּי בִּרְצוֹן אֱלֹהַי לָבוֹא אֲלֵיכֶם׃","11":"כִּי־נִכְסֹף נִכְסַפְתִּי לִרְאֹתְכֶם וּלְהַאֲצִיל מִן־מַתְּנַת הָרוּחַ עֲלֵיכֶם לְהוֹסִיף לָכֶם אֹמֶץ׃","12":"וְגַם־כֵּן לְהִתְנַחֵם עִמָּכֶם יַחְדָּו בֶּאֱמוּנַת אִישׁ וְאִישׁ מִמֶּנּוּ כְּמוֹכֶם כָּמֹנִי׃","13":"וְאֵין־נַפְשִׁי לְהַעֲלִים מִכֶּם אַחַי כִּי־רַבּוֹת נָתַתִּי אֶת־לִבִּי לָבוֹא אֲלֵיכֶם לִמְצֹא לִי מְעַט פְּרִי גַם־בָכֶם כְּמוֹ גַם־בְּיֶתֶר הַגּוֹיִם וְנִמְנַעְתִּי עַד־עָתָּה׃","14":"הִנֵּה בַּעַל חוֹב אֲנִי לִבְנֵי הַיְּוָנִים וְגַם־לִבְנֵי עַם לֹעֵז לִבְנֵי בִינָה וְלִבְנֵי בְלִי־בִינָה׃","15":"וּבְכֵן נָכוֹן אֲנִי לְפִי יְכָלְתִּי לְהַגִּיד אֶת־הַבְּשׁרָה גַּם־לָכֶם בְּנֵי רוֹמִי׃","16":"כִּי לֹא־אֵבוֹשׁ מִבְּשׁרַת הַמָּשִׁיחַ אֲשֶׁר גְּבוּרַת אֱלֹהִים הִיא לִתְשׁוּעָה אֶל־כָּל־מַאֲמִין הַיְּהוּדִי בְּרֹאשׁ וְגַם־הַיְּוָנִי׃","17":"כִּי־בָהּ נִגְלְתָה צִדְקַת אֱלֹהִים מִמְּקוֹר אֱמוּנָה לְמַעַן נִחְיֶה בֶאֱמוּנָה כַּכָּתוּב וְצַדִּיק בֶּאֱמוּנָתוֹ יִחְיֶה׃","18":"וַחֲרוֹן אֱלֹהִים מִשָּׁמַיִם נִשְׁקָף עַל־עֹשֵׂי רִשְׁעָה וּבְנֵי עַוְלָה הַכֹּבְשִׁים אֶת־הָאֱמֶת בְּעַוְלָתָה׃","19":"כִּי דַּעַת אֱלֹהִים בְּרוּרָה בְקִרְבָּם כִּי גִלָּה לָהֶם אֱלֹהִים׃","20":"כִּי חֶבְיוֹן עֻזּוֹ נֵצַח גְּבוּרָתוֹ וֵאלֹהוּתוֹ נוֹדְעוּ וְיָצְאוּ לָאוֹרָה עַל־יְדֵי פְעֻלּוֹתָיו מִיּוֹם בְּרֹא אֶרֶץ וְשָׁמָיִם עַד־כִּי אֵין־לָהֶם פֶּה לְהִצְטַדָּק׃","21":"כִּי יֹדְעִים הֵם אֶת־הָאֱלֹהִים וְלֹא נָתְנוּ לוֹ כְבוֹדוֹ אַף־לֹא הוֹדוּ לוֹ כִּי אִם־בְּמוֹעֲצוֹתֵיהֶם יֶהְבָּלוּ וְלִבָּם הַנִּבְעָר הָלַךְ חֲשֵׁכִים׃","22":"יִתְאַמְּרוּ כִּי חֲכָמִים הֵם עַל־כֵּן נִבְעָרוּ׃","23":"וַיָּמִירוּ כְבוֹד אֲדֹנָי אֵל עוֹלָם בִּדְמוּת תַּבְנִית אָדָם בֶּן־תְּמוּתָה וְתַבְנִית עוֹף הַשָּׁמַיִם וְהוֹלֵךְ עַל־אַרְבַּע וְרֶמֶשׂ הָאֲדָמָה׃","24":"עַל־כֵּן אֱלֹהִים הִסְגִּירָם בְּיַד שְׁרִרוּת לִבָּם לְטֻמְאָה וּלְחַלֵּל בְּשָׂרָם הֵם בֵּינֵיהֶם׃","25":"אֲשֶׁר הֵמִירוּ אֱלֹהֵי אֱמֶת בַּשָּׁקֶר וַיִּירְאוּ וַיַּעַבְדוּ אֶת־הַנּוֹצָר עַל־פְּנֵי הַיּוֹצֵר בָּרוּךְ הוּא לְעוֹלָם וָעֶד אָמֵן׃","26":"בַּעֲבוּר זֹאת הִסְגִּירָם אֱלֹהִים בְּיַד קְלוֹן תְּשׁוּקָתָם כִּי גַּם־נְשֵׁיהֶם הֶחֱלִיפוּ אֹרַח חֻקָּתָן בְּאֹרַח זָר׃","27":"כַּאֲשֶׁר גַּם־הַגְּבָרִים חָדְלוּ מִבּוֹא אֶל־הַנָּשִׁים כְּדֶרֶךְ כָּל־הָאָרֶץ וַתִּבְעַר־בָּם אֵשׁ תַּאֲוָתָם אִישׁ אֶל־רֵעֵהוּ וְגֶבֶר בְּגֶבֶר יִתְעַלְּלוּ לְקִיקָלוֹן וְעֵקֶב תַּעְתֻּעֵיהֶם לָקְחוּ דֵי־גְמוּל בְּנַפְשׁוֹתָם׃","28":"וְכַאֲשֶׁר לֹא חָפְצוּ הַשְׂכֵּל וְיָדֹעַ אֶת־הָאֱלֹהִים כֵּן עֲזָבָם בִּמְשׁוּבַת לִבָּם לַעֲשׂוֹת אֵת אֲשֶׁר־לֹא יֵעָשֶׂה׃","29":"עַד אֲשֶׁר מָלְאוּ כָּל־עַוְלָה זְנוּת רֶשַׁע בֶּצַע וָאָוֶן וְגַם־קִנְאָה וְרֶצַח מָדוֹן וּרְמִיָּה וּמְזִמָּה׃","30":"כֻּלָּם מַלְשִׁינִים וְהֹלְכֵי רָכִיל שׁנְאֵי אֱלֹהִים וְהוֹלְלִים גֵּאִים וּרְהָבִים חָרָשֵׁי מַשְׁחִית וּמַמְרִים לְהוֹרֵיהֶם׃","31":"חַסְרֵי דַּעַת וּמְפִירֵי בְרִית אַכְזָרִים נֹטְרֵי שִׂנְאָה אֲשֶׁר חֲנִינָה לֹא יֵדָעוּ׃","32":"וְהֵם אַף־כִּי יֹדְעִים מִשְׁפַּט אֱלֹהִים כִּי־הָעֹשִׂים מַעֲשִׂים כָּאֵלֶּה בְּנֵי־מָוֶת הֵם בְּכָל־זֹאת לֹא לְבַד כִּי יַעֲשׂוּם כִּי־אִם גַּם־יְאַשְּׁרוּן עוֹד עֹשֵׂיהֶם׃"},"q":{"17":[["Hab 2:4","2:4","Ἐὰν ὑποστείληται, οὐκ εὐδοκεῖ ἡ ψυχή μου ἐν αὐτῷ· ὁ δὲ δίκαιος ἐκ πίστεώς μου ζήσεται.",[7,8,9,10,11,12,13]],[null,null,null,[3,4,12,13,14,15,16]]]}}