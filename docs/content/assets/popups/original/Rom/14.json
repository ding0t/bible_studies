ֵא מֵאֵלָיו וְרַק־טָמֵא הוּא לְמִי אֲשֶׁר יַחְשְׁבֶנּוּ לְטָמֵא׃","15":"וְאִם־יֵעָצֵב אָחִיךָ בְּמַאֲכָלְךָ אֵינְךָ הֹלֵךְ עוֹד בְּאֹרַח אַהֲבָה אַל־תַּשְׁחֵת בְּמַאֲכָלְךָ אֶת־אָחִיךָ אֲשֶׁר הַמָּשִׁיחַ מֵת בַּעֲדוֹ׃","16":"וְאַל־תִּתֵּן יִשְׁרַת נַפְשְׁךָ לְגִדּוּפִים׃","17":"כִּי־מַלְכוּת אֱלֹהִים אֵינֶנָּה מַאֲכָל וּמִשְׁתֶּה כִּי אִם־צְדָקָה שָׁלוֹם וְחֶדְוָה בְּרוּחַ הַקֹּדֶשׁ׃","18":"וְהָעֹבֵד אֶת־הַמָּשִׁיחַ בָּאֵלֶּה רָצוּי הוּא לֵאלֹהִים וְנֶחְמָד בְּעֵינֵי אֲנָשִׁים׃","19":"עַל־כֵּן נִרְדְּפָה־נָּא דַרְכֵי שָׁלוֹם לְכוֹנֵן אִישׁ אֶת־רֵעֵהוּ׃","20":"אַל־תַּהֲרֹס פֹּעַל אֱלֹהִים עַל־דִּבְרַת מַאֲכָל כָּל־דָּבָר הוּא טָהוֹר וְרַק רַע הוּא לַאֲשֶׁר יֹאכְלֶנּוּ לְהִתְנַקֵּם בְּנַפְשׁוֹ׃","21":"טוֹב לֹא־לֶאֱכֹל בָּשָׂר לֹא־לִשְׁתּוֹת יָיִן וְלֹא־לַעֲשׂוֹת דָּבָר אֲשֶׁר יִהְיֶה מִכְשׁוֹל לֵב לְאָחִיךָ אוֹ אֲשֶׁר יִוָּקֶשׁ־בּוֹ אוֹ יָדָיו תִּרְפֶּינָה׃","22":"יֶשׁ־לְךָ אֱמוּנָה תְּהִי־לְךָ לְבַדְּךָ לִפְנֵי הָאֱלֹהִים אַשְׁרֵי הָאִישׁ אֲשֶׁר לִבּוֹ לֹא יַרְשִׁיעֶנּוּ בַּאֲשֶׁר יִבְחַר־לוֹ׃","23":"אַךְ אִם־יֹאכַל וְלִבּוֹ נִפְלַג עָלָיו וְנָשָׂא עֲוֹנוֹ יַעַן כִּי לֹא בֶאֱמוּנָה מַעֲשֵׂהוּ וְכֹל אֲשֶׁר נַעֲשָׂה בִּבְלִי אֱמוּנָה חֵטְא הוּא׃"},"q":{"11":[["Isa 45:23","45:23","Κατʼ ἐμαυτοῦ ὀμνύω, εἰ μὴ ἐξελεύσεται ἐκ τοῦ στόματός μου δικαιοσύνη, οἱ λόγοι μου οὐκ ἀποστραφήσονται· Ὅτι ἐμοὶ κάμψει πᾶν γόνυ, καὶ ὀμεῖται πᾶσα γλῶσσα τὸν Θεὸν,",[16,17,18,19,20,21,23,24]],[null,null,null,[6,7,8,9,10,11,12,13]]]}}