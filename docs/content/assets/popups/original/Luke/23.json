ךְ הוּא לֹא־עָנָהוּ דָּבָר׃","10":"וַיָּקוּמוּ רָאשֵׁי הַכֹּהֲנִים וְהַסּוֹפְרִים וַיֹּסִיפוּ לְשִׂטְנוֹ בְּכָל־מַאֲמַצֵּי כֹחָם׃","11":"וַיִּבֶז אֹתוֹ הוֹרְדוֹס וְחֵיל צְבָאוֹ וַיַּלְבֵּשׁ אֹתוֹ מְעִיל אַרְגָּמָן לְהָתֶל־בּוֹ וַיִּשְׁלָחֵהוּ אֶל־פִּילָטוֹס׃","12":"בַּיּוֹם הַהוּא הִתְרַצּוּ הוֹרְדוֹס וּפִילָטוֹס אִישׁ אֶל־אָחִיו כִּי עַד־כֹּה הָיְתָה מַשְׂטֵמָה בֵּינֵיהֶם׃","13":"וַיִּקְרָא פִילָטוֹס אֶל־רָאשֵׁי הַכֹּהֲנִים וְהַשָּׂרִים וְהָעָם׃","14":"וַיֹּאמֶר אֲלֵיהֶם הֲבֵאתֶם אֵלַי אֶת־הָאִישׁ הַזֶּה כִּמְסַלֵּף אֶת־הָעָם וְהִנֵּה חֲקַרְתִּיו לְעֵינֵיכֶם וְלֹא־מָצָאתִי בָאִישׁ הַזֶּה שֶׁמֶץ דָּבָר מִכֹּל אֲשֶׁר תַּרְשִׁיעוּ אֹתוֹ׃","15":"וְאַף לֹא הוֹרְדוֹס כִּי הוּא הֱשִׁיבוֹ אֵלֵינוּ מִבְּלִי מְצֹא בוֹ חֵטְא מִשְׁפַּט־מָוֶת׃","16":"עַל־כֵּן יַסֹּר אֲיַסְּרֶנּוּ וְאַחֲרֵי כֵן אֲשַׁלַּח אֹתוֹ׃","18":"אַךְ הֵם קָרְאוּ יַחְדָּו לֵאמֹר אֱסֹף אֶת־הָאִישׁ הַזֶּה וְשַׁלַּח לָנוּ אֶת־בַּר־אַבָּא׃","19":"הוּא אֲשֶׁר עָצוּר הָיָה בַּכֶּלֶא בַּעֲבוּר מֶרֶד אֲשֶׁר־נִמְצָא בָּעִיר וָרֶצַח׃","20":"וַיּוֹסֶף פִּילָטוֹס וַיְדַבֵּר אֲלֵיהֶם כִּי־חָפֵץ לְשַׁלַּח אֶת־יֵשׁוּעַ׃","21":"וְהֵם צָעֲקוּ לֵאמֹר הַצְלֵב הַצְלֵב אֹתוֹ׃","22":"וַיְדַבֵּר אֲלֵיהֶם שְׁלִישִׁית וְלָמָּה מֶה רָעָה עָשָׂה זֶה לֹא־מָצָאתִי לוֹ מִשְׁפַּט־מָוֶת עַל־כֵּן אֲיַסְּרֶנּוּ וַאֲשַׁלְּחֶנּוּ׃","23":"אַךְ הֵם הֵרִימוּ קוֹלָם וַיִּשְׁאָלוּ וַיִּפְצְרוּ־בוֹ כִּי יִצָּלֵב וַיַּכְרַע קוֹלָם וְקוֹל רָאשֵׁי הַכֹּהֲנִים׃","24":"וּפִילָטוֹס הוֹצִיא מִשְׁפָּט כִּי תֵעָשֶׂה שֶׁאֱלָתָם׃","25":"וַיְשַׁלַּח לָהֶם אֶת־הֶעָצוּר בַּכֶּלֶא בַּעֲבוּר מֶרֶד וָרֶצַח אֶת־הָאִישׁ אֲשֶׁר שָׁאָלוּ וְאֶת־יֵשׁוּעַ נָתַן לִרְצוֹנָם׃","26":"וַיּוֹלִיכֻהוּ מִשָּׁם וַיַּחֲזִיקוּ בְאִישׁ אֶחָד אֲשֶׁר בָּא מִן־הַשָּׂדֶה וּשְׁמוֹ שִׁמְעוֹן אִישׁ־קוּרִינִי וַיָּשִׂימוּ עָלָיו אֶת־הַצְּלָב לָשֵׂאת אֹתוֹ אַחֲרֵי יֵשׁוּעַ׃","27":"וַהֲמוֹן עַם־רָב הָלְכוּ אַחֲרָיו וַהֲמוֹן נָשִׁים נֹשְׂאוֹת עָלָיו מִסְפֵּד וְקִינָה׃","28":"וַיִּפֶן יֵשׁוּעַ אֲלֵיהֶן וַיֹּאמַר בְּנוֹת יְרוּשָׁלַיִם אַל־תִּבְכֶּינָה לִּי כִּי אִם־בְּכֶינָה לָכֶן וְלִבְנֵיכֶן׃","29":"כִּי הִנֵּה יָמִים בָּאִים וְיֹאמְרוּ אַשְׁרֵי הָעֲקָרוֹת וְהַבֶּטֶן אֲשֶׁר לֹא יָלָדָה וְהַשָּׁדַיִם אֲשֶׁר לֹא הֵינִיקוּ׃","30":"אָז יָחֵלּוּ לֵאמֹר לֶהָרִים נִפְלוּ עָלֵינוּ וְלַגְּבָעוֹת כַּסּוּנוּ׃","31":"כִּי אִם־כָּכָה יַעֲשׂוּ בְּעֵץ לָח מַה־יֵּעָשֶׂה בְּעֵץ יָבֵשׁ׃","32":"וְגַם־שְׁנַיִם אֲחֵרִים פֹּעֲלֵי אָוֶן הוּבָלוּ אִתּוֹ לַמָּוֶת׃","33":"וַיָּבֹאוּ אֶל־הַמָּקוֹם הַנִּקְרָא גֻּלְגָּלְתָּא וַיִּצְלְבוּ אֹתוֹ שָׁם וְאֶת־פֹּעֲלֵי הָאָוֶן אֶחָד לִימִינוֹ וְאֶחָד לִשְׂמֹאלוֹ׃","34":"וַיֹּאמֶר יֵשׁוּעַ אָבִי סְלַח לָהֶם כִּי אֵינָם יֹדְעִים מָה הֵמָּה עֹשִׂים וַיְחַלְּקוּ לָהֶם אֶת־בְּגָדָיו וַיַּפִּילוּ עֲלֵיהֶם גּוֹרָל׃","35":"וְהָעָם עָמְדוּ הִבִּיטוּ בוֹ וְגַם־הַשָּׂרִים לָעֲגוּ־לוֹ לֵאמֹר אֶת־אֲחֵרִים הוֹשִׁיעַ יוֹשַׁע־נָא אֶת־נַפְשׁוֹ אִם־הוּא הַמָּשִׁיחַ בְּחִיר הָאֱלֹהִים׃","36":"וְכֵן גַּם־אַנְשֵׁי הַצָּבָא שָׂחֲקוּ עָלָיו וַיָּבֹאוּ וַיַּגִּישׁוּ לוֹ חֹמֶץ׃","37":"וַיֹּאמְרוּ אִם־אַתָּה הוּא מֶלֶךְ הַיְּהוּדִים הוֹשַׁע אֶת־נַפְשֶׁךָ׃","38":"וַיָּשִׂימוּ כְתֹבֶת מִמַּעַל לוֹ בִּכְתָב יְוָנִי וְרוֹמִי וְעִבְרִי זֶה הוּא מֶלֶךְ הַיְּהוּדִים׃","39":"וְאֶחָד מִפֹּעֲלֵי הָאָוֶן הַנִּתְלִים אֶצְלוֹ חֵרֵף אֹתוֹ לֵאמֹר הֲלֹא אַתָּה הַמָּשִׁיחַ הוֹשַׁע אֶת־נַפְשְׁךָ וְאֶת־נַפְשֵׁנוּ׃","40":"וַיַּעַן הָאַחֵר וַיִּגְעַר־בּוֹ לֵאמֹר הַאִם לֹא תִירָא אֶת־הָאֱלֹהִים אַחֲרֵי אֲשֶׁר־הָעֹנֶשׁ הַזֶּה הוּשַׁת גַּם־עָלֶיךָ׃","41":"אָכֵן עָלֵינוּ הוּשַׁת כַּמִּשְׁפָּט כִּי כְּמַעֲשֵׂה יָדֵינוּ הוּשַׁב לָנוּ אַךְ זֶה לֹא־עָשָׂה דָבָר רָע׃","42":"וַיֹּאמַר אֶל־יֵשׁוּעַ זָכְרֵנִי־נָא אֲדֹנִי כַּאֲשֶׁר תָּבֹא בְּמַלְכוּתֶךָ׃","43":"וַיֹּאמֶר יֵשׁוּעַ אֵלָיו אָמֵן אֲנִי אֹמֵר לְךָ הַיּוֹם תִּהְיֶה עִמִּי בְּגַן־עֵדֶן׃","44":"וַיְהִי כְּשָׁעָה הַשִּׁשִּׁית וְחֹשֶׁךְ כִּסָּה אֶת־פְּנֵי כָל־הָאָרֶץ עַד הַשָּׁעָה הַתְּשִׁיעִית׃","45":"הַשֶּׁמֶשׁ חָשָׁכָה וּפָרֹכֶת הַהֵיכַל נִקְרְעָה לִשְׁנַיִם קְרָעִים׃","46":"וַיִּקְרָא יֵשׁוּעַ בְּקוֹל גָּדוֹל וַיֹּאמַר בְּיָדְךָ אָבִי אַפְקִיד רוּחִי וּכְקָרְאוֹ כָזֹאת הוֹצִיא אֶת־נִשְׁמָתוֹ׃","47":"וְשַׂר־הַמֵּאָה רָאָה אֵת אֲשֶׁר נַעֲשָׂה וַיִּתֵּן כָּבוֹד לֵאלֹהִים לֵאמֹר אָכֵן צַדִּיק הָיָה הָאִישׁ הַזֶּה׃","48":"וְכָל־הֲמוֹן הָעָם אֲשֶׁר נִקְהֲלוּ לַמַּרְאֶה הַזֶּה אַחֲרֵי אֲשֶׁר רָאוּ אֵת אֲשֶׁר נַעֲשָׂה סָפְקוּ עַל־לִבָּם וַיָּשׁוּבוּ׃","49":"וְכָל־מְיֻדָּעָיו עָמְדוּ מֵרָחוֹק וְהַנָּשִׁים אֲשֶׁר הָלְכוּ אַחֲרָיו מִן־הַגָּלִיל רָאוּ אֶת־אֵלֶּה׃","50":"וַיְהִי אִישׁ אֶחָד וּשְׁמוֹ יוֹסֵף אִישׁ טוֹב וְצַדִּיק מִן־יֹעֲצֵי הַמְּדִינָה׃","51":"אֲשֶׁר לֹא נָטָה אַחֲרֵי עֲצָתָם וּמַעֲשֵׂיהֶם וְהוּא מִן־הָרָמָתַיִם עִיר־הַיְּהוּדִים וּמְחַכֶּה לְמַלְכוּת הָאֱלֹהִים׃","52":"הוּא בָא לִפְנֵי פִילָטוֹס וַיִּשְׁאַל מִמֶּנּוּ אֶת־גּוּפַת יֵשׁוּעַ׃","53":"וַיֹּרֶד אֹתוֹ וַיַּעֲטֵהוּ בְּתַכְרִיךְ־בַּד וַיִשִׂימֵהוּ בְּקֶבֶר חָצוּב בְּצוּר אֲשֶׁר עוֹד לֹא נִקְבַּר־בּוֹ אָדָם׃","54":"וְיוֹם עֶרֶב שַׁבָּת הָיָה וְהַשַּׁבַּת קָרַב וָבָא׃","55":"וְהַנָּשִׁים אֲשֶׁר בָּאוּ עִמּוֹ מִן־הַגָּלִיל הָלְכוּ אַחֲרָיו וַתִּרְאֶינָה אֶת־הַקֶּבֶר כַּאֲשֶׁר הוּשַׂם־בּוֹ גּוּפַת יֵשׁוּעַ׃","56":"וְאַחֲרֵי־כֵן שָׁבוּ וְהֵכִינוּ בְּשָׂמִים וּזְנִים מְרֻקָּחִים וּבַשַׁבָּת שָׁבְתוּ כַּמִּצְוָה׃"}}