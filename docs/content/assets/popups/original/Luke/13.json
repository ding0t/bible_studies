ֹמֵר לָכֶם לֹא־כֵן וְאִם אַתֶּם לֹא תָשׁוּבוּ כֻּלְכֶם כְּמוֹ־כֵן תֹּאבֵדוּ׃","4":"אוֹ שְׁמֹנָה עָשָׂר הָאֲנָשִׁים אֲשֶׁר נָפַל עֲלֵיהֶם הַמִּגְדָּל בִּשְׁלֹּחַ וָמֵתוּ הֲתַחְשְׁבוּ כִּי־אֲשֵׁמִים הָיוּ מִכָּל־ישְׁבֵי יְרוּשָׁלָיִם׃","5":"אֲנִי אֹמֵר לָכֶם לֹא־כֵן וְאִם אַתֶּם לֹא תָשׁוּבוּ כֻּלְּכֶם כְּמוֹ־כֵן תֹּאבֵדוּ׃","6":"וַיִּשָׂא מְשָׁלוֹ וַיֹּאמֶר אִישׁ אֶחָד הָיָה אֲשֶׁר־לוֹ תְאֵנָה נְטוּעָה בְכַרְמוֹ וַיָּבֹא לְבַקֵּשׁ אֶת־פִּרְיָהּ וְלֹא מָצָא׃","7":"וַיֹּאמֶר אֶל־הַכֹּרֵם הִנֵּה־זֶה שָׁלשׁ שָׁנִים בָּאתִי אֶל־הַתְּאֵנָה הַזֹּאת לְבַקֵּשׁ אֶת־פִּרְיָהּ וְלֹא מָצָאתִי כְּרֹת אֹתָהּ כִּי לָמָּה־זֶּה תַשְׁחִית אֶת־אַדְמָתִי׃","8":"וַיַּעַן וַיֹּאמֶר אֵלָיו אֲדֹנִי הַנַּח לָהּ עוֹד הַשָּׁנָה הַזֹּאת עַד כִּי־אֶעְדֹּר וְאֶתֵּן דֹּמֶן מִסָּבִיב לָהּ׃","9":"אוּלַי תַּעֲשֶׂה פְרִי בַּשָּׁנָה הַבָּאָה וְאִם־אַיִן תִּכְרֹת אֹתָהּ׃","10":"וַיְהִי בְּיוֹם הַשַּׁבָּת וַיְלַמֵּד בְּאַחַד בָּתֵּי־הַכְּנֵסֶת׃","11":"וְשָׁם אִשָּׁה אֲשֶׁר כִּהֲתָה רוּחָהּ וַתֶּחֱלַשׁ זֶה שְׁמֹנֶה עֶשְׂרֶה שָׁנָה וְהִיא כְפוּפָה וְאֵין סוֹמֵךְ וְאֵין זֹקֵף לָהּ׃","12":"וַיַּרְא אֹתָהּ יֵשׁוּעַ וַיִּקְרָא וַיֹּאמֶר אֵלֶיהָ אִשָּׁה הִנֵּה חֻלַּצְתְּ מֵחָלְיֵךְ׃","13":"וַיָּשֶׂם אֶת־יָדָיו עָלֶיהָ וַתְּמַהֵר וַתַּעֲמֹד בִּמְלֹא קוֹמָתָה וַתִּתֵּן כָּבוֹד לֵאלֹהִים׃","14":"אַךְ רֹאשׁ בֵּית־הַכְּנֵסֶת חָרָה־לוֹ כִּי רִפָּא יֵשׁוּעַ בְּיוֹם הַשַּׁבָּת וַיַּעַן וַיֹּאמֶר אֶל־הָעָם שֵׁשֶׁת יָמִים תֵּעָשֶׂה כָל־מְלָאכָה בָּאֵלֶּה בֹּאוּ וְהֵרָפְאוּ וְלֹא בְּיוֹם הַשַּׁבָּת׃","15":"וַיַּעַן הָאָדוֹן וַיֹּאמֶר אֵלָיו חֲנֵפִים הֲלֹא אִישׁ אִישׁ מִכֶּם יַתִּיר אֶת־שׁוֹרוֹ וְאֶת חֲמֹרוֹ מִן־הָאֵבוּס וְיוֹלִיכֶנּוּ לְהַשְׁקֹתוֹ בְּיוֹם הַשַּׁבָּת׃","16":"וּבַת־אַבְרָהָם זֹאת אֲשֶׁר אָסַר אֹתָהּ הַשָּׂטָן זֶה שְׁמֹנֶה עֶשְׂרֶה שָׁנָה לֹא תֻתַּר מֵאֲסוּרֶיהָ בְּיוֹם הַשַּׁבָּת׃","17":"וּמִדֵּי דַבְּרוֹ כָזֹאת חָפְרוּ כָּל־מִתְקוֹמְמָיו וַיִּשְׂמַח כָּל־הָעָם עַל־כָּל־הַגְּדֹלוֹת אֲשֶׁר עָשְׂתָה יָדוֹ׃","18":"וַיֹּאמֶר מַה־דְּמוּת לְמַלְכוּת הָאֱלֹהִים וּמָה אַשְׁוֶה לָהּ׃","19":"דִּמְיוֹנָהּ כְּגַרְגַּר חַרְדָּל אֲשֶׁר לָקַח אִישׁ וַיִּתְּנֵהוּ בְגַנּוֹ וַיִּצְמַח וַיְהִי לְעֵץ גָּדוֹל עַד־אֲשֶׁר עוֹף הַשָּׁמַיִם קִנְּנוּ בַּעֲנָפָיו׃","20":"וַיּוֹסֶף וַיֹּאמַר מַה־דְּמוּת לְמַלְכוּת הָאֱלֹהִים׃","21":"דִּמְיוֹנָהּ כִּשְׂאֹר אֲשֶׁר לָקְחָה אִשָּׁה וַתָּלָשׁ בִּשְׁלשׁ סְאִים קֶמַח עַד־אֲשֶׁר חָמְצָה כָּל־הָעֲרִיסָה׃","22":"וַיַעֲבֹר דֶּרֶךְ עָרִים וּכְפָרִים עָבוֹר וְלַמֵּד וְנָסוֹעַ יְרוּשָׁלָיְמָה׃","23":"וַיִּשְׁאָלֵהוּ אִישׁ לֵאמֹר אֲדֹנִי הֲרַק מְתֵי מִסְפָּר יִוָּשֵׁעוּ׃","24":"וַיֹּאמֵר אֲלֵיהֶם הִתְאַמְּצוּ לָבֹא בַּשַּׁעַר הַצָּר כִּי אֲנִי אֹמֵר לָכֶם רַבִּים יְבַקְשׁוּ וְלֹא יוּכְלוּ לָבֹא׃","25":"בָּעֵת הַהִיא אֲשֶׁר יָקוּם אֲדֹנֵי הַבַּיִת וְסָגַר אֶת־הַדָּלֶת וְאַתֶּם תָּבֹאוּ וְתַעַמְדוּ מִחוּץ מִתְדַּפְּקִים עַל־הַדֶּלֶת לֵאמֹר אֲדֹנֵינוּ פְּתַח־לָנוּ וְהוּא יַעֲנֶה וְיֹאמַר לֹא יָדַעְתִּי אֶתְכֶם אֵי־מִזֶּה אַתֶּם׃","26":"אָז תָּחֵלּוּ לֵאמֹר הֲלֹא אָכַלְנוּ וְשָׁתִינוּ לְפָנֶיךָ וּבִרְחֹבֹתֵינוּ הוֹרֵיתָ לָּנוּ תּוֹרָה׃","27":"וְהוּא יַעֲנֶה הֵן אֲנִי אֹמֵר לָכֶם לֹא יָדַעְתִּי אֵי־מִזֶּה אַתֶּם סוּרוּ מִמֶּנִּי כָּל־פֹּעֲלֵי אָוֶן׃","28":"וְאָז יִהְיֶה בְכִי וַחֲרֹק שִׁנָּיִם כִּי תִרְאוּ אַבְרָהָם וְיִצְחָק וְיַעֲקֹב וְכָל־הַנְּבִיאִים בְּמַלְכוּת הָאֱלֹהִים וְאַתֶּם נִדָּחִים תִּהְיוּ מִחוּץ׃","29":"וּמִמִּזְרָח וּמִמַּעֲרָב וּמִצָּפוֹן וּמִיָּם יָבֹאוּ וְיֵשְׁבוּ עִמָּם בְּמַלְכוּת הָאֱלֹהִים׃","30":"וְהִנֵּה יֵשׁ אַחֲרֹנִים אֲשֶׁר יִהְיוּ רִאשֹׁנִים וְרִאשֹׁנִים אֲשֶׁר יִהְיוּ אַחֲרֹנִים׃","31":"בַּשָּׁעָה הַהִיא בָּאוּ מִקְצוֹת הַפְּרוּשִׁים וַיֹּאמְרוּ אֵלָיו צֵא וְלֵךְ מִזֶּה כִּי הוֹרְדוֹס מְבַקֵּשׁ לְהָרְגֶךָ׃","32":"וַיֹּאמֶר אֲלֵיהֶם לְכוּ וְהַגִּידוּ לַשּׁוּעָל הַזֶּה הִנְנִי מְגָרֵשׁ רוּחוֹת רָעוֹת וְרֹפֵא חוֹלִים הַיּוֹם וּבְיוֹם מָחָר וּבַיּוֹם הַשְּׁלִישִׁי אָבֹא עַד־קִצִּי׃","33":"אַךְ הָלוֹךְ אֵלֵךְ הַיּוֹם וּלְיוֹם מָחָר וּלְיוֹם הַבָּא אַחֲרָיו כִי כֵן לֹא־יֵעָשֶׂה כִּי נָבִיא יֹאבַד מִחוּץ לִירוּשָׁלָיִם׃","34":"יְרוּשָׁלַיִם יְרוּשָׁלַיִם הַהֹרֶגֶת אֶת־הַנְּבִיאִים וְהַסֹּקֶלֶת אֶת־הַשְּׁלוּחִים אֵלָיִךְ עַד־כַּמֶּה פְעָמִים חָפַצְתִּי לְקַבֵּץ אֶת־בָּנַיִךְ כַּאֲשֶׁר תְּקַבֵּץ תַּרְנְגֹלֶת אֶת־אֶפְרֹחֶיהָ תַּחַת כְּנָפֶיהָ וְלֹא אֲבִיתֶם׃","35":"הִנֵּה בֵּיתְכֶם יִשָּׁאֵר לָכֵם חָרְבָּה וַאֲנִי אָמֵן אֹמֵר לָכֶם כִּי לֹא תִרְאֻנִי עוֹד עַד כִּי־תֹאמְרוּן בָּרוּךְ הַבָּא בְּשֵׁם יְהוָֹה׃"},"q":{"35":[["Ps 118:26","117:26","Εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου· εὐλογήκαμεν ὑμᾶς ἐξ οἴκου Κυρίου.",[0,1,2,3,4,5]],[null,null,null,[17,18,19,20,21,22]]]}}