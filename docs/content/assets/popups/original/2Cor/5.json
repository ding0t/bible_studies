וֹ בִּבְשָׂרוֹ אִם־טוֹב וְאִם־רָע׃","11":"וְאַחֲרֵי אֲשֶׁר יִרְאַת יְהוָֹה לְנֶגֶד עֵינֵינוּ נְפַתֶּה אֶת־בְּנֵי הָאָדָם לְיִרְאָה אֹתוֹ וּבְיִשְׁרַת לְבָבֵנוּ יְדֻעִים אֲנַחְנוּ לֵאלֹהִים אוֹחִילָה כִי כֵן יְדֻעִים אֲנַחְנוּ גַּם־לָכֶם׃","12":"וְלֹא בָאנוּ בְזֹאת לְרוֹמֵם נַפְשֵׁנוּ לִפְנֵיכֶם עוֹד הַפָּעַם כִּי אִם־לָשִׂים לָכֶם יָדַיִם לְהִתְפָּאֵר בָּנוּ וְלָתֵת לָכֶם פִּתְחוֹן פֶּה נֶגֶד הַמִּתְפָּאֲרִים לָעֵינַיִם וְלַלֵּבָב אֵין מְאוּמָה׃","13":"וְאַף אִם־נֶחְשַׁבְנוּ כְמִשְׁתּוֹלְלִים כֵּן הָיִינוּ לֵאלֹהִים וְאִם כִּמְחֻכָּמִים כֵּן הָיִינוּ לָכֶם׃","14":"כִּי־אַהֲבַת הַמָּשִׁיחַ חָזְקָה עָלֵינוּ לְהוֹצִיא מִשְׁפָּט כָּזֶה אִם־אֶחָד מֵת בְּעַד כֻּלָּם אָז כֻּלָּם כְּמֵתִים נֶחְשָׁבוּ׃","15":"וְהוּא מֵת בְּעַד כֻּלָּם לְמַעַן יִחְיוּ כֻלָּמוֹ לֹא לְנַפְשָׁם כִּי אִם־לוֹ אֲשֶׁר מֵת וְקָם בַּעֲדָם׃","16":"עַל־כֵּן מֵעַתָּה לֹא־נֵדַע עוֹד אִישׁ לְפִי בְשָׂרוֹ וְאַף הַמָּשִׁיחַ אִם־יְדַעֲנֻהוּ לְפִי בְּשָׂרוֹ לֹא־נֵדָעֵהוּ עוֹד עָתָּה׃","17":"כִּי מִי לַמָּשִׁיחַ בְּרִיאָה חֲדָשָׁה הוּא קַדְמֹנִיּוֹת חָלְפוּ וְהִנֵּה הַכֹּל חָדָשׁ הוּא׃","18":"וכָל־זֹאת מִיַּד אֱלֹהִים אֲשֶׁר נְתָנָנוּ לְהִתְרַצּוֹת אֵלָיו בַּמָּשִׁיחַ וַעֲבֹדַת הַסְּלִיחָה הַזֹּאת שָׂם עָלֵינוּ׃","19":"כִּי הֵן אֱלֹהִים הָיָה בְּיֵשׁוּעַ הַמָּשִׁיחַ לִסְלֹחַ לִבְנֵי הָעוֹלָם וְלֹא־לִזְכֹּר לָהֶם אֶת־חַטֹּאתֵיהֶם וְתוֹרַת הַסְּלִיחָה הַזֹּאת הִפְקִיד בְּיָדֵינוּ׃","20":"וְאִם כֵּן אֵפוֹא מְלִיצֵי הַמָּשִׁיחַ אֲנָחְנוּ כְּמוֹ אִם־אֱלֹהִים מִתְחַנֵּן אֲלֵיכֶם עַל־פִּינוּ אֲנַחְנוּ מְחַלִּים אֶת־פְּנֵיכֶם בְּשֵׁם הַמָּשִׁיחַ הִתְרַצּוּ־נָא אֶל־הָאֱלֹהִים׃","21":"הוּא אֲשֶׁר לֹא־יָדַע חַטָּאת אֹתוֹ עָשָׂה לְחַטָּאת בַּעֲדֵנוּ לְמַעַן נִהְיֶה אֲנַחְנוּ בוֹ לְצִדְקַת אֱלֹהִים׃"}}