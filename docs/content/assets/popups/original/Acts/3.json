ִישׁ פִּסֵּחַ מִבֶּטֶן אִמּוֹ הוּבָא שָׁמָּה אֲשֶׁר הוֹשִׁיבֻהוּ יוֹם יוֹם לִפְנֵי שַׁעַר הַהֵיכָל הַנִּקְרָא שַׁעַר הַתִּפְאֶרֶת לְבַקֵּשׁ נְדָבוֹת מִיַּד בָּאֵי הַהֵיכָל׃","3":"וּבִרְאֹתוֹ אֶת־פֶּטְרוֹס וְאֵת־יוֹחָנָן בָּאִים אֶל־הַהֵיכָל וַיְבַקֵּשׁ מִיָּדָם נְדָבָה׃","4":"וַיָּשֶׂם פֶּטְרוֹס אֶת־עֵינָיו עָלָיו וְכֵן גַּם־יוֹחָנָן וַיֹּאמַר הַבִּיטָה אֵלֵינוּ׃","5":"וַיִּפֶן אֲלֵיהֶם בְּתֹחַלְתּוֹ כִּי יַשִּׂיג מִיָּדָם מְאוּמָה׃","6":"וַיֹּאמֶר פֶּטְרוֹס כֶּסֶף וְזָהָב אֵין־לִי אֲבָל אֵת אֲשֶׁר בְּיָדִי אֶתֶּן־לָךְ בְּשֵׁם־יֵשׁוּעַ הַמָּשִׁיחַ הַנָּצְרִי קוּם וְהִתְהַלֵּךְ׃","7":"וַיֶּאֱחֹז בְּיַד יְמִינוֹ וַיְקִימֵהוּ וּפִתְאֹם הִתְחַזְּקוּ רַגְלָיו וְקַרְסֻלָּיו׃","8":"וַיְדַלֵּג מִתַּחְתָּיו וַיַּעֲמֹד וַיִּתְהַלֵּךְ וַיָּבֹא עִמָּהֶם אֵל־הַהֵיכָל הוֹלֵךְ וּמְדַלֵּג וּמְשִׁבֵּחַ אֶת־הָאֱלֹהִים׃","9":"וַיִּרְאֵהוּ כָל־הָעָם מִתְהַלֵּךְ וּמְשַׁבֵּחַ אֶת־הָאֱלֹהִים׃","10":"וַיַּכִּירוּ אֹתוֹ כִּי הוּא זֶה הַיּשֵׁב לִפְנֵי הַהֵיכָל לִפְנֵי שַׁעַר הַתִּפְאֶרֶת לְבַקֵּשׁ נְדָבוֹת וַיִּמָּלְאוּ תִמָּהוֹן וּפַלָּצוּת עַל־אֲשֶׁר נַעֲשָׂה לּוֹ׃","11":"וְהוּא כִי דָבַק אַחֲרֵי פֶטְרוֹס וְיוֹחָנָן וְכָל־הָעָם רָצוּ אֲלֵיהֶם אֶל־הָאוּלָם הַנִּקְרָא אוּלָם שְׁלֹמֹה וַיָּשֹׁמּוּ עַד־מְאֹד׃","12":"וַיַּרְא פֶּטְרוֹס וַיַּעַן וַיֹּאמֶר אֶל־הָעָם אַנְשֵׁי יִשְׂרָאֵל לָמָּה תִשְׁתּוֹמְמוּ עַל־זֹאת וְלָמָּה תַבִּיטוּ אֵלֵינוּ כְּאִלּוּ הוּא מִתְהַלֵּךְ בְּכֹחֵנוּ אוֹ בְצִדְקָתֵנוּ׃","13":"אֱלֹהֵי אַבְרָהָם יִצְחָק וְיַעֲקֹב אֱלֹהֵי אֲבוֹתֵינוּ הִגְדִּיל כְּבוֹד יֵשׁוּעַ עַבְדּוֹ אֲשֶׁר אַתֶּם הִסְגַּרְתֶּם אֹתוֹ וְכִחַשְׁתֶּם בּוֹ לִפְנֵי פִילָטוֹס כַּאֲשֶׁר שָׁפַט לְשַׁלְּחוֹ לַחָפְשִׁי׃","14":"וְאַתֶּם כִּחַשְׁתֶּם בַּקָּדוֹשׁ וּבַצַדִּיק וּשְׁאֶלְתֶּם כִּי־יֻחַן לָכֶם אִישׁ רֹצֵחַ׃","15":"וְאֶת־שַׂר הַחַיִּים הֲרַגְתֶּם אֲשֶׁר אֱלֹהִים הֵקִים אֹתוֹ מִן־הַמֵּתִים וַאֲנַחְנוּ עֵדָיו׃","16":"וּבֶאֱמוּנָתֵנוּ בִשְׁמוֹ שְׁמוֹ נָתַן כֹּחַ לָאִישׁ הַזֶּה אֲשֶׁר אַתֶּם רֹאִים וּמַכִּירִים כִּי עַל־יָדוֹ נָתְנָה־לּוֹ אֱמוּנָתֵנוּ מַרְפֵּא לְעַצְמוֹתָיו לְעֵינֵי כֻלְּכֶם׃","17":"וְעַתָּה אֶחָי יָדַעְתִּי כִּי בִּבְלִי־דַעַת עֲשִׂיתֶם גַּם־אַתֶּם גַּם־שָׂרֵיכֶם׃","18":"אֲבָל הַדָּבָר כִּי יְעֻנֶּה הַמָּשִׁיחַ הֵקִים אֱלֹהִים כַּאֲשֶׁר הִגִּיד מִקֶּדֶם בְּיַד־כָּל־נְבִיאָיו׃","19":"עַל־כֵּן שׁוּבוּ סוּרוּ מִדַּרְכֵיכֶם לְמַעַן תִּמָּחֶינָה חַטֹּאתֵיכֶם וְתָבֹאנָה עִתּוֹת מְשִׁיבוֹת נֶפֶשׁ מִלִּפְנֵי יְהוָֹה׃","20":"וְיִשְׁלַח אֶת־יֵשׁוּעַ מְשִׁיחוֹ אֲשֶׁר מְבֻשָׂר לָכֶם מִקֶּדֶם׃","21":"אֲשֶׁר יְקַבְּלֵהוּ זְבוּל הַשָּׁמַיִם עַד־אֲשֶׁר יָשׁוּב הַכֹּל עַל־מְכוֹנוֹ כַּאֲשֶׁר דִּבֶּר אֱלֹהִים בְּיַד־נְבִיאָיו הַקְּדוֹשִׁים מִימוֹת עוֹלָם׃","22":"הֵן משֶׁה אָמַר אֶל־אֲבוֹתֵינוּ נָבִיא מִקֶּרֶב אֲחֵיכֶם כָּמֹנִי יָקִים לָכֶם יְהוָֹה אֱלֹהִים אֵלָיו תִּשְׁמְעוּן כְּכֹל אֲשֶׁר יְדַבֵּר אֲלֵיכֶם׃","23":"וְהָיָה כָּל־הַנֶּפֶשׁ אֲשֶׁר לֹא־תִשְׁמַע אֶל־הַנָּבִיא הַהוּא וְנִכְרְתָה מֵעַמֶּיהָ׃","24":"וְגַם כָּל־הַנְּבִיאִים מִשְּׁמוּאֵל וְהַבָּאִים אַחֲרָיו אֲשֶׁר נִבָּאוּ כֻּלָּם הִגִּידוּ דִּבְרֵי הַיָּמִים הָאֵלֶּה׃","25":"אַתֶּם בְּנֵי הַנְּבִיאִים וְהַבְּרִית אֲשֶׁר כָּרַת אֱלֹהִים עִם־אֲבוֹתֵיכֶם לֵאמֹר אֶל־אַבְרָהָם וְנִבְרְכוּ בְזַרְעֲךָ כֹּל מִשְׁפְּחוֹת הָאֲדָמָה׃","26":"וְלָכֶם הֵקִים אֱלֹהִים אֶת־עַבְדּוֹ יֵשׁוּעַ רִאשֹׁנָה וַיִּשְׁלָחֵהוּ לְבָרֵךְ אֶתְכֶם כִּי תָשׁוּבוּ אִישׁ אִישׁ מֵעֲוֹנֹתֵיכֶם׃"}}