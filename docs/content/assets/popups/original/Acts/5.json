 בְיָדֶךָ לָמָּה מְלָאֲךָ לִבְּךָ לַעֲשׂוֹת כֵּן לֹא בַאֲנָשִׁים שִׁקַּרְתָּ כִּי אִם־בֵּאלֹהִים׃","5":"כִּשְׁמֹעַ חֲנַנְיָה אֶת־הַדְּבָרִים הָאֵלֶּה וַיִּפֹּל אַרְצָה וַתֵּצֵא נִשְׁמָתוֹ וְיִרְאָה גְדוֹלָה נָפְלָה עַל כָּל־הַשֹּׁמְעִים׃","6":"וַיָּקוּמוּ הַנְּעָרִים וַיַּאַסְפוּ אֹתוֹ וַיֹּצִיאֻהוּ וַיִּקְבְּרֻהוּ׃","7":"וַיְהִי כְּמִשְׁלֹש שָׁעוֹת וַתָּבוֹא אִשְׁתּוֹ וְלֹא יָדְעָה אֵת אֲשֶׁר נַעֲשָׂה׃","8":"וַיַּעַן פֶּטְרוֹס וַיֹּאמֶר אֵלֶיהָ הַגִּידִי־לִי הַבְעַד כֶּסֶף זֶה מְכַרְתֶּם אֶת־הַשָּׂדֶה וַתֹּאמֶר הֵן בְּעַד כֶּסֶף זֶה׃","9":"וַיֹּאמֶר אֵלֶיהָ פֶּטְרוֹס לָמָּה־זֶּה קְשַׁרְתֶּם יַחַד לְנַסּוֹת אֶת־רוּחַ יְהוָֹה הִנֵּה רַגְלֵי הַמְקַבְּרִים אֶת־אִישֵׁךְ בַּפֶּתַח וּנְשָׂאוּךְ גַּם־אוֹתֵךְ הַחוּצָה׃","10":"וַתִּפֹּל פִּתְאֹם לְרַגְלָיו וַתֵּצֵא נִשְׁמָתָהּ וַיָּבֹאוּ הַנְּעָרִים וַיִּמְצָאֻהָ כִּי מֵתָה וַיּוֹצִיאוּ אֹתָהּ וַיִּקְבְּרֻהָ אֵצֶל אִישָׁהּ׃","11":"וַתְּהִי יִרְאָה גְדוֹלָה עַל כָּל־הַקָּהָל וְעַל כָּל־הַשֹּׁמְעִים אֶת־הַדָּבָר הַזֶּה׃","12":"וְאֹתוֹת וּמוֹפְתִים רַבִּים נַעֲשׂוּ בְּקֶרֶב הָעָם עַל־יְדֵי הַשְּׁלִיחִים וַיִּקָּהֲלוּ כֻלָּם בְּלֵב אֶחָד בְּאוּלָם שְׁלֹמֹה׃","13":"וּמִשְּׁאָר הָאֲנָשִׁים אֵין אִישׁ אֲשֶׁר מְלָאוֹ לִבּוֹ לְדָבְקָה־בָּם אַךְ־יָקְרוּ בְּעֵינֵי הָעָם׃","14":"וּמַאֲמִינִים רַבִּים נִסְפְּחוּ עַל־הָאָדוֹן הֲמוֹן אֲנָשִׁים וְנָשִׁים׃","15":"עַד כִּי־נָשְׂאוּ אֶת־הַחוֹלִים אֶל־הָרְחֹבוֹת וְהִשְׁכִּיבוּם בְּמִטוֹת וּמִשְׁכָּבוֹת בְּאָמְרָם כִּי פֶטְרוֹס יַעֲבֹר שָׁמָּה וְצִלּוֹ יִנָּטֶה עַל־אֲחָדִים מֵהֶם׃","16":"וְגַם־הֲמוֹן עָם מִן־הֶעָרִים אֲשֶׁר מִסָּבִיב לִירוּשָׁלָיִם נָהֲרוּ וַיָּבִיאוּ אֶת־הַחוֹלִים וְאֶת־הַנַּעֲנִים תַּחַת יְדֵי רוּחוֹת טְמֵאוֹת וְכֻלָּם נִרְפָּאוּ׃","17":"וַיָּקָם הַכֹּהֵן הַגָּדוֹל וְכָל־הַנִּלְוִים עָלָיו וְהֵם מֵעֲדַת הַצַּדּוּקִים וַיִּמָּלְאוּ קִנְאָה׃","18":"וַיִּשְׁלְחוּ אֶת־יְדֵיהֶם בַּשְּׁלִיחִים וַיִּתְּנוּם בְּמִשְׁמַר הַקָּהַל׃","19":"וַיְהִי בַלַּיְלָה וַיִּפְתַּח מַלְאַךְ יְהוָֹה אֶת־דַּלְתֵי בֵית־הַכֶּלֶא וַיּוֹצִיאֵם וַיֹּאמַר׃","20":"לְכוּ וְעִמְדוּ בַהֵיכָל וְדַבְּרוּ אֶל־הָעָם אֶת־כָּל־דִּבְרֵי הַחַיִּים הָאֵלֶּה׃","21":"וַיִּשְׁמְעוּ וַיַּשְׁכִּימוּ בַבֹּקֶר וַיָּבֹאוּ אֶל־הַהֵיכָל וַיְלַמֵּדוּן וַיָּבֹא הַכֹּהֵן הַגָּדוֹל וַאֲשֶׁר אִתּוֹ וַיַּקְהִלוּ אֶת־הַסַּנְהֶדְרִין וְאֶת־כָּל־זִקְנֵי בְנֵי יִשְׂרָאֵל וַיִּשְׁלְחוּ לְהָבִיא אֹתָם מִבֵּית הַכֶּלֶא׃","22":"וְהַמְשָׁרְתִים בָּאוּ וְלֹא מְצָאוּם בְּבֵית הַכֶּלֶא וַיָּשֻׁבוּ וַיַּגִּידוּ לֵאמֹר׃","23":"מָצָאנוּ אֶת־בֵּית הַכֶּלֶא סָגוּר וּמְסֻגָּר וְאֶת־הַשֹּׁמְרִים עֹמְדִים עַל־מִשְׁמַרְתָּם לִפְנֵי הַשְּׁעָרִים וַנִּפְתַּח וַנֵּרֶא וְאֵין אָדָם בַּבַּיִת פְּנִימָה׃","24":"וְהַכֹּהֵן וְשַׂר צְבָא הַהֵיכָל וְרָאשֵׁי הַכֹּהֲנִים בְּשָׁמְעָם אֶת־הַדְּבָרִים הָאֵלֶּה נָבֹכוּ עַד־מְאֹד לֵאמֹר מַה־יִּהְיֶה מִכָּל־אֵלֶּה׃","25":"אָז בָּא אִישׁ אֶחָד וְהִגִּיד לָהֶם לֵאמֹר הָאֲנָשִׁים אֲשֶׁר נְתַתֶּם בְּבֵית הַכֶּלֶא הִנָּם עֹמְדִים בַּהֵיכָל וּמוֹרִים אֶת־הָעָם׃","26":"וַיֵּלֶךְ שַׂר הַצָּבָא עִם־מְשָׁרְתָיו וַיִּקָּחֵם אַךְ־לֹא בְחָזְקָה כִּי יָרְאוּ מִפְּנֵי הָעָם פֶּן יִסָּקֵלוּ׃","27":"וַיָּבִיאוּ אֹתָם וַיַּעֲמִידוּם לִפְנֵי הַסַּנְהֶדְרִין וַיִּשְׁאַל אֹתָם הַכֹּהֵן הַגָּדוֹל לֵאמֹר׃","28":"הֲלֹא צַוֹּה צִוִּינוּ עֲלֵיכֶם לְבִלְתִּי הוֹרֹת בַּשֵּׁם הַזֶּה וְאַתֶּם הִנֵּה מִלֵּאתֶם אֶת־יְרוּשָׁלַיִם תּוֹרַת פִּיכֶם וּבִקַּשְׁתֶּם לְהָבִיא עָלֵינוּ דַּם הָאִישׁ הַזֶּה׃","29":"וַיַּעַן פֶּטְרוֹס וְהַשְּׁלִיחִים וַיֹּאמְרוּ הֲלֹא עָלֵינוּ לִשְׁמֹעַ אֶל־מִצְוַת אֱלֹהִים מִשְּׁמֹעַ אֶל־מִצְוַת אֲנָשִׁים׃","30":"אֱלֹהֵי אֲבוֹתֵינוּ הֵקִים אֶת־יֵשׁוּעַ אֲשֶׁר שְׁלַחְתֶּם בּוֹ יָד וַתִּתְלוּ אֹתוֹ עַל־הָעֵץ׃","31":"אֹתוֹ הֵרִים אֱלֹהִים בִּימִינוֹ לְשַׂר וּלְמוֹשִׁיעַ לְיִשְׂרָאֵל לְהָשִׁיב אֶת־לִבָּם וְלִסְלוֹחַ לָהֶם אֶת־חַטֹּאתֵיהֶם׃","32":"וַאֲנַחְנוּ עֵדִים וְכֵן רוּחַ הַקֹּדֶשׁ אֲשֶׁר חָלַק אֱלֹהִים לְשֹׁמְעָיו עֵד עַל־הַדְּבָרִים הָאֵלֶּה׃","33":"וַיְהִי כְשָׁמְעָם וַיִּגַּע הַדָּבָר עַד־נַפְשָׁם וַיִתְנַכְּלוּ אֹתָם לַהֲמִיתָם׃","34":"וַיָּקָם אֶחָד מִן־הַפְּרוּשִׁים מִקֶּרֶב הַסַּנְהֶדְרִין וּשְׁמוֹ גַּמְלִיאֵל מוֹרֵה הַתּוֹרָה וְנִכְבָּד בְּעֵינֵי כָל־הָעָם וַיְצַו לְהוֹצִיא אֶת־הַשְּׁלִיחִים מִלִּפְנֵיהֶם מְעַט מִזְעָר׃","35":"וַיֹּאמֶר אֲלֵיהֶם אַנְשֵׁי יִשְׂרָאֵל הִשָּׁמְרוּ לָכֶם בָּאֲשֶׁר אַתֶּם אֹמְרִים לַעֲשׂוֹת לָאֲנָשִׁים הָאֵלֶּה׃","36":"כִּי לִפְנֵי הַיָּמִים הָאֵלֶּה קָם תּוֹדָס אֲשֶׁר הִתְנַשֵּׂא לֵאמֹר אֲנִי הוּא הַגָּבֶר וּכְאַרְבַּע מֵאוֹת אִישׁ הִתְלַקְּטוּ אֵלָיו עַד אֲשֶׁר־נֶהֱרָג וְכָל־הַנִּלְוִים עָלָיו נָפֹצוּ וְהָיוּ כְּלֹא הָיוּ׃","37":"וְאַחֲרָיו קָם יְהוּדָה הַגְּלִילִי בִּימֵי הַמִּפְקָד אֲשֶׁר הִדִּיחַ עַם־רָב אַחֲרָיו וְגַם־הוּא נָפַל וְכָל־הַנִּלְוִים עָלָיו נִפְזָרוּ׃","38":"וְעַתָּה אֲנִי אֹמֵר אֲלֵיכֶם חִדְלוּ לָכֶם מִן־הָאֲנָשִׁים הָאֵלֶּה וְהַנִּיחוּ לָהֶם כִּי אִם־מֵאָדָם יָצְאָה הָעֵצָה וְהַפְּעֻלָּה הַזֹּאת הוּפֵר תּוּפָר׃","39":"וְאִם־מֵאֵת אֱלֹהִים יָצְאָה לֹא תוּכְלוּ לַהֲפִירָהּ פֶּן־תִּמָּצְאוּ נִלְחָמִים בֵּאלֹהִים׃","40":"וַיִּשְׁמְעוּ בְקוֹלוֹ וַיִּקְרְאוּ אֶל־הַשְּׁלִיחִים וְאַחֲרֵי אֲשֶׁר יִסְּרוּ אֹתָם וְצִוּוּ עֲלֵיהֶם לְבִלְתִּי דַבֵּר עוֹד בְּשֵׁם יֵשׁוּעַ שִׁלְּחוּם לְדַרְכָּם׃","41":"וְהֵם יָצְאוּ שְׂמֵחִים מִלִּפְנֵי הַסַּנְהֶדְרִין עַל־כִּי נֶחְשְׁבוּ רְאוּיִם לָשֵׂאת חֶרְפָּה עַל־שְׁמוֹ׃","42":"וְלֹא חָדְלוּ יוֹם יוֹם לְלַמֵּד בְּבֵית הַמִּקְדַּשׁ אוֹ בְּבָתֵּי אֲנָשִׁים וּלְבַשֵּׂר בְּשׂוֹרַת יֵשׁוּעַ הַמָּשִׁיחַ׃"}}