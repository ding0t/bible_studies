"X-NSM",0,"tis"],["ὥρισαν","G3724","V-AAI-3P","decided","hōrisan",49,56],["ἕκαστος","G1538","A-NSM","each","hekastos",18,22],["αὐτῶν","G846","P-GPM",0,"autōn"],["εἰς","G1519","PREP",0,"eis"],["διακονίαν","G1248","N-ASF","relief","diakonian",65,71],["πέμψαι","G3992","V-AAN","to send","pempsai",57,64],["τοῖς","G3588","T-DPM","to the","tois",72,78],["κατοικοῦσιν","G2730","V-PAP-DPM","living","katoikousin",88,94],["ἐν","G1722","PREP","in","en",95,97],["τῇ","G3588","T-DSF",0,"tē"],["Ἰουδαίᾳ","G2449","N-DSF","Judea","Ioudaia",98,103],["ἀδελφοῖς·","G80","N-DPM","brothers","adelphois",79,87]],"30":[["ὃ","G3739","R-ASN","This","ho",0,4],["καὶ","G2532","CONJ",0,"kai"],["ἐποίησαν","G4160","V-AAI-3P","they did","epoiēsan",5,13],["ἀποστείλαντες","G649","V-AAP-NPM","sending [their gifts]","aposteilantes",15,34],["πρὸς","G4314","PREP","to","pros",35,37],["τοὺς","G3588","T-APM","the","tous",38,41],["πρεσβυτέρους","G4245","A-APM-C","elders","presbyterous",42,48],["διὰ","G1223","PREP","with","dia",49,53],["χειρὸς","G5495","N-GSF",0,"cheiros"],["Βαρνάβα","G921","N-GSM","Barnabas","Barnaba",54,62],["καὶ","G2532","CONJ","and","kai",63,66],["Σαύλου.","G4569","N-GSM","Saul","Saulou",67,71]]},"s":{"1":"וְהַשְּׁלִיחִים וְהָאַחִים אֲשֶׁר בִּיהוּדָה שָׁמְעוּ כִּי גַּם־הַגּוֹיִם קִבְּלוּ אֶת־דְּבַר הָאֱלֹהִים׃","2":"וּפֶטְרוֹס בָּא יְרוּשָׁלָיִם וַיַּלִּינוּ עָלָיו הַנִּמּוֹלִים לֵאמֹר׃","3":"בֵּית אֲנָשִׁים עֲרֵלִים בָּאתָ וַתִּתְעָרֶב־בָּם לֶאֱכֹל אִתָּם לָחֶם׃","4":"וַיָּחֶל פֶּטְרוֹס וַיְסַפֵּר לָהֶם דָּבָר דָּבָר עַל־אָפְנָיו לֵאמֹר׃","5":"מִתְפַּלֵּל הָיִיתִי בְּעִיר יָפוֹ וַתִּפֹּל עָלַי הָרוּחַ וָאֵרֶא בַמַּחֲזֶה וְהִנֵּה־תֵבָה אַחַת כִּירִיעָה גְדוֹלָה קְשׁוּרָה בְּאַרְבַּע כַּנְפוֹתֶיהָ יֹרֶדֶת מִן־הַשָּׁמַיִם וַתָּבֹא עָדָי׃","6":"וָאֵפֶן לְהַבִּיט וָאָבִין וָאֵרֶא בָהּ בֶּהֱמַת הָאָרֶץ וְחַיַּת הַשָּׂדֶה הַהֹלְכֹת עַל־אַרְבַּע וְרֶמֶשׂ הָאֲדָמָה וְעוֹף הַשָּׁמָיִם׃","7":"וָאֶשְׁמַע גַּם־קוֹל מֵדַּבֵּר אֵלַי קוּם כֵּיפָא זְבַח וֶאֱכֹל׃","8":"וָאֹמַר חָלִילָה לִּי אֲדֹנִי כִּי מֵעוֹדִי לֹא־בָא אֶל־פִּי בְּשַׂר פִּגּוּל אוֹ שֶׁקֶץ טָמֵא׃","9":"וַיַּעַן הַקּוֹל שֵׁנִית מִן־הַשָּׁמָיִם אֶת־אֲשֶׁר טִהַר הָאֱלֹהִים לֹא תְשַׁקֵּץ אָתָּה׃","10":"וְהַחִזָּיוֹן הַזֶּה נִרְאָה אֵלַי שָׁלֹשׁ פְּעָמִים וְאַחֲרֵי־כֵן הוּרַם הַכֹּל וַיַּעַל הַשָּׁמָיְמָה׃","11":"וְכִמְעַט רֶגַע וְהִנֵּה שְׁלֹשָׁה אֲנָשִׁים עֹמְדִים עַל־פֶּתַח הַבַּיִת אֲשֶׁר הָיִינוּ שָׁם כִּי נִשְׁלְחוּ אֵלַי מִקִּסְרִין׃","12":"וְהָרוּחַ דִּבֶּר בִּי לָלֶכֶת אִתָּם וְלֹא לִפְסֹחַ הֵנָּה וָהֵנָּה וַיֵּלְכוּ אִתִּי גַּם־שֵׁשֶׁת הָאַחִים הָאֵלֶּה וַנָּבֹא אֶל־בֵּית הָאִישׁ׃","13":"וַיַּגֶּד־לָנוּ אֵת אֲשֶׁר־רָאָה מַלְאָךְ נִצָּב בְּבֵיתוֹ אֲשֶׁר צִוָּה אֹתוֹ לֵאמֹר שְׁלַח אֶל־יָפוֹ וּקְרָא אֵלֶיךָ אֶת־שִׁמְעוֹן הַמְכֻנֶּה כֵּיפָא׃","14":"וְהוּא יְדַבֵּר אֵלֶיךָ דְּבָרִים אֲשֶׁר תִּוָּשַׁע בָּם אַתָּה וְכָל־בֵּיתֶךָ׃","15":"וְכַאֲשֶׁר הַחִלֹּתִי לְדַבֵּר וַתִּצְלַח עֲלֵיהֶם רוּחַ הַקֹּדֶשׁ כַּאֲשֶׁר צָלְחָה עָלֵינוּ בַּתְּחִלָּה׃","16":"וָאֶזְכֹּר אֶת־דְּבַר הָאָדוֹן אֲשֶׁר אָמָר יוֹחָנָן טִבֵּל בַּמַּיִם וְאַתֶּם תִּטָּבְלוּ בְּרוּחַ הַקֹּדֶשׁ׃","17":"וְעַתָּה אַחֲרֵי אֲשֶׁר נָתַן לָהֶם אֱלֹהִים אֶת־הַמַּתָּנָה הַזֹּאת כַּאֲשֶׁר נָתַן גַּם־לָנוּ הַמַּאֲמִינִים בָּאָדוֹן יֵשׁוּעַ הַמָּשִׁיחַ אֲנִי מִי אֲנִי כִּי אָבֹא לִכְלוֹא אֶת־הָאֱלֹהִים׃","18":"וַיְהִי כְּשָׁמְעָם אֶת־הַדְּבָרִים הָאֵלֶּה וַיַּחֲרִישׁוּ וַיִּתְּנוּ כָבוֹד לֵאלֹהִים לֵאמֹר אָכֵן גַּם־לַגּוֹיִם נָתַן אֱלֹהִים לָשׁוּב לְדֶרֶךְ הַחַיִּים׃","19":"וְהַנְּפוֹצִים מִפְּנֵי הַצָּרָה אֲשֶׁר עָבְרָה עֲלֵיהֶם עַל־דִּבְרַת סְטְפָנוֹס הָלְכוּ עַד־פִּינוּקְיָא וְקַפְרוֹס וְאַנְטְיוֹכְיָא וְלֹא הִגִּידוּ דְבַר הַבְּשׂוֹרָה לְאִישׁ זוּלָתִי לַיְּהוּדִים לְבַדָּם׃","20":"וּמֵהֶם הָיוּ אַנְשֵׁי קַפְרוֹס וְקוּרִינִי אֲשֶׁר בָּאוּ אַנְטְיוֹכְיָא וַיְדַבְּרוּ גַּם־אֶל־הַיְּוָנִים וַיְבַשְּׂרוּם אֶת־הָאָדוֹן יֵשׁוּעַ׃","21":"וְיַד יְהוָֹה הָיְתָה עֲלֵיהֶם וְרַבִּים בְּמִסְפָּר הֶאֱמִינוּ וַיָּשׁוּבוּ אֶל־הָאָדוֹן׃","22":"וּשְׁמוּעָתָם בָּאָה אֶל־אָזְנֵי הָעֵדָה אֲשֶׁר בִּירוּשָׁלָיִם וַיִּשְׁלְחוּ אֶת־בַּר־נַבָּא אֶל־אַנְטְיוֹכְיָא׃","23":"וַיָּבֹא וַיַּרְא אֶת־חֶסֶד הָאֱלֹהִים וַיִּשְׂמָח וַיְדַבֵּר עַל־לֵב כֻּלָּם לְדָבְקָה בָאָדוֹן בְּרוּחַ נָכוֹן׃","24":"כִּי אִישׁ טוֹב הָיָה וּמָלֵא רוּחַ הַקֹּדֶשׁ וֶאֱמוּנָה וְעַם־רָב נִסְפְּחוּ עַל־הָאָדוֹן׃","25":"וַיֵּלֶךְ מִשָּׁם אֶל־טַרְסוֹס לְבַקֵּשׁ אֶת־שָׁאוּל׃","26":"וַיִּמְצָאֵהוּ וַיְבִיאֵהוּ אַנְטְיוֹכְיָא וַיֵּשְׁבוּ שָׁם שָׁנָה תְמִימָה בְּקֶרֶב הַקָּהָל וַיְלַמְּדוּ תוֹרָה לָרַבִּים אָז הוּחַל בְּאַנְטְיוֹכְיָא לִקְרֹא לַתַּלְמִידִים מְשִׁיחִיִּים׃","27":"וַיְהִי בַּיָּמִים הָהֵם וַיֵּרְדוּ נְבִיאִים מִירוּשָׁלַיִם אַנְטְיוֹכְיָא׃","28":"וַיָּקָם אֶחָד מֵהֶם וּשְׁמוֹ אֲגָבוֹס וְהָרוּחַ דִּבֶּר בּוֹ כִּי רָעָב גָּדוֹל יִהְיֶה בְּכָל־הָאָרֶץ הוּא הָרָעָב אֲשֶׁר בָּא בִּימֵי קְלוֹדְיוֹס׃","29":"וַיִּתְנַדְּבוּ הַתַּלְמִידִים לִשְׁלֹחַ אִישׁ אִישׁ מֵהֶם כַּאֲשֶׁר תַּשִּׂיג יָדוֹ לַעֲזֹר לָאַחִים הַיֹּשְׁבִים בִּיהוּדָה׃","30":"וַיַעֲשׂוּ כֵן וַיִּשְׁלְחוּ נִדְבַת יָדָם אֶל־הַזְּקֵנִים עַל־יַד בַּר־נַבָּא וְשָׁאוּל׃"}}