לְהַזְכִּירְךָ כִּי־תְעוֹרֵת מַתְּנַת הָאֱלֹהִים הַנְּתוּנָה לְךָ מֵעֵת אֲשֶׁר סָמַכְתִּי יָדַי עָלֶיךָ׃","7":"כִּי לֹא נָתַן לָנוּ אֱלֹהִים רוּחַ פָּחַד כִּי אִם־רוּחַ גְּבוּרָה אַהֲבָה וּמוּסָר׃","8":"וְלָכֵן אַל־תֵּבוֹשׁ מֵעֵדוּת אֲדֹנֵינוּ וְלֹא מִמֶּנִּי אֲסִירוֹ רַק נְשָׂא חֶבְלֵי הַבְּשׁרָה כָּמֹנִי בִּגְבוּרַת אֱלֹהִים׃","9":"אֲשֶׁר הֵבִיא לָנוּ יֶשַׁע וַיִּקְרָא לָנוּ בִּדְבַר קָדְשׁוֹ לֹא כְמַעֲשֵׂינוּ כִּי אִם־כַּעֲצָתוֹ וּבְחַסְדּוֹ אֲשֶׁר חָלַק לָנוּ בְּיֵשׁוּעַ מְשִׁיחֵנוּ לִפְנֵי יְמוֹת עוֹלָם׃","10":"וְזֶה עַתָּה עִגְלָה לָאוֹר כַּאֲשֶׁר נִגְלָה מוֹשִׁיעֵנוּ יֵשׁוּעַ הַמָּשִׁיחַ אֲשֶׁר בִּבְשׁרָתוֹ בִּלַּע אֶת־הַמָּוֶת וַיּוֹצֵא לָאוֹר חַיֵּי־עַד וּנְתִיב אַל־מָוֶת׃","11":"הִיא הַבְּשׁרָה אֲשֶׁר נִקְרֵאתִי לִהְיוֹת־לָהּ לְמַגִּיד וּלְשָׁלִיחַ וּלְמוֹרֶה הַגּוֹיִם׃","12":"וּבַעֲבוּר זֹאת נָשָׂאתִי הַתְּלָאָה הַזֹּאת וְלֹא אֵבוֹשׁ כִּי־יָדַעְתִּי בְּמִי הֶאֱמַנְתִּי וּבוֹ בָטְחָה נַפְשִׁי כִּי־רַב כֹּחַ הוּא לִשְׁמֹר אֵת אֲשֶׁר הִפְקַדְתִּי בְיָדוֹ עַד־הַיּוֹם הַהוּא׃","13":"אֶת־הַדְּבָרִים הַנֶּאֱמָנִים כְּצוּרָתָם וְתָכְנִיתָם תִּצְפֹּן אִתְּךָ כַּאֲשֶׁר שָׁמַעְתָּ מִפִּי בֶאֱמוּנָה וּבְאַהֲבָה אֲשֶׁר בְּיֵשׁוּעַ הַמָּשִׁיחַ׃","14":"וְאֶת־הַפִּקָּדוֹן הַטּוֹב אֲשֶׁר הָפְקַד אִתְּךָ שְׁמָר־לְךָ בְּרוּחַ הַקֹּדֶשׁ הַשֹּׁכֵן בָּנוּ׃","15":"הִנֵּה יָדַעְתָּ כִּי־עֲזָבוּנִי כֻלָּם אֲשֶׁר בְּאַסְיָא וּבְתוֹכָם פּוּגְלוֹס וְהַרְמוֹגְנִיס׃","16":"יִגְמֹל הָאָדוֹן חֶסֶד עִם־בֵּית אֳנִיסִיפוֹרוֹס כִּי־הֵשִׁיב נַפְשִׁי פְּעָמִים רַבּוֹת וְלֹא־בוֹשׁ מִן־הַכֶּבֶל אֲשֶׁר נֶאֱסַרְתִּי בוֹ׃","17":"וּבִהְיוֹתִי בְרוֹמִי שָׁקַד לְבַקְּשֵׁנִי עַד כִּי־מָצָא אֹתִי׃","18":"יִתֶּן־לוֹ הָאָדוֹן לִמְצֹא חֶסֶד מִלִּפְנֵי יְהוָֹה בַּיּוֹם הַהוּא וְכָל־אֲשֶׁר הֵיטִיב עִמָּדִי בְּאֶפְסוֹס נַפְשְׁךָ יֹדַעַת מְאֹד׃"}}