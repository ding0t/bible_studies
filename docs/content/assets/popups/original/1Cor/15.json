ַחִים כְּאֶחָד אֲשֶׁר רֻבָּם עוֹדָם חַיִּים עַד־הַיּוֹם הַזֶּה וּמִקְצָתָם נָמוּ שְׁנָתָם׃","7":"וְאַחֲרֵי־כֵן נִרְאָה אֶל־יַעֲקֹב וְאַחֲרֵי־כֵן אֶל־הַשְּׁלִיחִים כֻּלָּם׃","8":"וְאַחַר נִרְאֶה גַם־אֵלָי אֲשֶׁר־כְּנֵפֶל אָנֹכִי׃","9":"כִּי צָעִיר אֲנִי בֵּין הַשְּׁלִיחִים עַד אֲשֶׁר־קָטֹנְתִּי מֵהִקָּרֵא שָׁלִיחַ כִּי רָדַפְתִּי אֶת־עֲדַת אֱלֹהִים׃","10":"אֲבָל בְּחֶסֶד אֱלֹהִים הִנְנִי כַּאֲשֶׁר אָנִי וְחָסְדּוֹ עָלַי לֹא־הָיָה לָרִיק כִּי־יֹתֵר מִכֻּלָּם עָמַלְתִּי וְלֹא אֲנִי כִּי אִם־חֶסֶד אֱלֹהִים אֲשֶׁר עִמָּדִי׃","11":"וְעַתָּה אִם אֲנִי אוֹ הֵם כָּזֹאת אָנוּ קֹרִאים וְכָזֹאת אַתֶּם הֶאֱמַנְתֶּם׃","12":"וְאַחֲרֵי אֲשֶׁר נִקְרָא כִּי־הַמָּשִׁיחַ קָם מִן־הַמֵּתִים אֵיךְ יֹאמְרוּ אֲנָשִׁים מִכֶּם כִּי־תְקוּמָה לַמֵּתִים אָיִן׃","13":"וְאִם־אֵין תְּקוּמָה לַמֵּתִים גַּם־הַמָּשִׁיחַ לֹא קָם׃","14":"וְאִם לֹא קָם הַמָּשִׁיחַ אָז הֶבֶל קְרִיאָתֵנוּ וְהֶבֶל גַּם־אֱמוּנַתְכֶם׃","15":"וְאַף נִמָּצֵא עֵדֵי שֶׁקֶר לֵאלֹהִים אַחֲרֵי אֲשֶׁר עֵדִים הָיִינוּ לֵאלֹהִים כִּי הֵקִים אֶת־הַמָּשִׁיחַ וְלֹא הֲקִימוֹ אִם־אֱמֶת הַדָּבָר כִּי־הַמֵּתִים לֹא יָקוּמוּ׃","16":"כִּי אִם־לֹא יָקוּמוּ הַמֵּתִים גַּם־הַמָּשִׁיחַ לֹא קָם׃","17":"וְאִם לֹא קָם הַמָּשִׁיחַ אֱמוּנַתְכֶם הֶבֶל וַחֲטָאֵיכֶם עוֹדָם עֲלֵיכֶם׃","18":"וְאַף הַיְשֵׁנִים בַּמָּשִׁיחַ אָבַד נִצְחָם׃","19":"אִם־רַק בַּחַיִּים הָאֵלֶּה שַׂמְנוּ מַחְסֵנוּ בַּמָּשִׁיחַ אָז עֲנִיִּים מְרוּדִים אֲנַחְנוּ מִכָּל־אָדָם׃","20":"וְעַתָּה הַמָּשִׁיחַ הִנּוֹ קָם מִן־הַמֵּתִים רֵאשִׁית הַבִּכּוּרִים מִן־יְשֵׁנֵי הַמָּוֶת׃","21":"כִּי־כַאֲשֶׁר הַמָּוֶת בָּא עַל־יְדֵי אָדָם כֵּן עַל־יְדֵי אָדָם תְּקוּמַת הַמֵּתִים׃","22":"וְכַאֲשֶׁר כֻּלָּם מֵתוּ בָאָדָם כֵּן כֻּלָּם יִחְיוּ בַּמָּשִׁיחַ׃","23":"וְאִישׁ אִישׁ בְּסֵדֶר נָכוֹן־לוֹ הַמָּשִׁיחַ הוּא רֵאשִׁית הַבִּכּוּרִים וְאַחֲרֵי־כֵן הַמַּאֲמִינִים בַּמָּשִׁיחַ יָקוּמוּ לְעֵת בּוֹאוֹ׃","24":"אַחֲרֵי־כֵן הַקֵּץ בַּהֲשִׁיבוֹ אֶת־הַמַּלְכוּת אֶל־הָאֱלֹהִים הָאָב בַּיּוֹם אֲשֶׁר יַכְחִיד כָּל־מִשְׂרָה וְכָל־שִׁלְטוֹן וּגְבוּרָה׃","25":"כִּי־הוּא מָלֹךְ יִמְלֹךְ עַד כִּי־יָשִׁית כָּל־אֹיְבָיו תַּחַת רַגְלָיו׃","26":"וְהָאֹיֵב הָאַחֲרוֹן אֲשֶׁר יִכָּחֵד הוּא הַמָּוֶת׃","27":"כִּי־כֹל שָׁת תַּחַת רַגְלָיו וְכַאֲשֶׁר נֶאֱמַר כֹּל שַׁתָּה תַּחַת רַגְלָיו מוּדַעַת זֹאת כִּי־הַכֹּל הוּשַׁת תַּחְתָּיו מִלְּבַד הַשָּׁת כֹּל׃","28":"וְכַאֲשֶׁר יִכְבּשׁ אֶת־כֹּל אָז גַּם־הַבֵּן יוּשַׁת תַּחַת הַשָּׁת־כֹּל תַּחַת רַגְלָיו לְמַעַן יִהְיֶה הָאֱלֹהִים הַכֹּל בַּכֹּל׃","29":"אִם לֹא־כֵן אִם אֵין תְּקוּמָה לַמֵּתִים מַה־יּוֹעִילוּ הַנִּטְבָּלִים בְּעַד הַמֵּתִים לָמָּה־זֶּה יִטָּבְלוּ בַעֲדָם וְהֵם לֹא יָקוּמוּ לְעוֹלָם׃","30":"וְלָמָּה־זֶּה מַשְׁלִיכִים אֲנַחְנוּ אֶת־נַפְשֵׁנוּ מִנֶּגֶד בְּכָל־רֶגַע וָרָגַע׃","31":"בַּעֲלִיצֻתִי אֲשֶׁר אֶעֶלְצָה בָכֶם אַחַי לִפְנֵי יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ הִנְנִי נִשְׁבַּעְתִּי כִּי־אָנֹכִי הוֹלֵךְ לָמוּת יוֹם יוֹם׃","32":"וְגַם־בְּאֶפְסוֹס הֲכִי כְדַרְכֵי אֱנוֹשׁ נִלְחַמְתִּי עִם־חַיְתוֹ יָעַר מַה־יִּתֵּן וּמַה־יּוֹסִיף לִי זֶה אִם־הַמֵּתִים לֹא יָקוּמוּ נֹאכַל וְנִשְׁתֶּה כִּי־מָחָר נָמוּת׃","33":"אַל־תִּשְׁעוּ בְּדִבְרֵי שָׁקֶר חֶבְרַת אֲנָשִׁים רָעִים תְּסַלֵּף אָרְחוֹת יְשָׁרִים׃","34":"הִתְעוֹרְרוּ בְצֶדֶק וְאַל־תֶּחֱטָאוּ כִּי־יֵשׁ אֲנָשִׁים אֲשֶׁר אֵין־בָּהֶם דַּעַת אֱלֹהִים לְבָשְׁתְּכֶם אֲנִי אֹמֵר כָּזֹאת׃","35":"וְכִי־יֹאמַר אִישׁ אֵיךְ יָקוּמוּ הַמֵּתִים מַה גְּוִיָּתָם בְּבוֹאָם׃","36":"סָכָל הֵן הַזֶּרַע אֲשֶׁר תִּזְרַע לֹא יִחְיֶה בִּלְתִּי אִם־יָמוּת רִאשֹׁנָה׃","37":"וְאֵת אֲשֶׁר תִּזְרַע לֹא תִזְרַע הָעֶצֶם הַהוּא אֲשֶׁר אַחֲרֵי־כֵן יִצְמָח כִּי אִם־גַּרְגַּר עָרֹם חִטָּה אוֹ זֶרַע אַחֵר׃","38":"רַק אֱלֹהִים יִתֶּן־לוֹ גְוִיָּה כְּפִי רְצוֹנוֹ לְכָל־זֶרַע וָזֶרַע גְּוִיָּה לְמִינֵהוּ׃","39":"וְלֹא כָל־בָּשָׂר וּבָשָׂר אֶחָד הוּא כִּי בְשַׂר אָדָם לְמִינוֹ וְכֵן בְּשַׂר בְּהֵמָה בְּשַׂר עוֹף וּבְשַׂר דָּגִים כָּל־אֶחָד לְמִינֵהוּ׃","40":"וְיֵשׁ גְּוִיּוֹת בַּשָּׁמַיִם וְיֵשׁ גְּוִיּוֹת בָּאָרֶץ אַךְ כְּבוֹד הַגְּוִיּוֹת אֲשֶׁר בַּשָּׁמַיִם שֹׁנֶה הוּא מִכְּבוֹד הַגְּוִיּוֹת אֲשֶׁר בַּאָרֶץ׃","41":"יֵשׁ כָּבוֹד אֶחָד לַשֶּׁמֶשׁ וְכָבוֹד אַחֵר לַיָּרֵחַ וְכָבוֹד אַחֵר לַכּוֹכָבִים כִּי־כוֹכָב מִכּוֹכָב שֹׁנֶה בִּכְבוֹדוֹ׃","42":"וּכְמוֹ־כֵן בִּתְקוּמַת הַמֵּתִים נִזְרַע בְּשַׁחַת־בְּלִי וְקָם לְחַיֵּי־עַד׃","43":"נִזְרַע בְּלֹא־כָבוֹד וְקָם בְּכָבוֹד נִזְרַע בְּלֹא־כֹחַ וְקָם בַּכֹּחַ׃","44":"נִזְרַע גֵּו נֶפֶשׁ חַיָּה וְקָם גֵּו אֲשֶׁר רוּחַ הוּא יֶשׁ־גֵּו נֶפֶשׁ חַיָּה וְיֶשׁ־גֵּו אֲשֶׁר רוּחַ הוּא׃","45":"וְכֵן כָּתוּב וַיְהִי הָאָדָם הוּא הָאָדָם הָרִאשׁוֹן לְנֶפֶשׁ חַיָּה וְהָאָדָם הָאַחֲרוֹן לְרוּחַ מְחַיֶּה׃","46":"וְלֹא זֶה הָרִאשׁוֹן אֲשֶׁר רוּחַ הוּא כִּי אִם־זֶה אֲשֶׁר נִשְׁמָתוֹ בְאַפָּיו וְאַחֲרָיו זֶה אֲשֶׁר רוּחַ הוּא׃","47":"הָאָדָם הָרִאשׁוֹן הוּא עָפָר מִן־הָאֲדָמָה וְהָאָדָם הַשֵּׁנִי הוּא הָאָדוֹן מִן־הַשָּׁמָיִם׃","48":"כְּמוֹ הָרִאשׁוֹן עָפָר כֵּן גַּם־בָּנָיו עָפָר הֵם וּכְמוֹ הַשֵּׁנִי מִן־הַשָּׁמַיִם כֵּן גַּם־אֵלֶּה אֲשֶׁר־לוֹ מִן־הַשָּׁמַיִם הֵם׃","49":"וְכַאֲשֶׁר לָבַשְׁנוּ דְמוּת הָאָדָם אֲשֶׁר יְסוֹדוֹ מֵעָפָר כֵּן נִלְבְּשָׁה דְמוּת הָאָדָם אֲשֶׁר מוֹצָאֹתָיו מִשָּׁמָיִם׃","50":"וְכָזֹאת אֲנִי אֹמֵר אַחַי כִּי־אֵין בְּכֹחַ בָּשָׂר וָדָם לָרֶשֶׁת מַלְכוּת הָאֱלֹהִים וּבֶן־כִּלָּיוֹן לֹא יִנְחַל אִי־כִלָּיוֹן׃","51":"רְאוּ הִנְנִי מְגַלֶּה סּוֹד לֹא כֻלָּנוּ נִישַׁן הַמָּוֶת אַךְ עֶצֶם נַפְשׁוֹתֵינוּ יְשֻׁנֶּה לְכֻלָּנוּ׃","52":"בְּרֶגַע כְּשִׁית עַיִן בִּמְשֹׁךְ הַיֹּבֵל תְּרוּעָה אַחֲרֹנָה כִּי יִתָּקַע בַּשּׁוֹפָר וְהַמֵּתִים יָקִיצוּ לְחַיֵּי עוֹלָם וְעֶצֶם נַפְשׁוֹתֵינוּ יְשֻׁנֶּה׃","53":"כִּי בֶן־כִּלָיוֹן זֶה יַעֲטֶה אִי־כִלָּיוֹן וּבֶן־מָוֶת זֶה יִלְבַּשׁ אַל־מָוֶת׃","54":"וְכַאֲשֶׁר בֶּן־כִּלָּיוֹן יַעֲטֶה אִי־כִלָּיוֹן וּבֶן־מָוֶת יִלְבַּשׁ אַל־מָוֶת אָז יָקוּם דְּבַר הַכָּתוּב בֻּלַּע הַמָּוֶת לָנֶצַח׃","55":"אַיֶּה נִצְחֲךָ מָוֶת אַיֵּה שֵׁבֶט אוֹנֵךָ שְׁאוֹל׃","56":"שֵׁבֶט הַמָּוֶת הוּא הַחֵטְא וְכֹחַ הַחֵטְא הִיא הַתּוֹרָה׃","57":"אַךְ בָּרוּךְ הוּא הָאֱלֹהִים אֲשֶׁר נָתַן־לָנוּ תְּשׁוּעָה נִצַּחַת בְּיַד יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","58":"עַל־כֵּן הֱיוּ נְכֹנִים וּמְיֻסָּדִים אַחִים אֲהוּבִים וְלֹא תִתְמוֹטְטוּ וּבַעֲבוֹדַת אֲדֹנֵינוּ הוֹסִיפוּ לַעֲבֹד יוֹם יוֹם אַחֲרֵי אֲשֶׁר יְדַעְתֶּם כִּי־לֹא לָרִיק פְּעֻלַּתְכֶם בַּאֲדֹנֵינוּ׃"},"q":{"32":[["Isa 22:13","22:13","αὐτοὶ δὲ ἐποιήσαντο εὐφροσύνην καὶ ἀγαλλίαμα, σφάζοντες μόσχους, καὶ θύοντες πρόβατα, ὥστε φαγεῖν κρέατα, καὶ πιεῖν οἶνον, λέγονες, φάγωμεν καὶ πίωμεν, αὔριον γὰρ ἀποθνήσκομεν.",[18,19,20,21,22,23]],[null,null,null,[14,15,16,17,18,19]]]}}