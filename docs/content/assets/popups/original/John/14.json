","ton",90,93],["Πατέρα,","G3962","N-ASM","Father","Patera",94,100],["καὶ","G2532","CONJ",0,"kai"],["καθὼς","G2531","ADV","exactly what","kathōs",9,21],["ἐνετείλατο","G1781","V-ADI-3S","has commanded","eneteilato",33,46],["μοι","G1473",0,"Me","moi",47,49],["ὁ","G3588","T-NSM","the","ho",22,25],["Πατὴρ","G3962","N-NSM","Father","Patēr",26,32],["οὕτως","G3779","ADV",0,"houtōs"],["ποιῶ.","G4160","V-PAI-1S","I do","poiō",4,8],["Ἐγείρεσθε,","G1453","V-PEM-2P","Get up","Egeiresthe",102,108],["ἄγωμεν","G71","V-PAS-1P","Let us go on","agōmen",110,122],["ἐντεῦθεν.","G1782","ADV","from here","enteuthen",123,132]]},"s":{"1":"אַל־יֵחַת לִבְּכֶם הַאֲמִינוּ בֵאלֹהִים וּכְמוֹ־כֵן הַאֲמִינוּ בִּי׃","2":"מְעוֹנוֹת רַבּוֹת נִמְצָאוֹת בְּבֵית אָבִי כִּי לוּלֵא כֵן הָיִיתִי מַגִּיד לָכֶם וַאֲנִי הֹלֵךְ לְהָכִין לָכֶם מָקוֹם׃","3":"וְאַחֲרֵי אֲשֶׁר אֵלֵךְ וְאָכִין מָקוֹם לָכֶם שׁוֹב אָשׁוּב וְלָקַחְתִּי אֶתְכֶם אֵלָי לְמַעַן תִּהְיוּ עִמִּי שָׁם בַּאֲשֶׁר אֶהְיֶה׃","4":"וְאַתֶּם יְדַעְתֶּם אָנָא אֲנִי הֹלֵךְ וְגַם אֶת־הַדֶּרֶךְ יְדַעְתֶּם׃","5":"וַיֹּאמֶר אֵלָיו תּוֹמָא אֲדֹנִי לֹא יָדַעְנוּ אָנָה אַתָּה הֹלֵךְ וְאֵיכָה נֵדַע אֶת־הַדָּרֶךְ׃","6":"וַיֹּאמֶר אֵלָיו יֵשׁוּעַ אָנֹכִי הַדֶּרֶךְ וְהָאֱמֶת וְהַחַיִּים וְאִישׁ לֹא־יָבֹא אֶל־הָאָב בִּלְתִּי עַל־יָדִי׃","7":"לוּ אֹתִי יְדַעְתֶּם יְדַעְתֶּם גַּם אֶת־אָבִי וּמֵעַתָּה יְדַעְתֶּם אֹתוֹ וְגַם־רְאִיתֶם אֹתוֹ׃","8":"וַיֹּאמֶר אֵלָיו פִילִפּוֹס אֲדֹנִי הַרְאֵנוּ נָא אֶת־הָאָב וְרַב לָנוּ׃","9":"וַיֹּאמֶר אֵלָיו יֵשׁוּעַ הֲלֹא יָמִים רַבִּים הָיִיתִי עִמָּכֶם הֲטֶרֶם תֵּדַע אֹתִי פִּילִפּוֹס הָרֹאֶה אֹתִי רֹאֶה אֶת־הָאָב וְלָמָּה־זֶּה תֹאמַר הַרְאֵנוּ אֶת־הָאָב׃","10":"הֲכִי לֹא תַאֲמִין כִּי אֲנִי בָאָב וְהָאָב בִּי הַדְּבָרִים אֲשֶׁר אֲנִי דֹבֵר אֲלֵיכֶם לֹא־מִלִּבִּי אֲנִי דֹבֵר כִּי הָאָב הַשֹּׁכֵן בִּי הוּא פֹעֵל בִּי פְּעֻלּוֹתָיו׃","11":"הַאֲמִינוּ לִי כִּי־אֲנִי בָאָב וְהָאָב בִּי וְאִם־לֹא הַאֲמִינוּ לִי בִּגְלַל הַפְּעֻלּוֹת הָאֵלֶּה׃","12":"אָמֵן אָמֵן אֲנִי אֹמֵר לָכֶם הַמַּאֲמִין בִּי אֶת־הַמַּעֲשִׂים אֲשֶׁר אֲנִי עֹשֶׂה יַעֲשֶׂה גַם־הוּא וּגְדֹלוֹת מֵאֵלֶּה יַעֲשֶׂה כִּי אֶל־אָבִי אָנֹכִי הֹלֵךְ׃","13":"וְכָל־אֲשֶׁר תִּשְׁאֲלוּ בִשְׁמִי אֹתוֹ אֶעֱשֶׂה לְבַעֲבוּר יִגְדַּל כְּבוֹד הָאָב בִּבְנוֹ׃","14":"כָּל־דָּבָר אֲשֶׁר תִּשְׁאֲלוּ בִשְׁמִי אֲנִי אֶעֱשֶׂנּוּ׃","15":"אִם־אֲהַבְתֶּם אֹתִי אֶת־מְִֹצתַי תִּשְׁמֹרוּ׃","16":"וַאֲנִי אֲחַלֶּה פְנֵי הָאָב וְיִתֵּן לָכֶם מֵלִיץ אַחֵר אֲשֶׁר־יִשְׁכֹּן אִתְּכֶם עֲדֵי־עַד׃","17":"הֲלֹא הוּא רוּחַ הָאֱמֶת אֲשֶׁר הָעוֹלָם לֹא־יָכֹל לְקַבְּלוֹ בַּאֲשֶׁר לֹא יִרְאֶנּוּ וְלֹא יֵדָעֶנּוּ וְאַתֶּם יְדַעְתֶּם אֹתוֹ כִּי הוּא שֹׁכֵן אִתְּכֶם וְאַף־הָיֹה יִהְיֶה בְּתוֹכְכֶם׃","18":"וַאֲנִי לֹא אֶעֱזָבְכֶם יְתוֹמִים כִּי בֹא אָבֹא אֲלֵיכֶם׃","19":"עוֹד מְעַט מִזְעָר וְהָעוֹלָם לֹא יוֹסִיף לִרְאוֹת אֹתִי וְאַתֶּם תִּרְאֻנִי כִּי־אֲנִי חַי וְכֵן גַּם־אַתֶּם תִּחְיוּן׃","20":"בַּיּוֹם הַהוּא תֵּדְעוּ כִּי־אֲנִי בְאָבִי וְאַתֶּם בִּי וַאֲנִי בָכֶם׃","21":"מִי אֲשֶׁר מִצְוֹתַי אִתּוֹ וְשֹׁמֵר לַעֲשׂוֹתָן זֶה הוּא אֲשֶׁר יֶאֱהָבַנִי וְאֹהֲבִי אָהוּב לְאָבִי וַאֲנִי אֹהֲבֵהוּ וְאֵלָיו אֶתְוַדָּע׃","22":"וַיֹּאמֶר אֵלָיו יְהוּדָה לֹא אִישׁ־קְרִיּוֹת וְאֵיכָה אֲדֹנִי תִּקְרֶינָה כָאֵלֶּה כִּי תָבֹא לְהִתְוַדַּע אֵלֵינוּ וְלֹא לָעוֹלָם׃","23":"וַיַּעַן יֵשׁוּעַ וַיֹּאמֶר אֵלָיו אִישׁ כִּי יֶאֱהָבַנִי יִשְׁמֹר אֶת־דְּבָרַי וְאָבִי יֶאֱהַב אֹתוֹ וְאֵלָיו נָבֹא וְשָׁכַנּוּ אִתּוֹ׃","24":"וְאִישׁ אֲשֶׁר לֹא יֶאֱהָבַנִי הוּא לֹא יִשְׁמֹר אֶת־דְּבָרָי וְהַדְּבָרִים אֲשֶׁר שְׁמַעְתֶּם לֹא מִלִּבִּי יָצָאוּ כִּי אִם־מִפִּי הָאָב אֲשֶׁר שְׁלָחָנִי׃","25":"אֶת־אֵלֶּה דִּבַּרְתִּי אֲלֵיכֶם בְּעוֹד שִׁבְתִּי עִמָּכֶם׃","26":"וְהַמֵּלִיץ הוּא רוּחַ הַקֹּדֶשׁ אֲשֶׁר־יִשְׁלָחֵהוּ הָאָב בִּשְׁמִי יְלַמֶּדְכֶם אֶת־כֹּל וְאָז תִּזְכְּרוּ כֹּל אֲשֶׁר־הִגַּדְתִּי לָכֶם׃","27":"וְעַתָּה שָׁלוֹם אֲנִי מַנִּיחַ לָכֶם אֶת־שְׁלוֹמִי אֲנִי נֹתֵן לָכֶם לֹא כַאַשֶׁר יִתֵּן הָעוֹלָם אֲנִי נֹתֵן לָכֶם אַל־יִרְגַּז לִבְּכֶם וְאַל־יֵחָת׃","28":"הֲלֹא שְׁמַעְתֶּם אֵת אֲשֶׁר־אָמַרְתִּי אֲלֵיכֶם כִּי אֵלֵךְ מִכֶּם וְעוֹד אֲשׁוּב אֲלֵיכֶם לוּ אֲהַבְתֶּם אֹתִי הֱיִיתֶם שְׂמֵחִים בְּאָמְרִי לָכֶם כִּי־הֹלֵךְ אֲנִי אֶל־הָאָב כִּי הָאָב גָּדוֹל מִמֶּנִּי׃","29":"וְעַתָּה הִגַּדְתִּי לָכֶם הַדָּבָר טֶרֶם בֹּאוֹ לְבַעֲבוּר תַּאֲמִינוּ אַחֲרֵי בֹאוֹ׃","30":"וַאֲנִי לֹא־אוּכַל עוֹד לְהַרְבּוֹת אֲמָרִים עִמָּכֶם מִפְּנֵי שַׂר־הָעוֹלָם אֲשֶׁר יָבֹא וְהוּא אֵין־לוֹ חֵלֶק בִּי כָּל־מְאוּמָה׃","31":"רַק לְבַעֲבוּר יֵדַע הָעוֹלָם כִּי אֲנִי אֹהֵב אֶת־הָאָב וְעֹשֶׂה אֲנִי כְּכֹל אֲשֶׁר צִוַּנִי הָאָב לְכוּ וְנֵלְכָה מִזֶּה׃"}}