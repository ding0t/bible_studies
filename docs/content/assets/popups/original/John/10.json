ַזֹּאת וְעָלַי לִנְהַג גַּם־אֹתָן וְהֵנָּה בְּקוֹלִי תִשְׁמַעְנָה וְהָיָה עֵדֶר אֶחָד וְרֹעֶה אֶחָד׃","17":"עַל־כֵּן יֶאֱהָבַנִי הָאָב כִּי אֶת־נַפְשִׁי אֶתֵּן וְאָשִׁיב וְאֶקָּחֶיהָ׃","18":"אִישׁ לֹא יִקַּח נַפְשִׁי מִמֶּנִּי כִי אִם־אֲנִי אֶתְּנֶנָּה יֶשׁ־לְאֵל יָדִי לְתִתָּהּ וְיֶשׁ־לְאֵל לַהֲשִׁיבָהּ אֵלָי זֹאת הַמִּצְוָה צֻוֵּיתִי מֵאֵת אָבִי׃","19":"וַיֵּחָלְקוּ הַיְּהוּדִים עוֹד הַפַּעַם עַל־הַדְּבָרִים הָאֵלֶּה׃","20":"רַבִּים מֵהֶם אָמְרוּ רוּחַ רָע בּוֹ וּמְשֻׁגָּע הוּא לָמָּה־זֶּה תִּשְׁמְעוּ אֵלָיו׃","21":"וַאֲחֵרִים אָמְרוּ אֵין הַדְּבָרִים הָאֵלֶּה דִּבְרֵי בַעַל רוּחַ רָע הֲיֵשׁ עִם־רוּחַ רָע לִפְקֹחַ עֵינֵי עִוְרִים׃","22":"וַיְהִי בִּימֵי הַחֲנֻכָּה בִּימֵי הַחֹרֶף בִּירוּשָׁלָיִם׃","23":"וַיִּתְהַלֵּךְ יֵשׁוּעַ בְּבֵית הַמִּקְדָּשׁ בְּאוּלָם שְׁלֹמֹה׃","24":"וַיָּסֹבּוּ אֹתוֹ הַיְהוּדִים וַיֹּאמְרוּ עַד־אָנָה תִמְשְׁכֵנוּ בְנַפְשֵׁנוּ אִם־אַתָּה הוּא הַמָּשִׁיחַ הַגֶּד־לָנוּ לְעֵין הַשָּׁמֶשׁ׃","25":"וַיַּעַן אֹתָם יֵשׁוּעַ הֵן הִגַּדְתִּי לָכֶם וְלֹא הֶאֱמַנְתֶּם בִּי הַמַּעֲשִׂים אֲשֶׁר־אֲנִי עֹשֶׂה בְּשֵׁם אָבִי הֵם לִי לְעֵדוּת׃","26":"רַק אַתֶּם לֹא תַאֲמִינוּ כִּי לֹא מִצֹּאנִי אַתֶּם כַּאֲשֶׁר אָמַרְתִּי לָכֶם׃","27":"צֹאנִי שֹׁמְעוֹת אֶת־קֹלִי וַאֲנִי יֹדֵעַ אֹתָן וְהֵנָּה הֹלְכוֹת אַחֲרָי׃","28":"וְחַיֵּי עוֹלָם אֶתֵּן לָהֶן לֹא תֹאבַדְנָה לָנֶצַח וְלֹא יַחֲטֹף אֹתָן אִישׁ מִיָּדִי׃","29":"אָבִי אֲשֶׁר נְתָנָן לִי אַדִּיר הוּא מִכֹּל וְאֵין אִישׁ אֲשֶׁר־יוּכַל לַחֲטֹף אֶתְהֶן מִיַּד הָאָב׃","30":"וַאֲנִי וְהָאָב אֶחָד׃","31":"וַיּוֹסִיפוּ הַיְּהוּדִים וַיִּשְׂאוּ אֲבָנִים לְסָקְלוֹ׃","32":"וַיַּעַן אֹתָם יֵשׁוּעַ הֵן מַעֲשִׂים רַבִּים טוֹבִים הֶרְאֵיתִי לָכֶם מֵאֵת הָאָב עַל־אֵי־זֶה מִן־הַמַּעֲשִׂים הָאֵלֶּה תִּסְקְלֻנִי׃","33":"וַיַּעֲנוּ אֹתוֹ הַיְּהוּדִים לֵאמֹר עַל־מַעֲשֶׂה טוֹב לֹא נִסְקְלֶךָ כִּי אִם־עַל־חִלּוּל הַשֵּׁם בַּאֲשֶׁר כִּי אָדָם אַתָּה וְהִנְּךָ אֹמֵר לְנַפְשְׁךָ אֱלֹהִים אָתָּה׃","34":"וַיַּעַן אֹתָם יֵשׁוּעַ הֲלֹא כָתוּב בְּתוֹרַתְכֶם אֲנִי אָמַרְתִּי אֱלֹהִים אַתֶּם׃","35":"וְעַתָּה אִם־אֲנָשִׁים נִקְרְאוּ אֱלֹהִים אֲשֶׁר תּוֹרַת הָאֱלֹהִים אִתָּם וּדְבַר הַכָּתוּב אֵין לְהָשִׁיב׃","36":"אֵיךְ תֹּאמְרוּן עַל־זֶה אֲשֶׁר קִדְּשׁוֹ הָאָב וַיִּשְׁלָחֵהוּ בָאָרֶץ מְגַדֵּף אָתָּה יַעַן אָמַרְתִּי בֶּן־הָאֱלֹהִים אָנִי׃","37":"אִם־לֹא עָשִׂיתִי אֶת־מַעֲשֵׂי אָבִי לֹא תַאֲמִינוּ לִי׃","38":"וְאִם־עֲשִׂיתִים אַף כִּי לֹא־אֲבִיתֶם לְהַאֲמִין בִּי הַאֲמִינוּ בְּמַעֲשֵׂי יָדָי לְמַעַן תֵּדְעוּ וְתַאֲמִינוּ כִּי הָאָב בִּי וַאֲנִי בָּאָב׃","39":"וַיּוֹסִיפוּ וַיְבַקְשׁוּ לְתָפְשׂוֹ אַךְ הוּא נִמְלַט מִיָּדָם׃","40":"וַיֵּצֵא וַיָּשָׁב אֶל־עֵבֶר הַיַּרְדֵּן אֶל־הַמָּקוֹם אֲשֶׁר יוֹחָנָן הָיָה מְטַבֵּל שָׁם בַּתְּחִלָּה וַיֵּשֶׁב שָׁם׃","41":"וַיָּבֹאוּ אֵלָיו רַבִּים וַיֹּאמְרוּ הִנֵּה יוֹחָנָן לֹא־נָתַן מוֹפֵת אֲבָל כָּל־אֲשֶׁר דִּבֶּר עַל־הָאִישׁ הַזֶּה אֱמֶת הוּא׃","42":"וַיַּאֲמִינוּ־בוֹ רַבִּים בַּמָּקוֹם הַהוּא׃"},"q":{"34":[["Ps 82:6","81:6","Ἐγὼ εἶπα, θεοί ἐστε, καὶ υἱοὶ ὑψίστου πάντες.",[0,1,2,3]],[null,null,null,[12,13,14,15]]]}}