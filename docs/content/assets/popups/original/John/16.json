ה הִנְּנִי הֹלֵךְ אֶל־שֹׁלְחִי וְאֵין עוֹד אִישׁ מִכֶּם שֹׁאֵל אֹתִי אָנָה אַתָּה הֹלֵךְ׃","6":"רַק לִבְּכֶם מָלֵא עֶצֶב בְּדַבְּרִי אֲלֵיכֶם הַדְּבָרִים הָאֵלֶּה׃","7":"אוּלָם אֱמֶת אַגִּיד לָכֶם כִּי טוֹב לָכֶם אֲשֶׁר אֵלֵךְ כִּי אִם־לֹא אֵלֵךְ לֹא־יָבֹא הַמֵּלִיץ אֲלֵיכֶם וְכִי־אֵלֵךְ אֶשְׁלָחֶנּוּ אֲלֵיכֶם׃","8":"וְהוּא בְּבֹאוֹ יוֹכַח אֶת־הָעוֹלָם עַל־דְּבַר חֵטְא צְדָקָה וּמִשְׁפָּט׃","9":"עַל־חֵטְא עַל־אֲשֶׁר לֹא הֶאֱמִינוּ בִי׃","10":"עַל־צְדָקָה עַל־כִּי הֹלֵךְ אֲנִי אֶל־אָבִי וְלֹא תִרְאֻנִי עוֹד׃","11":"וְעַל־מִשְׁפָּט עַל־כִּי יַרְשִׁיעַ אֶת־שַׂר הָעוֹלָם הַזֶּה בְּהִשָּׁפְטוֹ׃","12":"וְעוֹד לִי מִלִּין רַבּוֹת לְהוֹדִיעֲכֶם אַךְ לֹא־תוּכְלוּ שְׂאֵת אוֹתָן כַּיּוֹם׃","13":"וְרוּחַ הָאֱמֶת בְּבֹאוֹ יַנְחֶה אֶתְכֶם אֶל־הָאֱמֶת כֻּלָּהּ כִּי לֹא מִלִּבּוֹ יְדַבֵּר כִּי אִם אֶת־אֲשֶׁר יִשְׁמַע יַשְׁמִיעַ וְיַגִּיד אֶת־הָאֹתִיּוֹת לְאָחוֹר׃","14":"הוּא יְגַדֵּל כְּבוֹדִי כִּי יִקַּח מִשֶּׁלִּי וְהִגִּיד לָכֶם׃","15":"כֹּל אֲשֶׁר לְאָבִי לִי הוּא עַל־כֵּן אָמַרְתִּי מִשֶּׁלִּי יִקַּח וְהִגִּיד לָכֶם׃","16":"עוֹד כִּמְעַט רֶגַע וְלֹא תִרְאֻנִי עוֹד וְעוֹד כִּמְעַט רֶגַע וְתִרְאֻנִי כִּי אֲנִי הֹלֵךְ אֶל־אָבִי׃","17":"וְיֵשׁ מִתַּלְמִידָיו אֲשֶׁר נִדְבְּרוּ אָז אִישׁ אֶל־רֵעֵהוּ מַה־זֶּה אֲשֶׁר אָמַר אֵלֵינוּ עוֹד כִּמְעַט רֶגַע וְלֹא תִרְאוּנִי וְעוֹד כִּמְעַט רֶגַע וְתִרְאוּנִי וְכִי אֲנִי הֹלֵךְ אֶל־הָאָב׃","18":"וַיֹּאמְרוּ מַה־זֶּה כִּמְעַט רֶגַע אֲשֶׁר אָמַר וַאֲנַחְנוּ לֹא נֵדַע מָה הוּא מְדַבֵּר׃","19":"וַיַּרְא יֵשׁוּעַ כִּי מְבַקְשִׁים הֵם לִשְׁאֹל אֶת־פִּהוּ וַיֹּאמֶר אֲלֵיהֶם הֲתַחְקְרוּן זֶה אֶת־זֶה עַל כִּי־אָמַרְתִּי עוֹד כִּמְעַט רֶגַע וְלֹא תִרְאֻנִי וְעוֹד כִּמְעַט רֶגַע וְתִרְאֻנִי׃","20":"אָמֵן אָמֵן אֲנִי אֹמֵר לָכֶם כִּי אַתֶּם תִּבְכּוּ וְתֵילִילוּ וּבְנֵי הָעוֹלָם יָגִילוּ אַתֶּם תִּתְאַבְּלוּ אַךְ אֶבְלְכֶם יֵהָפֵךְ לְשָׂשׂוֹן׃","21":"אִשָּׁה תָּחִיל בַּחֲבָלֶיהָ כִּי בָאָה עִתָּהּ וְאַחֲרֵי אֲשֶׁר הִמְלִיטָה אֶת־הַוָּלָד לֹא־תִזְכֹּר עוֹד חֶבְלָהּ מִשִּׂמְחָתָהּ כִּי־אִישׁ נוֹלַד בָּעוֹלָם׃","22":"וְגַם־אַתֶּם מְלֵאִים יָגוֹן כַּיּוֹם אַךְ עוֹד אָשׁוּב אֶרְאֶה אֶתְכֶם וְשָׂשׂ לִבְּכֶם וְשִׂמְחַתְכֶם לֹא־יִקַּח מִכֶּם גָּבֶר׃","23":"וּבַיּוֹם הַהוּא לֹא תִשְׁאֲלוּ לִי כָּל־שְׁאֵלָה אָמֵן אָמֵן אֲנִי אֹמֵר לָכֶם אִם תְּבַקְשׁוּ דָבָר מֵאֵת הָאָב יִתֵּן לָכֶם בִּשְׁמִי׃","24":"עַד־עַתָּה לֹא־בִקַּשְׁתֶּם דָּבָר בִּשְׁמִי בַּקְּשׁוּ וְתִקְחוּ וְנַפְשְׁכֶם תִּמָּלֵא שִׂמְחָה׃","25":"אֶת־אֵלֶּה בִּמְשָׁלִים דִּבַּרְתִּי אֲלֵיכֶם אַךְ הִגִּיעַ הַמּוֹעֵד וְלֹא אֲדַבֵּר אֲלֵיכֶם עוֹד בִּמְשָׁלִים כִּי אִם־בְּמִלִּים בְּרֻרוֹת אַגֵּדְכֶם עַל־דְּבַר הָאָב׃","26":"בַּיּוֹם הַהוּא מִשְׁאֲלוֹתֵיכֶם בִּשְׁמִי תִּשְׁאָלוּ וְאֵינֶנִּי אֹמֵר לָכֶם כִּי אֲנִי אַעְתִּיר בַּעַדְכֶם אֶל־הָאָב׃","27":"כִּי־הָאָב גַּם־הוּא אֹהֵב אֶתְכֶם עֵקֶב אֲשֶׁר אֲהַבְתֶּם אֹתִי וַתַּאֲמִינוּ כִּי־מֵאֵת הָאָב יָצָאתִי׃","28":"יָצָאתִי מֵאֵת הָאָב וּבָאתִי בָעוֹלָם וְעַתָּה אָשׁוּב אֶעֱזֹב אֶת־הָעוֹלָם וְאֵלֶךְ־לִי אֶל־הָאָב׃","29":"וַיֹּאמְרוּ תַלְמִידָיו הִנְּךָ מְדַבֵּר עַתָּה בְּמִלִּים בְּרֻרוֹת וְלֹא תַבִּיע מָשָׁל׃","30":"עַתָּה יָדַעְנוּ כִּי־אַתָּה יֹדֵעַ כֹּל וְאֵין מַחְסֹר לְךָ אֲשֶׁר יִשְׁאָלְךָ אִישׁ בָּזֹאת נַאֲמִין כִּי מֵאֵת אֱלֹהִים יָצָאתָ׃","31":"וַיַּעַן אֹתָם יֵשׁוּעַ הֲכִי תַאֲמִינוּ עָתָּה׃","32":"הִנֵּה הַזְּמָן בָּא וּכְבָר הִגִּיעַ כִּי־תָפוּצוּ אִישׁ אִישׁ לִבֵיתוֹ וְאֹתִי תַעַזְבוּ לְבַדִּי אַךְ אֵינֶנִּי לְבַדִּי כִּי אָבִי עִמָּדִי׃","33":"וַאֲנִי בַּדְּבָרִים הָאֵלֶּה בָּאתִי לְהַגִּיד לָכֶם כִּי בִי שָׁלוֹם יִהְיֶה־לָכֶם בָּעוֹלָם צָרָה תְּבוֹאַתְכֶם אַךְ־הִתְאַזְּרוּ עֹז אֲנִי נִצַּחְתִּי אֶת־הָעוֹלָם׃"}}