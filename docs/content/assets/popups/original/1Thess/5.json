ַי אֵינְכֶם בַּחֹשֶׁךְ אֲשֶׁר יָבוֹא עֲלֵיכֶם הַיּוֹם כְּגַנָּב׃","5":"כִּי כֻלְּכֶם בְּנֵי אוֹר וּבְנֵי יוֹם אַתֶּם לֹא בְנֵי לַיְלָה וְלֹא בְנֵי חשֶׁךְ אֲנָחְנוּ׃","6":"עַל־כֵּן אֵין לָנוּ לִישׁוֹן כִּשְׁאָר הָאֲנָשִׁים כִּי אִם־נִשְׁקֹד וְנִשְׁתַּמֵּר מִשִּׁכָּרוֹן׃","7":"כִּי הַיְשֵׁנִים יִישְׁנוּ בַלָּיְלָה וְהַשִּׁכֹּרִים יִשְׁכְּרוּן בַּלָּיְלָה׃","8":"וַאֲנַחְנוּ בְנֵי יוֹם נִשְׁתַּמֵּר מִשְּׁכָּרוֹן וְנִלְבַּשׁ שִׁרְיוֹן אֱמוּנָה וְאַהֲבָה וּלְכוֹבַע לָנוּ תִּקְוַת הַיְשׁוּעָה׃","9":"כִּי לֹא־יָצַר אֹתָנוּ אֱלֹהִים לְכַלֹּתֵנוּ בְאַפּוֹ כִּי אִם־לְהָבִיא לָנוּ יְשׁוּעָה בְּיַד־יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ׃","10":"הוּא אֲשֶׁר מֵת בַּעֲדֵנוּ וְאִם־נָקִיץ אוֹ־נִישַׁן עִמּוֹ נִחְיֶה יַחְדָּו׃","11":"עַל־כֵּן הַזְהִירוּ אִישׁ אֶת־רֵעֵהוּ וְהָשִׁיבוּ אִישׁ אֶת־נֶפֶשׁ אָחִיו כַּאֲשֶׁר עֲשִׂיתֶם עַד־כֹּה׃","12":"וַאֲנַחְנוּ נִפְצַר בָּכֶם אַחִים לָדַעַת בְּשׂוּם לֵב אֶת־הָעֲמֵלִים בָּכֶם וְאֶת־הַנִּצָּבִים עֲלֵיכֶם בְּשֵׁם הָאָדוֹן וְאֶת־הַמּוֹכִיחִים אֶתְכֶם׃","13":"וּלְהַכִּיר יְקַר עֶרְכָּם הַגָּדוֹל לְאַהֲבָה אֹתָם לְמַעַן פָּעֳלָם וְהַחֲזִיקוּ שָׁלוֹם בֵּינֵיכֶם׃","14":"וְאַתֶּם אַחֵינוּ נַזְהִיר אֶתְכֶם הוֹכִיחוּ אֶת־הַמַּמְרִים אַמְּצוּ אֶת־רַכֵּי הַלֵּבָב סַעֲדוּ אֶת־החֹלִים וְהַאֲרִיכוּ אַף לְכָל־אָדָם׃","15":"הִשָּׁמְרוּ פֶּן־יִגְמֹל אִישׁ לְאִישׁ רָעָה תַּחַת רָעָה כִּי אִם־רִדְפוּ לְהֵיטִיב תָּמִיד לְאִישׁ אִישׁ מִכֶּם וְגַם לְכָל־אָדָם׃","16":"וְאַךְ שְׂמֵחִים תִּהְיוּ כָּל־הַיָּמִים׃","17":"וְלֹא תַחְדְּלוּ מֵהִתְפַּלֵּל תָּמִיד׃","18":"הוֹדוּ עַל־כָּל־דָּבָר כִּי־זֶה לָכֶם חֵפֶץ אֱלֹהִים בְּיֵשׁוּעַ הַמָּשִׁיחַ׃","19":"לֹא תְכַבּוּ אֶת־הָרוּחַ׃","20":"וְאֶת־הַנְּבוּאוֹת לֹא תִפְרָעוּ׃","21":"בַּחֲנוּ כָּל־דָּבָר וְהַחֲזִיקוּ בַּטּוֹב׃","22":"וּמִכָּל־שֶׁמֶץ דָּבָר רָע אַף לְמַרְאֵה עָיִן הַרְחִיקוּ רַגְלֵיכֶם׃","23":"וֵאלֹהֵי הַשָּׁלוֹם הוּא יְקַדֵּשׁ אֶתְכֶם מֵחָחֵל וְעַד־כַּלֵּה וְיִשְׁמָרְכֶם מִכָּל־רָע בְּרוּחַ נֶפֶשׁ וּגְוִיָּה לְמוֹעֵד בּוֹא אֲדֹנֵינוּ יֵשׁוּעַ הַמָּשִׁיחַ׃","24":"נֶאֱמָן הוּא הַקֹּרֵא אֶתְכֶם וְהוּא גַּם־יַעֲשֶׂה׃","25":"אָנָּא אֶחָי הִתְפַּלְּלוּ־נָא בַּעֲדֵנוּ׃","26":"שַׁאֲלוּ לִשְׁלוֹם כָּל־הָאַחִים בִּנְשִׁיקַת הַקֹּדֶשׁ׃","27":"הִנְנִי מַשְׁבִּיעֲכֶם בַּאֲדֹנֵינוּ לָתֵת הָאִגֶּרֶת הַזֹּאת לְהִקָּרֵא בְאָזְנֵי כָל־הָאַחִים הַקְּדוֹשִׁים׃","28":"חֶסֶד יֵשׁוּעַ הַמָּשִׁיחַ אֲדֹנֵינוּ עִמָּכֶם אָמֵן׃"}}