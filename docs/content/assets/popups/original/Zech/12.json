תָן","H5416","HNp","of Nathan","nā·ṯān",113,122],["לְבָד","H905","HR/Ncmsa",0,"lə·ḇāḏ"],["וּנְשֵׁיהֶם","H802","HC/Ncfpc/Sp3mp","and their wives","ū·nə·šê·hem",123,138],["לְבָֽד׃","H905","HR/Ncmsa",0,"lə·ḇāḏ"]],"13":[["מִשְׁפַּחַת","H4940","HNcfsc","the clan","miš·pa·ḥaṯ",0,8],["בֵּית־","H1004","HNcmsc","of the house","bêṯ-",9,21],["לֵוִי","H3878","HNp","of Levi","lê·wî",22,29],["לְבָד","H905","HR/Ncmsa",0,"lə·ḇāḏ"],["וּנְשֵׁיהֶם","H802","HC/Ncfpc/Sp3mp","and their wives","ū·nə·šê·hem",30,45],["לְבָד","H905","HR/Ncmsa",0,"lə·ḇāḏ"],["מִשְׁפַּחַת","H4940","HNcfsc","the clan","miš·pa·ḥaṯ",47,55],["הַשִּׁמְעִי","H8097","HTd/Ngmsa","of Shimei","haš·šim·‘î",56,65],["לְבָד","H905","HR/Ncmsa",0,"lə·ḇāḏ"],["וּנְשֵׁיהֶם","H802","HC/Ncfpc/Sp3mp","and their wives","ū·nə·šê·hem",66,81],["לְבָֽד׃","H905","HR/Ncmsa",0,"lə·ḇāḏ"]],"14":[["כֹּל","H3605","HNcmsc","and all","kōl",0,7],["הַמִּשְׁפָּחוֹת","H4940","HTd/Ncfpa","clans","ham·miš·pā·ḥō·wṯ",22,27],["הַנִּשְׁאָרוֹת","H7604","HTd/VNsfpa","the remaining","han·niš·’ā·rō·wṯ",8,21],["מִשְׁפָּחֹת","H4940","HNcfpa",0,"miš·pā·ḥōṯ"],["מִשְׁפָּחֹת","H4940","HNcfpa",0,"miš·pā·ḥōṯ"],["לְבָד","H905","HR/Ncmsa",0,"lə·ḇāḏ"],["וּנְשֵׁיהֶם","H802","HC/Ncfpc/Sp3mp","and their wives","ū·nə·šê·hem",28,43],["לְבָֽד׃ס","H905","HR/Ncmsa",0,"lə·ḇāḏ"]]},"g":{"1":"Λῆμμα λόγου Κυρίου ἐπὶ τὸν Ἰσραήλ· λέγει Κύριος, ἐκτείνων οὐρανὸν, καὶ θεμελιῶν γῆν, καὶ πλάσσων πνεῦμα ἀνθρώπου ἐν αὐτῷ,","2":"ἰδοὺ ἐγὼ τίθημι τὴν Ἱερουσαλὴμ ὡς πρόθυρα σαλευόμενα πᾶσι τοῖς λαοῖς κύκλῳ, καὶ ἐν τῇ Ἰουδαίᾳ ἔσται περιοχὴ ἐπὶ Ἱερουσαλήμ.","3":"Καὶ ἔσται ἐν τῇ ἡμέρᾳ ἐκείνῃ θήσομαι τὴν Ἱερουσαλὴμ λίθον καταπατούμενον πᾶσι τοῖς ἔθνεσι· πᾶς ὁ καταπατῶν αὐτὴν ἐμπαίζων ἐμπαίξεται, καὶ ἐπισυναχθήσονται ἐπʼ αὐτὴν πάντα τὰ ἔθνη τῆς γῆς.","4":"Ἐν τῇ ἡμέρᾳ ἐκείνῃ, λέγει Κύριος παντοκράτωρ, πατάξω πάντα ἵππον ἐν ἐκστάσει, καὶ τὸν ἀναβάτην αὐτοῦ ἐν παραφρονήσει, ἐπὶ δὲ τὸν οἶκον Ἰούδα διανοίξω τοὺς ὀφθαλμούς μου, καὶ πάντας τοὺς ἵππους τῶν λαῶν πατάξω ἐν ἀποτυφλώσει.","5":"Καὶ ἐροῦσιν οἱ χιλίαρχοι Ἰούδα ἐν ταῖς καρδίαις αὐτῶν, εὑρήσομεν ἑαυτοῖς τοὺς κατοικοῦντας Ἱερουσαλὴμ ἐν Κυρίῳ παντοκράτορι Θεῷ αὐτῶν.","6":"Ἐν τῇ ἡμέρᾳ ἐκείνῃ θήσομαι τοὺς χιλιάρχους Ἰούδα ὡς δαλὸν πυρὸς ἐν ξύλοις, καὶ ὡς λαμπάδα πυρὸς ἐν καλάμῃ, καὶ καταφάγονται ἐκ δεξιῶν, καὶ ἐξ εὐωνύμων πάντας τοὺς λαοὺς κυκλόθεν, καὶ κατοικήσει Ἱερουσαλὴμ ἔτι καθʼ ἑαυτὴν ἐν Ἱερουσαλήμ.","7":"Καὶ σώσει Κύριος τὰ σκηνώματα Ἰούδα, καθὼς ἀπʼ ἀρχῆς, ὅπως μὴ μεγαλύνηται καύχημα οἴκου Δαυὶδ, καὶ ἔπαρσις τῶν κατοικούντων Ἱερουσαλὴμ ἐπὶ τὸν Ἰούδα.","8":"Καὶ ἔσται ἐν τῇ ἡμέρᾳ ἐκείνῃ ὑπερασπιεῖ Κύριος ὑπὲρ τῶν κατοικούντων Ἱερουσαλὴμ, καὶ ἔσται ὁ ἀσθενῶν ἐν αὐτοῖς ἐν ἐκείνῃ τῇ ἡμέρᾳ ὡς Δαυὶδ, ὁ δὲ οἶκος Δαυὶδ ὡς οἶκος Θεοῦ, ὡς ἄγγελος Κυρίου ἐνώπιον αὐτῶν.","9":"Καὶ ἔσται ἐν τῇ ἡμέρᾳ ἐκείνῃ, ζητήσω ἐξᾷραι πάντα τὰ ἔθνη τὰ ἐρχόμενα ἐπὶ Ἱερουσαλήμ.","10":"Καὶ ἐκχεῶ ἐπὶ τὸν οἶκον Δαυὶδ, καὶ ἐπὶ τοὺς κατοικοῦντας Ἱερουσαλὴμ πνεῦμα χάριτος καὶ οἰκτιρμοῦ· καὶ ἐπιβλέψονται πρὸς μὲ, ἀνθʼ ὧν κατωρχήσαντο· καὶ κόψονται ἐπʼ αὐτὸν κοπετὸν, ὡς ἐπʼ ἀγαπητῷ, καὶ ὀδυνηθήσονται ὀδύνην, ὡς ἐπὶ τῷ πρωτοτόκῳ.","11":"Ἐν τῇ ἡμέρᾳ ἐκείνῃ μεγαλυνθήσεται ὁ κοπετὸς ἐν Ἱερουσαλὴμ, ὡς κοπετὸς ῥοῶνος ἐν πεδίῳ ἐκκοπτομένου.","12":"Καὶ κόψεται ἡ γῆ κατὰ φυλὰς φυλάς· φυλὴ οἴκου Δαυὶδ καθʼ ἑαυτὴν, καὶ αἱ γυναῖκες αὐτῶν καθʼ ἑαυτάς· φυλὴ οἴκου Νάθαν καθʼ ἑαυτὴν, καὶ αἱ γυναῖκες αὐτῶν καθʼ ἑαυτάς·","13":"φυλὴ οἴκου Λευὶ καθʼ ἑαυτὴν, καὶ αἱ γυναῖκες αὐτῶν καθʼ ἑαυτάς· φυλὴ τοῦ Συμεὼν καθʼ ἑαυτὴν, καὶ αἱ γυναῖκες αὐτῶν καθʼ ἑαυτάς.","14":"Πᾶσαι αἱ ὑπολελειμμέναι φυλαὶ, φυλὴ καθʼ ἑαυτὴν, καὶ γυναῖκες αὐτῶν καθʼ ἑαυτάς."}}