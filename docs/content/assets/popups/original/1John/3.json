ִקָּרֵא וְנִהְיֶה בְנֵי אֱלֹהִים וּבַעֲבוּר זֹאת לֹא יָדַע אֹתָנוּ הָעוֹלָם כִּי גַם־אֹתוֹ לֹא יָדָע׃","2":"וְעַתָּה יְדִידִים בָּנִים אֲנַחְנוּ לֵאלֹהִים וְעַד־כֹּה לֹא נוֹדַע מַה־נִּהְיֶה בְאַחֲרִיתֵנוּ אַךְ יָדַעְנוּ כִּי נִשְׁוֶה־לּוֹ לְעֵת יִגָּלֶה כִּי נִרְאֵהוּ אָז כַּאֲשֶׁר הוּא׃","3":"וְכָל־הַשָּׂם מִבְטַחוֹ בוֹ יְטַהֵר אֶת־נַפְשׁוֹ כַּאֲשֶׁר גַּם הוּא טָהוֹר׃","4":"כָּל־הַחֹטֵא מַמְרֶה הוּא בַתּוֹרָה כִּי הַחֵטְא מְרִי הוּא בַתּוֹרָה׃","5":"וְאַתֶּם יְדַעְתֶּם כִּי הוּא בָא לָשֵׂאת אֶת־חַטֹּאתֵינוּ וְחֵטְא לֹא הָיָה בוֹ׃","6":"כָּל־הַמִּתְלוֹנֵן בּוֹ לֹא יֶחֱטָא וְכָל־חֹטֵא לֹא רָאָהוּ וְלֹא יְדָעוֹ׃","7":"יְלָדַי אַל־יַתְעֶה אֶתְכֶם אִישׁ מִי הוּא פֹעֵל צֶדֶק צַדִּיק הוּא כַּאֲשֶׁר גַּם־הוּא צַדִּיק׃","8":"וּמִי הוּא פֹעֵל אָוֶן מִן־הַשָּׂטָן הוּא כִּי הַשָּׂטָן פֹּעֵל אָוֶן הוּא מִקֶּדֶם וּבַעֲבוּר זֹאת בָּא בֶן־הָאֱלֹהִים לַהֲרֹס פְּעֻלּוֹת הַשָּׂטָן׃","9":"כָּל־הַנּוֹלָד מֵאֱלֹהִים לֹא יֶחֱטָא כִּי זַרְעוֹ נִשְׁאָר בְּתוֹכוֹ וְלֹא יוּכַל לַחֲטֹא אַחֲרֵי אֲשֶׁר נוֹלַד מֵאֱלֹהִים׃","10":"בָּזֹאת יִוָּדְעוּ בְנֵי הָאֱלֹהִים וּבְנֵי הַשָּׂטָן כָּל־אִישׁ אֲשֶׁר צְדָקוֹת לֹא־יַעֲשֶׂה אֵינֶנּוּ מֵאֱלֹהִים וְכֵן כָּל־אֲשֶׁר לֹא־יֶאֱהַב אֶת־אָחִיו׃","11":"כִּי זֹאת הִיא הַפְּקֻדָּה אֲשֶׁר שְׁמַעְתֶּם מִקֶּדֶם לְאַהֲבָה אִישׁ אֶת־אָחִיו׃","12":"לֹא כְקַיִן הַבָּא מִמְּקוֹר הָרָע וַיַּהֲרֹג אֶת־אָחִיו וּמַדּוּעַ הֲרָגוֹ יַעַן כִּי־מַעֲשָׂיו הָיוּ רָעִים וּמַעֲשֵׂי אָחִיו יְשָׁרִים׃","13":"אַל־תִּתְמְהוּ אֶחָי אִם הָעוֹלָם יִשְׂנָא אֶתְכֶם׃","14":"הֵן יֹדְעִים אֲנַחְנוּ כִּי עָבַרְנוּ מִן־הַמָּוֶת אֶל־הַחַיִּים בַּאֲשֶׁר אָהַבְנוּ אֶת־אַחֵינוּ אִישׁ אֲשֶׁר לֹא יֶאֱהַב אֶת־אָחִיו שֹׁכֵן מָוֶת הוּא׃","15":"כָּל־הַשּׂנֵא אֶת־אָחִיו רֹצֵחַ הוּא וִידַעְתֶּם כִּי כָל־רֹצֵחַ אֵין לוֹ חֵלֶק בְּחַיֵּי עוֹלָם׃","16":"בָּזֹאת נַשְׂכִּיל מָה הִיא אַהֲבָה כִּי הוּא נָתַן נַפְשׁוֹ תַּחַת נַפְשֵׁנוּ כֵּן גַּם־עָלֵינוּ לָתֵת נֶפֶשׁ תַּחַת נֶפֶשׁ אַחֵינוּ׃","17":"מִי הוּא אֲשֶׁר־לוֹ הוֹן בָּאָרֶץ וְרָאָה אֶת־אָחִיו בְּחֹסֶר כֹּל וְקָפַץ רַחֲמָיו מֵאִתּוֹ אֵיךְ תָּלֶן־בּוֹ אַהֲבַת אֱלֹהִים׃","18":"יְלָדַי אַל־נֶאֱהַב בְּנִיב שְׂפָתַיִם וּבְמַעֲנֵה לָשׁוֹן כִּי אִם־בְּמַעֲשֶׂה יָד וּבְדֶרֶךְ אֱמֶת׃","19":"וּבָזֹאת אֲנַחְנוּ מַכִּירִים כִּי מִמְּקוֹר אֱמֶת אֲנָחְנוּ וְלִקְרַאת פָּנָיו סָמוּךְ יִהְיֶה לִבֵּנוּ׃","20":"אִם־לִבֵּנוּ יַרְשִׁיעַ אֹתָנוּ אֱלֹהִים גָּדוֹל מִלִּבֵּנוּ וּמֵבִין־כֹּל הוּא׃","21":"אִם־לִבֵּנוּ יְדִידִים לֹא־יַרְשִׁיעַ אֹתָנוּ נָכוֹן לִבֵּנוּ לִפְנֵי אֱלֹהִים׃","22":"וְכָל־אֲשֶׁר נִשְׁאַל נִקַּח מִיָּדוֹ כִּי־נִשְׁמֹר אֶת־מִצְוֹתָיו וְאֶת־הַטּוֹב בְּעֵינָיו נַעֲשֶׂה׃","23":"וְזֹאת הִיא מִצְוָתוֹ לְהַאֲמִין בְּשֵׁם יֵשׁוּעַ הַמָּשִׁיחַ בְּנוֹ וּלְאַהֲבָה אִישׁ אֶת־רֵעֵהוּ כַּאֲשֶׁר צִוָּנוּ׃","24":"וְהַשֹּׁמֵר אֶת־מִצְוֹתָיו בּוֹ יִתְלוֹנָן וְהוּא גַם־כֵּן יִשְׁכָּן־בּוֹ וּבָזֹאת נַכִּיר כִּי־הוּא שֹׁכֵן בָּנוּ וּבָרוּחַ אֲשֶׁר־נָתַן לָנוּ׃"}}