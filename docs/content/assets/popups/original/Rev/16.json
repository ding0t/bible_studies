εγάλη","G3173","A-NSF","so horrendous","megalē",149,162],["ἐστὶν","G1510",0,"was","estin",145,148],["ἡ","G3588","T-NSF",0,"hē"],["πληγὴ","G4127","N-NSF","[it]","plēgē",142,144],["αὐτῆς","G846","P-GSF",0,"autēs"],["σφόδρα.","G4970","ADV",0,"sphodra"]]},"s":{"1":"וָאֶשְׁמַע קוֹל גָּדוֹל מִן־הַהֵיכָל קֹרֵא אֶל־שִׁבְעַת הַמַּלְאָכִים לֵאמֹר לְכוּ וְהָרִיקוּ אֶת־שִׁבְעָה הַמִּזְרָקִים הַמְּכִילִים חֲמַת הָאֱלֹהִים עַל־הָאָרֶץ׃","2":"וַיֵּלֶךְ הָרִאשׁוֹן וַיָּרֶק אֶת־מִזְרָקוֹ עַל־הָאָרֶץ וַיְהִי לִשְׁחִין רָע פֹּרֵחַ בָּאֲנָשִׁים אֲשֶׁר תָּו הַחַיָּה בָּהֶם וְהַמִּשְׁתַּחֲוִים אֶל־צַלְמָהּ׃","3":"וַיָּרֶק הַשֵּׁנִי אֶת־מִזְרָקוֹ אֶל־תּוֹךְ הַיָּם וַיְהִי לְדָם כַּדָּם אֲשֶׁר יָזוּבוּ פְגָרִים מֵתִים וַתָּמָת כָּל־נֶפֶשׁ חַיָּה אֲשֶׁר בַּיָּם׃","4":"וַיָּרֶק הַשְּׁלִישִׁי אֶת־מִזְרָקוֹ עַל־הַנְּהָרוֹת וְעַל־מַעְיְנֵי מָיִם וַיֵּהָפְכוּ לְדָם׃","5":"וָאֶשְׁמַע אֶת־מַלְאַךְ הַמַּיִם אֹמֵר צַדִּיק אַתָּה יְהוָֹה הַהוֶֹה וְהָיָה וְיִהְיֶה כִּי־כֵן חָרָצְתָּ׃","6":"הֵם שָׁפְכוּ דַם קְדשִׁים וּנְבִיאִים וְאַתָּה הִשְׁקִיתָם דָּם כִּי־כֵן יָאֲתָה לָהֶם׃","7":"וָאֶשְׁמַע קוֹל מִן־הַמִּזְבֵּחַ אֹמֵר אָמֵן מִשְׁפָּטְךָ יְהוָֹה אֱלֹהִים אֵל שַׁדַּי אֱמֶת וָצֶדֶק׃","8":"וְהָרְבִיעִי הֵרִיק אֶת־מִזְרָקוֹ עַל־פְּנֵי הַשָּׁמֶשׁ וַיִנָּתֶן־לוֹ לְלַהֵט אֶת־הָאֲנָשִׁים בָּאֵשׁ׃","9":"וַיִּצָּרְבוּ הָאֲנָשִׁים בְּלַהַט נוֹרָא מְאֹד וַיְגַדְּפוּ אֶת־שֵׁם אֱלֹהִים הַשַּׁלִּיט עַל־הַמַּגֵּפוֹת הָאֵלֶּה וְלֹא שָׁבוּ לָתֶת־לוֹ כָּבוֹד׃","10":"וַיָּרֶק הַחֲמִישִׁי אֶת־מִזְרָקוֹ עַל־כִּסֵּא הַחַיָּה וַתֶּחְשַׁךְ מַלְכוּתָהּ וַיְנַשְּׁכוּ אֶת־לְשׁוֹנָם מֵרֹב כְּאֵבָם׃","11":"וַיְגַדְּפוּ אֶת־אֱלֹהֵי הַשָּׁמַיִם מִפְּנֵי הַמַּכְאוֹב וְהַשְּׁחִין וְלֹא שָׁבוּ מִמַּעֲשֵׂיהֶם׃","12":"וַיָּרֶק הַשִּׁשִּׁי אֶת־מִזְרָקוֹ אֶל־תּוֹךְ הַנָּהָר הַגָּדוֹל נְהַר־פְּרָת וַיֶּחֶרְבוּ מֵימָיו לְפַנּוֹת דֶּרֶךְ לִפְנֵי הַמְּלָכִים הַבָּאִים מִמִּזְרַח־שָׁמֶשׁ׃","13":"וָאֵרֶא שְׁלשָׁה רוּחוֹת טְמֵאִים כְּתַבְנִית צְפַרְדְּעִים יֹצְאִים מִפִּי הַתַּנִּין וּמִפִּי הַחַיָּה וּמִפִּי נְבִיא הַשָּׁקֶר׃","14":"כִּי הֵם רוּחוֹת הַשֵּׁדִים הָעֹשִׂים מוֹפְתִים וּבָאִים אֶל־מַלְכֵי אֶרֶץ וְתֵבֵל כֻּלָּה לֶאֱסֹף אֹתָם לְמִלְחָמָה לַיּוֹם הַגָּדוֹל הוּא יוֹם אֱלֹהֵי צְבָאוֹת׃","15":"הִנְנִי בָא כְּגַנָּב אַשְׁרֵי הָאִישׁ הַנֵּעוֹר וְאֶת־בְּגָדָיו הוּא נֹצֵר לְבִלְתִּי יֵלֵךְ עָרֹם וְרָאוּ אֶת־עֶרְוָתוֹ׃","16":"וְהֵם הִקְהִילוּ אֹתָם אֶל־הַמָּקוֹם אֲשֶׁר הָעִבְרִים יִקְרְאוּ לוֹ הַר מְגִדּוֹ׃","17":"וְהַשְּׁבִיעִי הֵרִיק אֶת־מִזְרָקוֹ עַל־פְּנֵי רְקִיעַ הַשָּׁמָיִם וַיֵּצֵא קוֹל גָּדוֹל מִן־הַהֵיכָל הָעֶלְיוֹן מִן־הַכִּסֵּא לֵאמֹר נֶעֱשָׂתָה׃","18":"וְהִנֵּה נִשְׁמְעוּ קֹלוֹת וּבְרָקִים וּרְעָמִים וַיְהִי רַעַשׁ גָּדוֹל אֲשֶׁר לֹא־הָיָה כָמֹהוּ לְמִן־הֱיוֹת אָדָם עַל־הָאָרֶץ כִּי גָדֹל הָרַעַשׁ עַד־מְאֹד׃","19":"וַתֵּחָלֵק הָעִיר הַגְּדוֹלָה לִשְׁלשָׁה חֲלָקִים עָרֵי הַגּוֹיִם נָפָלוּ וּבָבֶל הַגְּדוֹלָה נִפְקְדָה לִפְנֵי הָאֱלֹהִים לְהַשְׁקוֹתָהּ כּוֹס יֵין חֲמַת אַפּוֹ׃","20":"נָדְדוּ אִיֵּי הַיָּם וְהֶהָרִים נֶעְתְּקוּ מִמְּקוֹמָם וְאֵינָם׃","21":"וּמִן־הַשָּׁמַיִם הִמְטִירוּ בָרָד כָּבֵד כְּכִכָּר עַל־רָאשֵׁי הָאֲנָשִׁים וַיְגַדְּפוּ הָאֲנָשִׁים אֶת־הָאֱלֹהִים עַל־דְּבַר מַגֵּפַת הַבָּרָד כִּי־כָבְדָה מַכָּתוֹ עַד־מְאֹד׃"}}