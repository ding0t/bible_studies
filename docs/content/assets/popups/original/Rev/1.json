ָאֱלֹהִים לְהַרְאוֹת אֶת־עֲבָדָיו אֵת אֲשֶׁר־תִּקְרֶינָה אֶל־נָכוֹן בְּקֶרֶב הַיָּמִים וַיִּשְׁלַח בְּיַד־מַלְאָכוֹ וַיּוֹרֶה לְעַבְדּוֹ לְיוֹחָנָן׃","2":"הוּא אֲשֶׁר הִגִּיד אֶת־דְּבַר הָאֱלֹהִים וְאֶת־עֵדוּת יֵשׁוּעַ הַמָּשִׁיחַ כְּכֹל אֲשֶׁר רָאָה׃","3":"אַשְׁרֵי הַקֹּרֵא אֶת־דִּבְרֵי הַנְּבוּאָה הַזֹּאת וְאַשְׁרֵי שֹׁמְעֶיהָ הַשֹּׁמְרִים כְּכָל־הַכָּתוּב פֹּה כִּי קָרוֹב הַיּוֹם׃","4":"יוֹחָנָן אֶל־שֶׁבַע הַקְּהִילּוֹת אֲשֶׁר בְּאַסְיָא חֶסֶד לָכֶם וְשָׁלוֹם מֵאִתּוֹ אֲשֶׁר הוּא הוֶֹה הָיָה וָבָא וּמֵאֵת שִׁבְעַת הָרוּחוֹת הָעֹמְדִים לִפְנֵי כִסְאוֹ׃","5":"וּמֵאֵת יֵשׁוּעַ הַמָּשִׁיחַ הָעֵד הַנֶּאֱמָן הַבְּכוֹר הַקָּם מִן־הַמֵּתִים וְעֶלְיוֹן לְמַלְכֵי־אָרֶץ אֲשֶׁר אָהַב אֹתָנוּ וּבְדָמוֹ רְחָצָנוּ מֵחַטֹּאתֵינוּ׃","6":"וַיַעַשׂ אֹתָנוּ לְמַמְלֶכֶת כֹּהֲנִים לֵאלֹהִים אָבִיו אֲשֶׁר לוֹ הַתִּפְאֶרֶת וְהַנֶּצָח עַד־עוֹלְמֵי עוֹלָמִים אָמֵן׃","7":"הִנֵּה בָא עִם־עֲנָנִים וְרָאֲתָה אֹתוֹ כָּל־עַיִן וְעֵינֵי אֲשֶׁר דָּקְרוּ אֹתוֹ וְסָפְדוּ עָלָיו כָּל־מִשְׁפְּחוֹת הָאֲדָמָה אָמֵן אָמֵן׃","8":"אָנֹכִי אָלֶף וְתָו רֹאשׁ וָסוֹף נְאֻם־יְהוָֹה אֱלֹהִים אֲשֶׁר הוּא הוֶֹה הָיָה וָבָא אֱלֹהֵי צְבָאוֹת׃","9":"אֲנִי יוֹחָנָן אֲחִיכֶם הַלֹּקֵחַ חֵלֶק בְּחֶבְלֵי יֵשׁוּעַ הַמָּשִׁיחַ בְּמַלְכוּתוֹ וּבְתוֹחַלְתּוֹ הָיִיתִי בָּאִי הַנִּקְרָא פַּטְמוֹס עַל־דְּבַר הָאֱלֹהים וְעַל־עֵדוּת יֵשׁוּעַ הַמָּשִׁיחַ׃","10":"וַתָּנַח עָלַי הָרוּחַ בְּיוֹם הָאָדוֹן וָאֶשְׁמַע אַחֲרַי קוֹל גָּדוֹל כְּקוֹל שׁוֹפָר לֵאמֹר׃","11":"אֲנִי הָאָלֶף וְהַתָּו הָרִאשׁוֹן וְהָאַחֲרוֹן וְאֵת אֲשֶׁר אַתָּה רֹאֶה כְּתֹב בַּסֵּפֶר וּשְׁלַח אֶל־שֶׁבַע הַקְּהִלּוֹת אֲשֶׁר בְּאַסְיָא אֶל־אֶפְסוֹס שְׂמִירְנָא פַּרְגְּמוֹס תִּיאֲטִירָא סַרְדִּיס פִּילָדֶלְפִיָּא וְאֶל־לוּדְקְיָא׃","12":"וָאֵפֶן לִרְאוֹת אֶת־הַקּוֹל הַמְדַבֵּר אֵלָי וַיְהִי בְהַפְנֹתִי שִׁכְמִי וָאֵרֶא שֶׁבַע מְנֹרוֹת זָהָב׃","13":"וּבְתוֹךְ הַמְּנֹרוֹת כְּמַרְאֵה בֶן־אָדָם עֹטֶה מְעִיל מַגִּיע עַד־מַרְגְּלֹתָיו וְאֵזוֹר זָהָב אָזוּר בְּמָתְנָיו׃","14":"וּשְׂעַר רֹאשׁוֹ כְּצֶמֶר נָקִי לָבָן כַּשָּׁלֶג וְעֵינָיו כְּלַבּוֹת אֵשׁ׃","15":"וְרַגְלָיו כְּעֵין נְחשֶׁת קָלָל צָרוּף בְּתוֹךְ הַכִּבְשָׁן וְקוֹלוֹ כְּקוֹל מַיִם רַבִּים׃","16":"וְלוֹ שִׁבְעָה כוֹכָבִים עַל־יַד יְמִינוֹ מִפִּיו יֹצֵאת חֶרֶב פִּיפִיּוֹת חָדָּה וּפָנָיו כִּבְרַק הַשֶּׁמֶשׁ בִּגְבֻרַתוֹ׃","17":"וַיְהִי בִּרְאֹתִי אֹתוֹ וָאֶפֹּל לְרַגְלָיו כַּמֵּת וַיָּשֶׁת אֶת־יַד יְמִינוֹ עָלַי וַיֹּאמַר אֵלַי אַל־תִּירָא אֲנִי רִאשׁוֹן וַאֲנִי אַחֲרוֹן׃","18":"וַאֲנִי הוּא הַחַי אֲשֶׁר הָיִיתִי מֵת וְהִנֵּה אֲנִי חַי לְעוֹלָם וָעֶד וּמַפְתְּחוֹת הַמָּוֶת וְהַשְּׁאוֹל בְּיָדִי הֵמָּה׃","19":"וְאַתָּה כְּתֹב אֵת אֲשֶׁר רָאִיתָ אֶת־הַדְּבָרִים אֲשֶׁר לְפָנֶיךָ וְאֶת־הָאֹתִיּוֹת לְאָחוֹר׃","20":"אֶת־סוֹד שִׁבְעַת הַכּוֹכָבִים אֲשֶׁר רָאִיתָ עַל־יְמִינִי וְאֶת־שֶׁבַע מְנֹרוֹת הַזָּהָב שִׁבְעַת הַכּוֹכָבִים מַלְאֲכֵי שֶׁבַע קְהִלּוֹת הֵמָּה וְשֶׁבַע הַמְּנֹרוֹת אֲשֶׁר רָאִיתָ שֶׁבַע קְהִלּוֹת הֵנָּה׃"}}